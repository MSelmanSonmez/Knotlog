#!/bin/sh
# quipu — vault CLI for tool-use memory: capture, index, search, doctor.
# Single-file POSIX sh (PLAN FAZ 1). No bashisms: no [[ ]], no local,
# no ${var,,}; helpers are _q_-prefixed globals.
#
# Backslash policy (PLAN 4.11): literal backslashes appear only as DATA in
# single-quoted printf formats / expected values, never as logic escapes.
# Control bytes are produced from code points (awk sprintf("%c",N)).

set -eu

# Name of the vault-local state directory: .knotlog, or .quipu in a vault
# made before the rename. Resolved per vault by _q_sd_of (dispatch, init,
# install); a process works on one vault, so one global is enough.
_q_SD=.knotlog

# Public settings are KNOTLOG_*; the pre-rename QUIPU_* names still work.
# The script reads QUIPU_* throughout, so a set KNOTLOG_* name is copied
# over its QUIPU_* twin here, once, and wins when both are set.
[ -z "${KNOTLOG_VAULT+x}" ] || QUIPU_VAULT=$KNOTLOG_VAULT
[ -z "${KNOTLOG_LANG+x}" ] || QUIPU_LANG=$KNOTLOG_LANG
[ -z "${KNOTLOG_HOME+x}" ] || QUIPU_HOME=$KNOTLOG_HOME
[ -z "${KNOTLOG_HOOK+x}" ] || QUIPU_HOOK=$KNOTLOG_HOOK
[ -z "${KNOTLOG_CTX_MAX+x}" ] || QUIPU_CTX_MAX=$KNOTLOG_CTX_MAX
[ -z "${KNOTLOG_NUDGE_AFTER+x}" ] || QUIPU_NUDGE_AFTER=$KNOTLOG_NUDGE_AFTER
[ -z "${KNOTLOG_CHECKPOINT_AFTER+x}" ] || QUIPU_CHECKPOINT_AFTER=$KNOTLOG_CHECKPOINT_AFTER
[ -z "${KNOTLOG_LOG_MAX+x}" ] || QUIPU_LOG_MAX=$KNOTLOG_LOG_MAX

# ---- helpers ----------------------------------------------------------------

_q_home() {
  # Install directory of the quipu script (or QUIPU_HOME override).
  # $0 may be a symlink (README's Install step suggests exactly that), so
  # walk the link chain before taking dirname — otherwise $_q_HOME resolves
  # to the symlink's directory and every i18n/layout/lib/fold lookup below
  # it misses.
  if [ -n "${QUIPU_HOME:-}" ]; then
    printf '%s\n' "$QUIPU_HOME"
    return 0
  fi
  _q_src=$0
  while [ -L "$_q_src" ]; do
    _q_dir=$(CDPATH='' cd -- "$(dirname -- "$_q_src")" && pwd)
    # shellcheck disable=SC2012 # no readlink on POSIX/BSD; parse ls -ld instead
    _q_src=$(ls -ld -- "$_q_src" | sed 's/.*-> //')
    case "$_q_src" in
      /*) : ;;
      *) _q_src="$_q_dir/$_q_src" ;;
    esac
  done
  CDPATH='' cd -- "$(dirname -- "$_q_src")" && pwd
}

_q_resolve_path() {
  # Resolve a symlink chain without relying on readlink (not POSIX/BSD
  # portable), then print a physical absolute path for comparison.
  _q_rp_src=$1
  while [ -L "$_q_rp_src" ]; do
    _q_rp_dir=$(CDPATH='' cd -- "$(dirname -- "$_q_rp_src")" && pwd -P)
    # shellcheck disable=SC2012 # same portable link parsing as _q_home()
    _q_rp_src=$(ls -ld -- "$_q_rp_src" | sed 's/.*-> //')
    case "$_q_rp_src" in
      /*) : ;;
      *) _q_rp_src="$_q_rp_dir/$_q_rp_src" ;;
    esac
  done
  _q_rp_dir=$(CDPATH='' cd -- "$(dirname -- "$_q_rp_src")" && pwd -P) || return 1
  printf '%s/%s\n' "$_q_rp_dir" "$(basename -- "$_q_rp_src")"
}

_q_vault() {
  # Vault root: nearest ancestor of $PWD holding .knotlog/config or a
  # pre-rename .quipu/config (git-style walk-up), or the QUIPU_VAULT
  # override. Empty when none found.
  if [ -n "${QUIPU_VAULT:-}" ]; then
    printf '%s\n' "$QUIPU_VAULT"
    return 0
  fi
  _q_dir=$PWD
  while :; do
    if [ -f "$_q_dir/.knotlog/config" ] || [ -f "$_q_dir/.quipu/config" ]; then
      printf '%s\n' "$_q_dir"
      return 0
    fi
    # Parent by parameter expansion, not dirname: dispatch now walks up on
    # every run, and a run with QUIPU_HOME set must start without any
    # external command (install's no-writable-PATH preflight relies on it).
    case $_q_dir in
      */*) _q_parent=${_q_dir%/*}; [ -n "$_q_parent" ] || _q_parent=/ ;;
      *) _q_parent=$_q_dir ;;
    esac
    if [ "$_q_parent" = "$_q_dir" ]; then
      break
    fi
    _q_dir=$_q_parent
  done
  return 0
}

_q_sd_of() {
  # State directory of the vault at $1: .knotlog, or .quipu when only the
  # pre-rename one exists. A directory with neither gets the new name.
  if [ -d "$1/.knotlog" ]; then
    printf '.knotlog\n'
  elif [ -d "$1/.quipu" ]; then
    printf '.quipu\n'
  else
    printf '.knotlog\n'
  fi
}

_q_lang() {
  # Language chain: QUIPU_LANG -> vault .quipu/config lang= ->
  # LC_ALL/LANG prefix (before first dot/underscore) -> en.
  #
  # Scratch names are function-prefixed on purpose. POSIX sh has no locals, so
  # a helper that scribbles on a short shared name silently corrupts whatever
  # its caller was holding. This function and _q_msg both used to write plain
  # `_q_v` -- the vault path variable used by nearly every command -- which
  # meant any message call could rewrite the caller's vault path. It did:
  # init's baseline commit tried to `cd` into a translated sentence.
  _q_lang_l=${QUIPU_LANG:-}
  if [ -z "$_q_lang_l" ]; then
    _q_lang_v=$(_q_vault)
    if [ -n "$_q_lang_v" ] && [ -f "$_q_lang_v/$_q_SD/config" ]; then
      _q_lang_l=$(awk -F= -v k=lang '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_lang_v/$_q_SD/config" 2>/dev/null || true)
    fi
  fi
  if [ -z "$_q_lang_l" ]; then
    _q_lang_l=${LC_ALL:-${LANG:-}}
    _q_lang_l=${_q_lang_l%%.*}
  fi
  if [ -z "$_q_lang_l" ]; then
    _q_lang_l=en
  fi
  # Codes are lowercase file names (pt-br, zh-cn): fold case and the locale
  # underscore (pt_BR), then let a region without a file of its own (en-us,
  # tr_TR) fall back to its language. An unsupported code stays as it is.
  # [[:upper:]], not [A-Z]: bash 3.2 (macOS /bin/sh) in a UTF-8 locale lets [A-Z]
  # match lowercase too, so "en" ran tr -- missing from a minimal PATH (CI, 2026-10-25).
  case "$_q_lang_l" in
    *[[:upper:]_]*) _q_lang_l=$(printf '%s' "$_q_lang_l" | tr 'A-Z_' 'a-z-') ;;
  esac
  [ -f "$_q_HOME/i18n/$_q_lang_l.txt" ] || _q_lang_l=${_q_lang_l%%-*}
  printf '%s\n' "$_q_lang_l"
}

_q_langs() {
  # THE list of supported languages: one code per i18n/<code>.txt file, en
  # first (menu default), the rest in glob order. Nothing else names a language.
  printf 'en\n'
  for _q_ls_f in "$_q_HOME"/i18n/*.txt; do
    [ -f "$_q_ls_f" ] || continue
    _q_ls_c=${_q_ls_f##*/}
    _q_ls_c=${_q_ls_c%.txt}
    [ "$_q_ls_c" = en ] || printf '%s\n' "$_q_ls_c"
  done
}

_q_lang_has() {
  # Is $1 a supported language code?
  case "$1" in '' | */* | .*) return 1 ;; esac
  [ -f "$_q_HOME/i18n/$1.txt" ]
}

_q_lang_eff() {
  # The active language when it is supported, else en (unsupported codes act
  # as English, as they always did).
  _q_le=$(_q_lang)
  _q_lang_has "$_q_le" || _q_le=en
  printf '%s\n' "$_q_le"
}

_q_lang_alt() {
  # The "other" language whose spellings stay accepted as legacy file names:
  # tr for an English vault, en for everything else.
  if [ "$(_q_lang_eff)" = en ]; then
    printf 'tr\n'
  else
    printf 'en\n'
  fi
}

_q_lang_pick() {
  # Language to read a per-language asset from: the active one when
  # $_q_HOME/$1<lang>$2 exists, else en (templates, tone, persona fall back
  # to English). $1 prefix, $2 suffix.
  _q_lp=$(_q_lang)
  [ -e "$_q_HOME/$1$_q_lp$2" ] || _q_lp=en
  printf '%s\n' "$_q_lp"
}

_q_layout_ok() {
  # Is $1 a shipped layout (layout/<name>.txt with folder names)?
  case "$1" in '' | */* | .* | status | scope-*) return 1 ;; esac
  [ -f "$_q_HOME/layout/$1.txt" ]
}

_q_fold_for_lang() {
  # THE language -> fold profile mapping: tr has its own, Latin-script
  # languages with accents use latin, everything else default.
  case "$(_q_lang)" in
    tr) printf 'tr\n' ;;
    es | pt-br) printf 'latin\n' ;;
    *) printf 'default\n' ;;
  esac
}

_q_fold_prof() {
  # V1-DUZELTME R-4: SINGLE source of the fold profile. Chain:
  # vault config fold= -> language tr -> tr -> default. `index` and `search`
  # both call this; leaving the chain duplicated in two commands was the
  # cause of the mixed-index corruption (P-2/P-3).
  _q_fp_v=$1
  _q_fp=
  if [ -n "$_q_fp_v" ] && [ -f "$_q_fp_v/$_q_SD/config" ]; then
    _q_fp=$(awk -F= -v k=fold '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_fp_v/$_q_SD/config" 2>/dev/null || true)
  fi
  if [ -z "$_q_fp" ]; then
    _q_fp=$(_q_fold_for_lang)
  fi
  printf '%s\n' "$_q_fp"
}

_q_profile() {
  # Global setter: $_q_prof = normal|economical|manual (anything else, or no
  # profile= key, is normal); $_q_prof_raw = the raw config value (doctor).
  # $1 = vault path.
  _q_prof_raw=
  if [ -n "$1" ] && [ -f "$1/$_q_SD/config" ]; then
    _q_prof_raw=$(awk -F= -v k=profile '$1==k{sub(/^[^=]*=/,"");print;exit}' "$1/$_q_SD/config" 2>/dev/null || true)
  fi
  case "$_q_prof_raw" in
    economical|manual) _q_prof=$_q_prof_raw ;;
    *) _q_prof=normal ;;
  esac
}

_q_ctx_max() {
  # Global setter (mirrors _q_lang()/_q_fold_prof()'s config-awk read
  # pattern, but sets globals instead of printing -- doctor needs the
  # provenance, not just the resolved number). Chain: QUIPU_CTX_MAX (env) ->
  # vault config ctx_max= -> default 4096. $1 = vault path.
  #
  # A value that is not a positive integer (unset, empty, "abc", "0", "-5")
  # is treated as absent at THAT link and the chain falls through to the
  # next one -- a corrupt/hostile config line must never crash `context`,
  # the same tolerance this file already gives a `stty size` read of 0
  # elsewhere. Sets: $_q_cm (resolved numeric budget), $_q_cm_src
  # (env/config/default -- which link won), $_q_cm_cfg (raw config value,
  # for doctor's warning text), $_q_cm_cfg_bad (1 when config HAD a
  # ctx_max= key but its value didn't qualify, whether or not it ended up
  # being used -- doctor warns on this even when env overrode it, so the
  # user who wrote a broken value in config still finds out).
  _q_cm_vault=$1
  _q_cm_cfg=
  if [ -n "$_q_cm_vault" ] && [ -f "$_q_cm_vault/$_q_SD/config" ]; then
    _q_cm_cfg=$(awk -F= -v k=ctx_max '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_cm_vault/$_q_SD/config" 2>/dev/null || true)
  fi
  case "$_q_cm_cfg" in
    '') _q_cm_cfg_bad=0 ;;
    *[!0-9]*|0) _q_cm_cfg_bad=1 ;;
    *) _q_cm_cfg_bad=0 ;;
  esac

  _q_cm_env=${QUIPU_CTX_MAX:-}
  case "$_q_cm_env" in
    ''|*[!0-9]*|0) _q_cm_env_ok=0 ;;
    *) _q_cm_env_ok=1 ;;
  esac

  if [ "$_q_cm_env_ok" -eq 1 ]; then
    _q_cm=$_q_cm_env
    _q_cm_src="env"
  elif [ "$_q_cm_cfg_bad" -eq 0 ] && [ -n "$_q_cm_cfg" ]; then
    _q_cm=$_q_cm_cfg
    _q_cm_src="config"
  else
    _q_profile "$_q_cm_vault"
    if [ "$_q_prof" = economical ]; then
      _q_cm=4000
      _q_cm_src="profile"
    else
      _q_cm=4096
      _q_cm_src="default"
    fi
  fi
}

_q_msg() {
  # Look up a key in the active language file; fall back to en, then the key.
  # `help` sets _q_msg_lang for its explicit language contract only.
  # Scratch names are function-prefixed -- see the note in _q_lang.
  _q_msg_l=${_q_msg_lang:-$(_q_lang)}
  _q_msg_f="$_q_HOME/i18n/$_q_msg_l.txt"
  if [ ! -f "$_q_msg_f" ]; then
    _q_msg_f="$_q_HOME/i18n/en.txt"
  fi
  _q_msg_v=
  if [ -f "$_q_msg_f" ]; then
    _q_msg_v=$(awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_msg_f" 2>/dev/null || true)
  fi
  if [ -n "$_q_msg_v" ]; then
    printf '%s\n' "$_q_msg_v"
  else
    printf '%s\n' "$1"
  fi
}

_q_die() {
  # _q_die key [code [arg…]] — extra args are printf'd into the message format
  # (FAZ 7 J-2). Legacy `key [code]` calls behave exactly as before.
  _q_dk=$1
  shift
  # An install in progress owns a dot animation on the current line: end it
  # first so the message starts on its own line instead of gluing onto it.
  [ -z "${_q_busy_pid:-}" ] || _q_install_busy_stop
  _q_dc=${1:-1}
  [ "$#" -eq 0 ] || shift
  if [ "$#" -gt 0 ]; then
    _q_dfmt=$(_q_msg "$_q_dk")
    # shellcheck disable=SC2059
    printf "$_q_dfmt\n" "$@" >&2
  else
    _q_msg "$_q_dk" >&2
  fi
  if [ "${QUIPU_HOOK:-0}" = 1 ]; then
    exit 0
  fi
  exit "$_q_dc"
}

_q_warn() {
  _q_msg "$1" >&2
}

_q_line() {
  # Print one doctor row: status<TAB>name<TAB>detail; bump the counter.
  case "$1" in
    ok) OK=$((OK + 1)); _q_st=$(_q_msg doc_ok) ;;
    warn) WARN=$((WARN + 1)); _q_st=$(_q_msg doc_warn) ;;
    fail) FAIL=$((FAIL + 1)); _q_st=$(_q_msg doc_fail) ;;
    *) _q_st=$1 ;;
  esac
  printf '%s\t%s\t%s\n' "$_q_st" "$2" "$3"
}

usage() {
  _q_msg usage_head
  _q_msg usage_help
  _q_msg usage_doctor
  _q_msg usage_capture
  _q_msg usage_index
  _q_msg usage_compile
  _q_msg usage_search
  _q_msg usage_links

  _q_msg usage_init
  _q_msg usage_install
  _q_msg usage_setup
  _q_msg usage_migrate
  _q_msg usage_uninstall
  _q_msg usage_context
  _q_msg help_profile
  _q_msg usage_remember
  _q_msg usage_mcp
  _q_msg usage_note
  _q_msg usage_note_thread
  _q_msg usage_digest
  _q_msg usage_import
  _q_msg usage_plan
  _q_msg usage_tone
  _q_msg usage_flair
  _q_msg usage_archive
  _q_msg usage_compact
  _q_msg usage_tui
  _q_msg usage_update
}

# ---- tui ---------------------------------------------------------------------

_q_tui_sessions() {
  # Newest-first session notes (vault-relative paths, at most 20). The sort is
  # by file name, i.e. by date; awk does the cap so `sort` never sees SIGPIPE.
  _q_ts_lay=$(awk -F= '$1=="layout"{print $2;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  _q_layout_ok "$_q_ts_lay" || _q_ts_lay=emoji
  _q_ts_dir=$(awk -F"$(printf '\t')" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_ts_lay.txt" 2>/dev/null || true)
  [ -n "$_q_ts_dir" ] || _q_ts_dir='📆 700-Sessions'
  for _q_ts_f in "$_q_v/$_q_ts_dir"/*.md; do
    [ -f "$_q_ts_f" ] || continue
    printf '%s/%s\n' "$_q_ts_dir" "$(basename "$_q_ts_f")"
  done | LC_ALL=C sort -r | awk 'NR <= 20'
}

_q_tui_size() {
  # Sets _q_tui_cols and _q_tui_rows; a non-positive or non-numeric answer
  # (a pty whose winsize was never set prints "0 0") falls back to LINES, then 24.
  _q_tui_cols=$(_q_term_cols)
  _q_tui_rows=$(stty size 2>/dev/null | awk '{print $1}')
  case "$_q_tui_rows" in '' | *[!0-9]*) _q_tui_rows=${LINES:-24} ;; esac
  case "$_q_tui_rows" in '' | *[!0-9]*) _q_tui_rows=24 ;; esac
  [ "$_q_tui_rows" -ge 6 ] || _q_tui_rows=24
}

_q_tui_draw() {
  # shortcut: lines are cut by awk substr(), which counts bytes under mawk;
  # a wide UTF-8 path may be cut mid-character, upgrade if that ever matters.
  _q_tui_size
  _q_tui_h=$((_q_tui_rows - 4))
  printf '\033[2J\033[H%s\n\n' "$_q_tui_title"
  if [ -n "$_q_tui_items" ]; then
    printf '%s\n' "$_q_tui_items" | awk -v sel="$_q_tui_sel" -v h="$_q_tui_h" -v cols="$_q_tui_cols" '
      BEGIN { top = int((sel - 1) / h) * h + 1 }
      NR >= top && NR < top + h { printf "%s\n", substr(sprintf("%s%2d  %s", (NR == sel ? "> " : "  "), NR, $0), 1, cols) }'
  fi
  printf '\n%s%s\n' "$_q_tui_note" "$_q_tui_hint"
  _q_tui_note=
}

_q_tui_key() {
  _q_tui_k=$(dd bs=1 count=1 2>/dev/null) || _q_tui_k=
}

_q_tui_page() {
  # Built-in pager over one file: Space next page, b back, q return.
  _q_tp_total=$(awk 'END { print NR }' "$_q_v/$1")
  _q_tp_a=1
  while :; do
    _q_tui_size
    _q_tp_h=$((_q_tui_rows - 2))
    _q_tp_b=$((_q_tp_a + _q_tp_h - 1))
    printf '\033[2J\033[H'
    awk -v a="$_q_tp_a" -v b="$_q_tp_b" -v cols="$_q_tui_cols" 'NR >= a && NR <= b { print substr($0, 1, cols) }' "$_q_v/$1"
    [ "$_q_tp_b" -le "$_q_tp_total" ] || _q_tp_b=$_q_tp_total
    printf '%s %s-%s/%s  %s\n' "$1" "$_q_tp_a" "$_q_tp_b" "$_q_tp_total" "$_q_tui_phint"
    _q_tui_key
    case "$_q_tui_k" in
      ' ') [ $((_q_tp_a + _q_tp_h)) -gt "$_q_tp_total" ] || _q_tp_a=$((_q_tp_a + _q_tp_h)) ;;
      b) _q_tp_a=$((_q_tp_a - _q_tp_h)); [ "$_q_tp_a" -ge 1 ] || _q_tp_a=1 ;;
      q) return 0 ;;
    esac
  done
}

_q_cmd_tui() {
  [ "$#" -eq 0 ] || _q_die err_tui_args 2
  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  _q_tui_home=$(_q_tui_sessions)
  _q_tui_items=$_q_tui_home
  _q_tui_title=$(_q_msg tui_title)

  # Plain path: anything short of a real tty with a usable stty prints the
  # first list once and exits, touching no terminal state at all.
  _q_tui_saved=
  if [ -t 0 ] && [ -t 1 ] && [ "${QUIPU_FORCE_TTY:-0}" != 1 ]; then
    case "${TERM:-}" in '' | dumb) : ;; *)
      if command -v stty >/dev/null 2>&1; then _q_tui_saved=$(stty -g 2>/dev/null) || _q_tui_saved=; fi ;;
    esac
  fi
  if [ -z "$_q_tui_saved" ]; then
    if [ -z "$_q_tui_items" ]; then
      _q_msg tui_empty
    else
      printf '%s\n' "$_q_tui_title"
      printf '%s\n' "$_q_tui_items" | awk '{ printf "%2d  %s\n", NR, $0 }'
    fi
    return 0
  fi

  # Messages are read once here; _q_msg spawns awk and would run per keypress.
  _q_tui_hint=$(_q_msg tui_hint)
  _q_tui_phint=$(_q_msg tui_pager_hint)
  _q_tui_empty=$(_q_msg tui_empty)
  _q_tui_prompt=$(_q_msg tui_search_prompt)
  _q_tui_none=$(_q_msg tui_search_none)
  _q_tui_note=
  _q_tui_mode=sessions
  _q_tui_sel=1
  trap 'stty "$_q_tui_saved" 2>/dev/null || true' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  # -icanon -echo (not `raw`): single-key reads, but Ctrl-C and output
  # post-processing keep working.
  stty -icanon -echo min 1 time 0 2>/dev/null || return 0
  [ -n "$_q_tui_items" ] || _q_tui_note="$_q_tui_empty  "
  while :; do
    _q_tui_n=0
    [ -z "$_q_tui_items" ] || _q_tui_n=$(printf '%s\n' "$_q_tui_items" | awk 'END { print NR }')
    _q_tui_draw
    _q_tui_key
    case "$_q_tui_k" in
      j) [ "$_q_tui_sel" -ge "$_q_tui_n" ] || _q_tui_sel=$((_q_tui_sel + 1)) ;;
      k) [ "$_q_tui_sel" -le 1 ] || _q_tui_sel=$((_q_tui_sel - 1)) ;;
      '')
        # Enter arrives as a newline, which $(...) strips.
        if [ "$_q_tui_n" -gt 0 ]; then
          _q_tui_page "$(printf '%s\n' "$_q_tui_items" | awk -v n="$_q_tui_sel" 'NR == n')"
        fi
        ;;
      /)
        stty "$_q_tui_saved" 2>/dev/null || true
        printf '\n%s' "$_q_tui_prompt"
        read -r _q_tui_q || _q_tui_q=
        stty -icanon -echo min 1 time 0 2>/dev/null || true
        if [ -n "$_q_tui_q" ]; then
          # Subshell: the search's own traps and exits never touch ours.
          _q_tui_res=$( (_q_cmd_search --brief --limit 50 "$_q_tui_q") 2>/dev/null | awk -F "$(printf '\t')" '{ print $2 }')
          if [ -n "$_q_tui_res" ]; then
            _q_tui_items=$_q_tui_res
            _q_tui_mode=results
            _q_tui_sel=1
          else
            _q_tui_note="$_q_tui_none  "
          fi
        fi
        ;;
      q)
        if [ "$_q_tui_mode" = results ]; then
          _q_tui_items=$_q_tui_home
          _q_tui_mode=sessions
          _q_tui_sel=1
        else
          break
        fi
        ;;
    esac
  done
  printf '\n'
}

_q_cmd_help() {
  _q_help_lang=en
  case "$#" in
    0) ;;
    1)
      case "$1" in
