# ---- doctor: memory drift helpers -------------------------------------------

_q_i18n_key() {
  # Read one key from one SPECIFIC i18n file (unlike _q_msg, which always
  # resolves through the active language). The memory audit needs both
  # language spellings of a file name at once, so the legacy fallback works
  # in either direction.
  awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,"");print;exit}' "$1" 2>/dev/null || true
}

_q_companion_path() {
  # Resolves the active layout's companion.md path for vault $1, the same
  # config-layout lookup already inlined at the B-22 doctor check and the
  # PreCompact/SessionStart nudges (config's layout= key, falling back to
  # emoji when unset/unknown, then the layout file's `companion` slug).
  # Prints the path only when the file actually exists; prints nothing
  # otherwise (missing layout key, unknown layout, or no companion.md yet).
  # Never fails. $1: vault root.
  _q_cp_lay=
  if [ -f "$1/$_q_SD/config" ]; then
    _q_cp_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$1/$_q_SD/config" 2>/dev/null || true)
  fi
  _q_layout_ok "$_q_cp_lay" || _q_cp_lay=emoji
  _q_cp_tab=$(printf '\t')
  _q_cp_comp=$(awk -F"$_q_cp_tab" '$1=="companion"{print $2;exit}' "$_q_HOME/layout/$_q_cp_lay.txt" 2>/dev/null || true)
  if [ -n "$_q_cp_comp" ] && [ -f "$1/$_q_cp_comp/companion.md" ]; then
    printf '%s\n' "$1/$_q_cp_comp/companion.md"
  fi
}

_q_tone_extract() {
  # Extracts the BODY of companion.md's Tone section (heading text is i18n
  # key persona_tone_heading, e.g. "## Üslup" / "## Tone") -- everything
  # between that heading and the next "## " heading, exclusive of both.
  # Tried in both the vault language's spelling and the other language's
  # (same tolerance _q_rules_path/_q_facts_path give file names): a
  # companion.md seeded before a vault's language was switched must still
  # resolve. Sets _q_tone_body (trimmed of a trailing blank line before the
  # next heading) and _q_tone_found (1 when the body has content, 0 when
  # the file is missing, the heading is absent, or the section is empty).
  # Never fails. $1: companion.md path.
  _q_tone_found=0
  _q_tone_body=
  [ -f "$1" ] || return 0
  _q_th_pri=$(_q_i18n_key "$_q_HOME/i18n/$(_q_lang_eff).txt" persona_tone_heading)
  _q_th_sec=$(_q_i18n_key "$_q_HOME/i18n/$(_q_lang_alt).txt" persona_tone_heading)
  [ -n "$_q_th_pri" ] || _q_th_pri=Tone
  [ -n "$_q_th_sec" ] || _q_th_sec=Üslup
  _q_tone_body=$(awk -v h1="## $_q_th_pri" -v h2="## $_q_th_sec" '
    index($0, h1) == 1 || index($0, h2) == 1 { found = 1; next }
    found && /^## / { exit }
    found { print }
  ' "$1" | awk 'NF { p = 1 } p { a[++n] = $0 } END { while (n > 0 && a[n] == "") n--; for (i = 1; i <= n; i++) print a[i] }')
  if [ -n "$_q_tone_body" ]; then
    _q_tone_found=1
  fi
}

_q_tone_resolve() {
  # Resolves the single tone body `quipu context` (and `quipu tone`, and
  # doctor) inject, with the priority the tone-preset feature spec requires:
  # config's tone= (a shipped tone/<lang>/<slug>.md file) wins when it names
  # one that actually exists for THIS vault's language; anything else
  # (tone= unset, empty, or naming an unknown/missing slug) falls back to
  # companion.md's own Tone/Üslup section (_q_tone_extract above) -- the
  # exact behavior this project had before presets existed, so an
  # untouched vault's context output is byte-identical to pre-preset quipu.
  # An invalid tone= is NEVER a hard error here (context/the SessionStart
  # hook must never break over a typo in config) -- doctor is the place
  # that surfaces it (doc_tone_invalid).
  #
  # Sets (never fails):
  #   _q_tres_slug  -- raw tone= value from config, or empty if unset
  #   _q_tres_valid -- 1 when _q_tres_slug names a shipped preset file for
  #                    the current language, 0 otherwise (including unset)
  #   _q_tres_source -- preset | companion | none
  #   _q_tres_body  -- the body to inject; empty when source=none
  # $1: vault root.
  _q_tres_v=$1
  _q_tres_slug=
  if [ -f "$_q_tres_v/$_q_SD/config" ]; then
    _q_tres_slug=$(awk -F= -v k=tone '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_tres_v/$_q_SD/config" 2>/dev/null || true)
  fi
  _q_tres_valid=0
  _q_tres_source=none
  _q_tres_body=
  _q_tres_tl=$(_q_lang_pick tone/ "/$_q_tres_slug.md")
  if [ -n "$_q_tres_slug" ] && [ -f "$_q_HOME/tone/$_q_tres_tl/$_q_tres_slug.md" ]; then
    _q_tres_valid=1
    _q_tres_source=preset
    _q_tres_body=$(cat "$_q_HOME/tone/$_q_tres_tl/$_q_tres_slug.md")
  fi
  if [ "$_q_tres_source" = none ]; then
    _q_tres_cp=$(_q_companion_path "$_q_tres_v")
    if [ -n "$_q_tres_cp" ]; then
      _q_tone_extract "$_q_tres_cp"
      if [ "$_q_tone_found" -eq 1 ]; then
        _q_tres_source=companion
        _q_tres_body=$_q_tone_body
      fi
    fi
  fi
}

_q_flair_resolve() {
  # Sets _q_fl_raw (flair= from config), _q_fl_val (none|kaomoji|emoji; anything
  # else is none) and _q_fl_body (the flair/<lang>/<value>.md text, or empty).
  # Independent of tone=: a flair is appended after the tone block. $1: vault root.
  _q_fl_raw=
  if [ -f "$1/$_q_SD/config" ]; then
    _q_fl_raw=$(awk -F= -v k=flair '$1==k{sub(/^[^=]*=/,"");print;exit}' "$1/$_q_SD/config" 2>/dev/null || true)
  fi
  _q_fl_body=
  case "$_q_fl_raw" in
    kaomoji|emoji)
      _q_fl_val=$_q_fl_raw
      _q_fl_l=$(_q_lang_pick flair/ "/$_q_fl_val.md")
      _q_fl_body=$(cat "$_q_HOME/flair/$_q_fl_l/$_q_fl_val.md" 2>/dev/null || true)
      ;;
    *) _q_fl_val=none ;;
  esac
}

_q_style_build() {
  # Sets _q_tone: the tone block, then the flair block (either may be absent),
  # exactly what `context` prints and the AGENTS.md bridge Style section carries.
  # Rule: a flair other than none drops a tone=kaomoji preset -- its "never
  # pictorial emoji" would contradict flair=emoji, and flair=kaomoji says the
  # same thing itself. $1: vault root.
  _q_tone=
  _q_tone_resolve "$1"
  _q_flair_resolve "$1"
  if [ "$_q_tres_source" != none ] && { [ -z "$_q_fl_body" ] || [ "$_q_tres_source" != preset ] || [ "$_q_tres_slug" != kaomoji ]; }; then
    _q_tone="$(_q_msg ctx_tone)
$_q_tres_body

$(_q_msg ctx_tone_priority)
"
  fi
  if [ -n "$_q_fl_body" ]; then
    _q_tone="$_q_tone$(_q_msg ctx_flair)
$_q_fl_body
"
  fi
}

_q_bridge_refresh() {
  # Rewrite the static bridge block of AGENTS.md/CLAUDE.md after tone=/flair=
  # changed: run the real init on a scratch copy (config + the files that have
  # the block) so the block comes from its one source, then copy a changed
  # file back. Text outside the markers is never touched. $1: vault root.
  _q_br_d=$(mktemp -d "${TMPDIR:-/tmp}/knotlog-bridge-XXXXXX") || return 0
  mkdir -p "$_q_br_d/$_q_SD"
  _q_br_have=0
  for _q_br_f in AGENTS.md CLAUDE.md; do
    grep -Eq '^<!-- (knotlog|quipu):start -->$' "$1/$_q_br_f" 2>/dev/null || continue
    cp -- "$1/$_q_br_f" "$_q_br_d/$_q_br_f"
    _q_br_have=1
  done
  if [ "$_q_br_have" -eq 1 ]; then
    cp -- "$1/$_q_SD/config" "$_q_br_d/$_q_SD/config"
    # shellcheck disable=SC2030 # the subshell is the point: init runs on the scratch copy only
    (QUIPU_VAULT="$_q_br_d"; export QUIPU_VAULT; unset QUIPU_HOOK; _q_cmd_init --no-prompt) >/dev/null 2>&1 || _q_br_have=0
  fi
  if [ "$_q_br_have" -eq 1 ]; then
    for _q_br_f in AGENTS.md CLAUDE.md; do
      [ -f "$1/$_q_br_f" ] && [ -f "$_q_br_d/$_q_br_f" ] || continue
      grep -Eq '^<!-- (knotlog|quipu):start -->$' "$1/$_q_br_f" || continue
      cmp -s "$1/$_q_br_f" "$_q_br_d/$_q_br_f" || cat "$_q_br_d/$_q_br_f" > "$1/$_q_br_f"
    done
  fi
  rm -rf "$_q_br_d"
  # The dynamic context block (hook-less `context --bridge`) carries the same
  # tone/flair text; refresh it too when it exists.
  if grep -qs '^<!-- knotlog:context:start -->$' "$1/AGENTS.md" "$1/CLAUDE.md"; then
    # shellcheck disable=SC2030,SC2031 # subshell on purpose
    (QUIPU_VAULT="$1"; export QUIPU_VAULT; unset QUIPU_HOOK; _q_cmd_context --bridge) >/dev/null 2>&1 || true
  fi
}

_q_doctor_stale_topics() {
  _q_dt_v=$1
  _q_dt_thr=$(_q_threads_path "$_q_dt_v")
  _q_dt_idx="$_q_dt_v/$_q_SD/index.tsv"
  [ -f "$_q_dt_thr" ] || return 0
  [ -f "$_q_dt_idx" ] || return 0
  _q_dt_now=$(date +%s)
  _q_dt_active=$(_q_msg threads_head_active)
  _q_dt_closed=$(_q_msg threads_head_closed)
  _q_dt_rows=$(Q_DOCTOR_VAULT="$_q_dt_v" awk -F"$(printf '\t')" \
    -v now="$_q_dt_now" -v active="$_q_dt_active" -v closed="$_q_dt_closed" \
    'function mention_(s, mt,    h, c) {
       h = 0
       while (substr(s, h + 1, 1) == "#") h++
       if (h > 0 && substr(s, h + 1, 1) == " ") {
         c = substr(s, h + 2)
         if (c != "" && (mt + 0) > latest[c]) latest[c] = mt + 0
       }
     }
     BEGIN { live = 1 }
     FILENAME == ARGV[1] {
       if ($2 != "" && ($4 + 0) > latest[$2]) latest[$2] = $4 + 0
       f = ENVIRON["Q_DOCTOR_VAULT"] "/" $1
       while ((getline line < f) > 0) mention_(line, $4)
       close(f)
       next
     }
     {
       s = $0; h = 0
       while (substr(s, h + 1, 1) == "#") h++
       if (h == 0 || substr(s, h + 1, 1) != " ") next
       c = substr(s, h + 2)
       if (c == active) { live = 1; next }
       if (c == closed) { live = 0; next }
       if (!live) next
       if ((c in latest) && latest[c] > 0 && now - latest[c] >= 7776000 && !seen[c]++) {
         print c "\t" int((now - latest[c]) / 86400)
       }
     }' "$_q_dt_idx" "$_q_dt_thr")
  while IFS="$(printf '\t')" read -r _q_dt_topic _q_dt_days; do
    [ -n "$_q_dt_topic" ] || continue
    _q_dt_fmt=$(_q_msg compile_stale)
    # shellcheck disable=SC2059
    _q_line warn topics "$(printf "$_q_dt_fmt" "$_q_dt_topic" "$_q_dt_days")"
  done <<EOF
$_q_dt_rows
EOF
}

_q_mem_find() {
  # Locate one narrative memory file in vault $1: name $3 (current, i.e. the
  # vault language's spelling) then $4 (legacy spelling) inside the vault
  # root, then inside $2 (companion folder; may be empty). Prints the found
  # path; prints nothing when neither name exists anywhere. Never fails.
  _q_mf_v=$1
  for _q_mf_d in "$_q_mf_v" "${2:+$_q_mf_v/$2}"; do
    if [ -f "$_q_mf_d/$3" ]; then
      printf '%s\n' "$_q_mf_d/$3"
      return 0
    fi
    if [ -f "$_q_mf_d/$4" ]; then
      printf '%s\n' "$_q_mf_d/$4"
      return 0
    fi
  done
  return 0
}

_q_session_file() {
  # The session file of vault $1, resolved exactly as doctor's D1 does
  # (vault-language name, then the other language's name; vault root, then
  # the layout's companion folder). When none exists yet, the vault-language
  # name at the root. remember writes here (T-539): it used to write a
  # hardcoded root Last-Session.md, so a Turkish vault got an English file
  # doctor never treated as the session file.
  _q_sf_tab=$(printf '\t')
  _q_sf_lay=
  if [ -f "$1/$_q_SD/config" ]; then
    _q_sf_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$1/$_q_SD/config" 2>/dev/null || true)
  fi
  _q_sf_comp=
  if _q_layout_ok "$_q_sf_lay"; then
    _q_sf_comp=$(awk -F"$_q_sf_tab" '$1=="companion"{print $2;exit}' "$_q_HOME/layout/$_q_sf_lay.txt" 2>/dev/null || true)
  fi
  _q_sf_pri=$(_q_lang_eff)
  _q_sf_sec=$(_q_lang_alt)
  _q_sf_a=$(_q_i18n_key "$_q_HOME/i18n/$_q_sf_pri.txt" mem_session)
  _q_sf_b=$(_q_i18n_key "$_q_HOME/i18n/$_q_sf_sec.txt" mem_session)
  _q_sf=$(_q_mem_find "$1" "$_q_sf_comp" "$_q_sf_a" "$_q_sf_b")
  if [ -z "$_q_sf" ]; then
    _q_sf="$1/$_q_sf_a"
  fi
  printf '%s\n' "$_q_sf"
}

_q_union_lines() {
  # The .gitattributes lines of vault $1, one per line. merge=union keeps both
  # sides' added lines, so it is right ONLY for files that grow by appending:
  # the last-session file (one "## " card per session, so two machines never
  # touch the same lines) and the journal. NOT the threads file (items move
  # between sections and are edited in place; union would resurrect or duplicate
  # them) and not the AGENTS.md/CLAUDE.md blocks (rewritten in place).
  _q_ul_sf=$(_q_session_file "$1")
  _q_ul_dir=${_q_ul_sf%/*}
  _q_ul_seen='|'
  for _q_ul_c in '' $(_q_langs); do
    if [ -z "$_q_ul_c" ]; then
      _q_ul_f=$_q_ul_sf
    else
      _q_ul_f="$_q_ul_dir/$(_q_i18n_key "$_q_HOME/i18n/$_q_ul_c.txt" mem_journal)"
    fi
    case "$_q_ul_seen" in *"|$_q_ul_f|"*) continue ;; esac
    _q_ul_seen="$_q_ul_seen$_q_ul_f|"
    [ "$_q_ul_f" = "$_q_ul_sf" ] || [ -f "$_q_ul_f" ] || continue
    _q_ul_r=${_q_ul_f#"$1"/}
    case "$_q_ul_r" in
      *" "*) printf '"/%s" merge=union\n' "$_q_ul_r" ;;
      *) printf '/%s merge=union\n' "$_q_ul_r" ;;
    esac
  done
}

_q_union_missing() {
  # Print the union lines of vault $1 that .gitattributes does not have yet.
  _q_um_have="$1/.gitattributes"
  _q_union_lines "$1" | while IFS= read -r _q_um_l; do
    [ -f "$_q_um_have" ] && grep -Fxq -- "$_q_um_l" "$_q_um_have" || printf '%s\n' "$_q_um_l"
  done
}

_q_union_ensure() {
  # Append the missing union lines to $1/.gitattributes (created if absent).
  # Never rewrites or removes a line; adds the newline a last line may lack.
  _q_ue_miss=$(_q_union_missing "$1")
  [ -n "$_q_ue_miss" ] || return 0
  _q_ue_f="$1/.gitattributes"
  if [ -s "$_q_ue_f" ] && [ -n "$(tail -c 1 "$_q_ue_f")" ]; then
    printf '\n' >> "$_q_ue_f"
  fi
  printf '%s\n' "$_q_ue_miss" >> "$_q_ue_f"
}

# ---- init -------------------------------------------------------------------

_q_HOME=$(_q_home)

# Single source of truth for the shipped version. `--version` and
# `update --check` (comparing the shipped version against the latest
# release) both read this instead of each carrying their own copy of the
# literal, which is what let the two drift apart before this existed.
_q_version=1.1.1

# ---- doctor -----------------------------------------------------------------

_q_wsl_bash() {
  # Windows only: succeed when the bash first on PATH is WSL's
  # System32\bash.exe. Hook commands run through that bash fail with exit
  # 127 and the error is swallowed, so doctor warns. Other systems: no-op.
  case $(uname -s 2>/dev/null) in
    MINGW* | MSYS* | CYGWIN*) ;;
    *) return 1 ;;
  esac
  _q_wb=$(command -v bash 2>/dev/null) || return 1
  _q_wb=$(printf '%s' "$_q_wb" | tr '[:upper:]' '[:lower:]')
  case "$_q_wb" in
    *system32*) return 0 ;;
  esac
  return 1
}

_q_doctor() {
  OK=0
  WARN=0
  FAIL=0

  _q_msg doc_head

  _q_msg doc_sec_tools
  for _q_t in sh sed awk grep tr git find date head; do
    if _q_p=$(command -v "$_q_t" 2>/dev/null); then
      _q_line ok "$_q_t" "$_q_p"
    else
      _q_line fail "$_q_t" "-"
    fi
  done
  if _q_wsl_bash; then
    _q_line warn bash "$(_q_msg doc_wsl_bash)"
  fi

  _q_msg doc_sec_dialects
  if stat -c %Y "$0" >/dev/null 2>&1; then
    _q_line ok stat "$(_q_msg doc_stat_gnu)"
  elif stat -f %m "$0" >/dev/null 2>&1; then
    _q_line ok stat "$(_q_msg doc_stat_bsd)"
  else
    _q_line fail stat "$(_q_msg doc_stat_none)"
  fi
  _q_awk=$(awk 'BEGIN{printf "%c",92}')
  # The shell must itself produce one backslash byte to test awk against.
  # shellcheck disable=SC1003
  _q_bs=$(printf '\\')
  if [ "$_q_awk" = "$_q_bs" ]; then
    _q_line ok awk "$(_q_msg doc_awk_bs)"
  else
    _q_line fail awk "$(_q_msg doc_awk_bs)"
  fi

  # Language-independent files are listed; per-language files come from the
  # language list (_q_langs). English must ship every asset; another language
  # may omit one (it falls back to English) but not ship it half-way.
  _q_shipped="fold/tr.sed fold/latin.sed fold/default.sed layout/emoji.txt layout/plain.txt layout/status.txt lib/compile.awk lib/import.awk lib/repair.awk lib/metadata.awk repair-hooks repair-hooks.ps1 icon/Knotlog.png icon/Knotlog.ico"
  for _q_lc in $(_q_langs); do
    _q_shipped="$_q_shipped i18n/$_q_lc.txt"
    for _q_lf in persona/$_q_lc.md layout/$_q_lc.txt layout/scope-$_q_lc.txt; do
      if [ "$_q_lc" = en ] || [ -f "$_q_HOME/$_q_lf" ]; then
        _q_shipped="$_q_shipped $_q_lf"
      fi
    done
    for _q_ld in templates tone flair; do
      if [ "$_q_lc" = en ] || [ -d "$_q_HOME/$_q_ld/$_q_lc" ]; then
        for _q_lt in "$_q_HOME/$_q_ld/en"/*; do
          _q_shipped="$_q_shipped $_q_ld/$_q_lc/${_q_lt##*/}"
        done
      fi
    done
  done
  for _q_f in $_q_shipped; do
    if [ -f "$_q_HOME/$_q_f" ]; then
      _q_line ok "$_q_f" "-"
    else
      _q_line fail "$_q_f" "-"
    fi
  done
  _q_tab=$(printf '\t')
  _q_s1=$(awk -F"$_q_tab" 'NF >= 2 && $0 !~ /^#/ {print $1}' "$_q_HOME/layout/emoji.txt" 2>/dev/null || true)
  _q_s2=$(awk -F"$_q_tab" 'NF >= 2 && $0 !~ /^#/ {print $1}' "$_q_HOME/layout/plain.txt" 2>/dev/null || true)
  if [ -n "$_q_s1" ] && [ "$_q_s1" = "$_q_s2" ]; then
    _q_line ok 'layout/*.txt' '-'
  else
    _q_line fail 'layout/*.txt' "$(_q_msg doc_layout_mismatch)"
  fi

  _q_msg doc_sec_vault
  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_line warn vault "$(_q_msg doc_vault_missing)"
  else
    _q_line ok vault "$(_q_msg doc_vault_ok)"
    # A vault from before the rename still works in place; point at migrate.
    if [ -d "$_q_v/.quipu" ] || { [ -f "$_q_v/$_q_SD/config" ] && grep -q '^QUIPU_' "$_q_v/$_q_SD/config"; }; then
      _q_line warn "$(_q_msg doc_migrate)" "$(_q_msg doc_migrate_old)"
    fi
    # FAZ 2 (spec 4.6 B-21): layout line from config.
    _q_lay=
    if [ -f "$_q_v/$_q_SD/config" ]; then
      _q_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    fi
    if [ -z "$_q_lay" ]; then
      _q_line warn "$(_q_msg doc_layout)" "$(_q_msg doc_layout_missing)"
    else
      _q_line ok "$(_q_msg doc_layout)" "$_q_lay"
    fi
    # Fold profile (V1-DUZELTME R-3): absent -> warn (exit stays 0); present
    # but no matching fold/<value>.sed -> fail. Mirror of the layout pattern
    # above, except an unknown value is fatal: index and search would both
    # break on a sed script that does not exist.
    _q_fpr=
    if [ -f "$_q_v/$_q_SD/config" ]; then
      _q_fpr=$(awk -F= -v k=fold '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    fi
    if [ -z "$_q_fpr" ]; then
      _q_line warn "$(_q_msg doc_fold)" "$(_q_msg doc_fold_missing)"
    elif [ -f "$_q_HOME/fold/$_q_fpr.sed" ]; then
      _q_line ok "$(_q_msg doc_fold)" "$_q_fpr"
    else
      _q_line fail "$(_q_msg doc_fold)" "$(_q_msg doc_fold_unknown)"
    fi
    # ctx_max chain provenance -- mirror of the doc_layout/doc_fold rows
    # above, but this key has an always-usable default (4096), so absence
    # is never a warn: only a config value that failed the positive-integer
    # check is (it means the user wrote something and it silently isn't
    # being used). Warn fires even when env overrode the bad config value,
    # so a broken written-by-hand line is never invisible.
    _q_ctx_max "$_q_v"
    if [ "$_q_cm_cfg_bad" -eq 1 ]; then
      _q_cmfmt=$(_q_msg doc_ctx_max_bad)
      # shellcheck disable=SC2059
      _q_line warn "$(_q_msg doc_ctx_max)" "$(printf "$_q_cmfmt" "$_q_cm_cfg" "$_q_cm")"
    else
      case "$_q_cm_src" in
        env) _q_cmsfmt=$(_q_msg doc_ctx_max_env) ;;
        config) _q_cmsfmt=$(_q_msg doc_ctx_max_config) ;;
        profile) _q_cmsfmt=$(_q_msg doc_ctx_max_profile) ;;
        *) _q_cmsfmt=$(_q_msg doc_ctx_max_default) ;;
      esac
      # shellcheck disable=SC2059
      _q_line ok "$(_q_msg doc_ctx_max)" "$(printf "$_q_cmsfmt" "$_q_cm")"
    fi
    # profile= row: only when the key is present, so a default vault's
    # ok count is unchanged; an unknown value warns and runs as normal.
    _q_profile "$_q_v"
    if [ -n "$_q_prof_raw" ]; then
      if [ "$_q_prof" = normal ] && [ "$_q_prof_raw" != normal ]; then
        # shellcheck disable=SC2059
        _q_line warn "$(_q_msg doc_profile)" "$(printf "$(_q_msg doc_profile_bad)" "$_q_prof_raw")"
      else
        _q_line ok "$(_q_msg doc_profile)" "$_q_prof"
      fi
    fi
    # B-K2: threads-file overflow -- the doc_threads_empty mirror. That row
    # warns when Konular.md/Threads.md is empty; nothing warned when the
    # file silently OVERFLOWS quipu context's own injection budget (the
    # Konular-Butce-Tasmasi.md incident: a 100.6 KB file against a 10 KB
    # budget dropped the oldest entries -- including a time-sensitive one --
    # every single session for months while doctor stayed green). This does
    # NOT re-derive a new size/budget formula: it calls _q_ctx_text, the
    # SAME function quipu context itself calls, and reads back the globals
    # it leaves set (quipu:3396 onward) -- $_q_budget is exactly the byte
    # slack the threads section gets after every fixed part (now/identity/
    # purpose/tone/activity/index) and the truncation-marker reserve are
    # subtracted from ctx_max. Silent when the file is missing (that is
    # doc_threads_empty's job, not this one's) or when it fits inside that
    # slack -- the same restraint doc_threads_empty itself shows for a
    # filled file.
    _q_thr_p=$(_q_threads_path "$_q_v")
    if [ -f "$_q_thr_p" ]; then
      _q_limit=10
      _q_ctx_text
      # B-K5: pin bytes are charged against $_q_fixed (and so already
      # subtracted out of $_q_budget above, in _q_ctx_text) -- comparing the
      # WHOLE file's size against that pin-adjusted budget double-counts the
      # pin's bytes (once against the budget, once against the size) and
      # overstates how much of the file is actually being dropped. Pull the
      # pin's footprint out of the file size the SAME way it was pulled out
      # of the budget: reuse $_q_pin (set by _q_ctx_text's own
      # _q_pin_extract call just above) with the identical "%s\n" framing
      # _q_pin_fx uses when it joins $_q_fixed -- not a new pin parser, the
      # same one, so the two subtractions cancel exactly. A pin-less vault
      # has $_q_pin empty, so $_q_pin_size is 0 and this is byte-identical
      # to the pre-B-K5 formula (T-474/475/476).
      _q_pin_size=0
      if [ -n "$_q_pin" ]; then
        _q_pin_size=$(printf '%s\n' "$_q_pin" | LC_ALL=C wc -c | tr -d ' ')
      fi
      _q_thr_size=$(wc -c < "$_q_thr_p" | tr -d ' ')
      _q_thr_crop=$((_q_thr_size - _q_pin_size))
      _q_thr_bud=$_q_budget
      if [ "$_q_thr_bud" -lt 0 ]; then
        _q_thr_bud=0
      fi
      if [ "$_q_thr_crop" -gt "$_q_thr_bud" ]; then
        _q_thr_drop=$((_q_thr_crop - _q_thr_bud))
        _q_thr_pct=$((_q_thr_drop * 100 / _q_thr_crop))
        _q_thr_name=${_q_thr_p#"$_q_v"/}
        _q_tofmt=$(_q_msg doc_threads_overflow)
        # shellcheck disable=SC2059
        _q_line warn threads "$(printf "$_q_tofmt" "$_q_thr_name" "$_q_thr_crop" "$_q_thr_bud" "$_q_thr_pct")"
      fi
      # B-K1: pin block oversize -- this one is an ERROR (fail), not a warn,
      # deliberately a different tone than doc_threads_overflow just above.
      # The pin block (<!-- knotlog:pin:start/end -->) is guaranteed to never
      # be truncated -- its bytes join the FIXED part of the context budget,
      # never the croppable threads section (quipu:_q_ctx_text, B-K1). A
      # source that overflows the CROPPABLE section still degrades
      # gracefully: it loses its oldest lines and the rest of the vault's
      # memory keeps working, which is exactly what doc_threads_overflow's
      # warn tone fits. A pin block that is bigger than ctx_max BY ITSELF
      # has no such degradation path -- honoring "never truncate the pin"
      # would mean silently emitting more than the configured budget, with
      # zero room left for anything else (activity, index, tone, even the
      # truncation marker). Nothing in the vault can make that safe except
      # the vault itself changing (shrink the pin block, or raise ctx_max),
      # so doctor fails instead of warning. Reuses $_q_pin_size (computed
      # above, same formula B-K1 originally used here) and $_q_max, the
      # same globals _q_ctx_text (called just above for the overflow check)
      # already left set -- no second budget formula.
      if [ -n "$_q_pin" ]; then
        if [ "$_q_pin_size" -gt "$_q_max" ]; then
          _q_pofmt=$(_q_msg doc_pin_oversize)
          # shellcheck disable=SC2059
          _q_line fail pin "$(printf "$_q_pofmt" "$_q_pin_size" "$_q_max")"
        fi
      fi
    fi
    # FAZ 9 V-5: identity — user= or companion= absent -> warn (exit stays 0).
    # Mirror of the doc_layout_missing pattern above.
    _q_idu=$(awk -F= -v k=user '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    _q_idc=$(awk -F= -v k=companion '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    if [ -z "$_q_idu" ] && [ -z "$_q_idc" ]; then
      _q_line warn "$(_q_msg doc_identity)" "$(_q_msg doc_identity_missing)"
    elif [ -z "$_q_idu" ]; then
      _q_line warn "$(_q_msg doc_identity)" "$(_q_msg doc_identity_missing_user)"
    elif [ -z "$_q_idc" ]; then
      _q_line warn "$(_q_msg doc_identity)" "$(_q_msg doc_identity_missing_companion)"
    else
      _q_line ok "$(_q_msg doc_identity)" "$_q_idu/$_q_idc"
    fi
    # Tone-preset provenance: tone= set but not naming a shipped preset for
    # this vault's language falls back to companion.md's Tone section
    # silently (the same fallback quipu context takes, see
    # _q_tone_resolve) -- warn so a typo'd slug doesn't stay invisible.
    # Independent of layout being known: tone/ files live in $_q_HOME, not
    # in a layout folder.
    _q_tone_cfg=
    if [ -f "$_q_v/$_q_SD/config" ]; then
      _q_tone_cfg=$(awk -F= -v k=tone '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    fi
    if [ -n "$_q_tone_cfg" ] && [ ! -f "$_q_HOME/tone/$(_q_lang_pick tone/ "/$_q_tone_cfg.md")/$_q_tone_cfg.md" ]; then
      # shellcheck disable=SC2059
      _q_line warn tone "$(printf "$(_q_msg doc_tone_invalid)" "$_q_tone_cfg")"
    fi
    # flair=: only when the key is present; an unknown value runs as none.
    _q_flair_resolve "$_q_v"
    if [ -n "$_q_fl_raw" ] && [ "$_q_fl_raw" != none ] && [ "$_q_fl_val" = none ]; then
      # shellcheck disable=SC2059
      _q_line warn "$(_q_msg doc_flair)" "$(printf "$(_q_msg doc_flair_invalid)" "$_q_fl_raw")"
    fi
    # FAZ 2 (spec 4.6 B-22): companion check, only for a known layout.
    if _q_layout_ok "$_q_lay"; then
      _q_comp=$(awk -F"$_q_tab" '$1=="companion"{print $2;exit}' "$_q_HOME/layout/$_q_lay.txt" 2>/dev/null || true)
      if [ -n "$_q_comp" ] && [ ! -f "$_q_v/$_q_comp/companion.md" ]; then
        _q_line warn companion "$(_q_msg doc_companion_missing)"
      elif [ -n "$_q_comp" ] && [ -f "$_q_v/$_q_comp/companion.md" ]; then
        # Tone check: companion.md exists but if the Tone/Üslup heading is
        # missing (renamed by hand, or a pre-existing file predating this
        # feature), context's Fixed part 0c silently injects nothing --
        # this project's most expensive failure class is a silent one, so
        # the gap gets a warning row rather than staying invisible.
        _q_tone_extract "$_q_v/$_q_comp/companion.md"
        if [ "$_q_tone_found" -eq 0 ]; then
          _q_line warn companion "$(_q_msg doc_companion_tone_missing)"
        fi
      fi
    fi
    if [ ! -f "$_q_v/$_q_SD/index.tsv" ]; then
      _q_line warn index "$(_q_msg doc_index_stale)"
    elif [ -s "$_q_v/$_q_SD/index.tsv" ] && ! awk -F"$_q_tab" 'NR==1{exit !(NF>=7)}' "$_q_v/$_q_SD/index.tsv"; then
      # FAZ 10 Z-2: pre-FAZ10 (5-column) index.tsv left behind -> warn, mirror
      # of doc_index_stale above; `quipu index` self-heals it (no --full ask).
      _q_line warn index "$(_q_msg doc_index_schema)"
    else
      _q_new=$( (cd "$_q_v" && _q_mdlist "$_q_SD/index.tsv") 2>/dev/null || true)
      if [ -n "$_q_new" ]; then
        _q_line warn index "$(_q_msg doc_index_stale)"
      else
        _q_line ok index "-"
      fi
    fi
    # Block index (2026-09-30): .quipu/blocks.tsv should hold rows for exactly
    # the notes whose search field hit the 2000-character cap. Information
    # only (`info` row, not counted as a warning): search still works, the
    # tail of an affected note is just not searchable until `quipu index`.
    # Silent when consistent, so a healthy vault's doctor output is unchanged.
    if [ -s "$_q_v/$_q_SD/index.tsv" ]; then
      if [ ! -f "$_q_v/$_q_SD/blocks.tsv" ]; then
        _q_line info blocks "$(_q_msg doc_blocks_absent)"
      else
        _q_bc=$(awk -F"$_q_tab" -v cap=2000 '
            FNR == NR { if ($1 != "") { inidx[$1] = 1; if (length($5) >= cap) longnote[$1] = 1 } next }
            { hasblk[$1] = 1 }
            END {
              for (p in hasblk) if (!(p in inidx)) extra++
              for (p in longnote) if (!(p in hasblk)) miss++
              print (extra + 0), (miss + 0)
            }
          ' "$_q_v/$_q_SD/index.tsv" "$_q_v/$_q_SD/blocks.tsv")
        _q_bextra=$(printf '%s\n' "$_q_bc" | awk '{print $1; exit}')
        _q_bmiss=$(printf '%s\n' "$_q_bc" | awk '{print $2; exit}')
        if [ "$_q_bextra" -gt 0 ] || [ "$_q_bmiss" -gt 0 ]; then
          _q_bfmt=$(_q_msg doc_blocks_mismatch)
          # shellcheck disable=SC2059
          _q_line info blocks "$(printf "$_q_bfmt" "$_q_bextra" "$_q_bmiss")"
        fi
      fi
    fi
    # FAZ 13 N-3: broken/ambiguous wikilinks. mode=resolve (lib/index.awk,
    # N-1/N-2) walks links.tsv once against index.tsv's exists/title/
    # basename lookup tables and tags every row ok/ambiguous/broken; this
    # block counts the non-ok kinds PER UNIQUE TARGET (`!seen[$2]++`) — the
    # same granularity the old bare/+.md heuristic counted in just below
    # (it deduped by $2 too, over the whole links.tsv). That granularity
    # match is required, not cosmetic: links.tsv rows are NOT deduped
    # (FAZ 10 Z-5 — a target linked from two different notes is two rows),
    # so without this dedup a still-broken target referenced twice would
    # count 2 here against the old code's 1, breaking the "never higher"
    # guarantee (T-196) even though stage 1 is byte-for-byte the old
    # heuristic. The old mktemp + `while read` + ${var%.md} loop (bash 3.2
    # case-in-$() avoidance, CI 32594576381) is gone: mode=resolve never
    # uses `case`, so nothing here needs that workaround any more. Silent
    # when links.tsv is absent or empty (no wikilinks used yet is not a
    # warning condition) — same guard as before.
    _q_lf="$_q_v/$_q_SD/links.tsv"
    if [ -f "$_q_lf" ] && [ -s "$_q_lf" ] && [ -f "$_q_v/$_q_SD/index.tsv" ]; then
      _q_rc=$(awk -v mode=resolve -f "$_q_HOME/lib/index.awk" \
          "$_q_v/$_q_SD/index.tsv" "$_q_lf" \
        | awk -F"$_q_tab" '
            !seen[$2]++ {
              if ($3 == "broken") b++
              if ($3 == "ambiguous") a++
            }
            END { print (b + 0), (a + 0) }
          ')
      _q_bcount=$(printf '%s\n' "$_q_rc" | awk '{print $1; exit}')
      _q_acount=$(printf '%s\n' "$_q_rc" | awk '{print $2; exit}')
      if [ "$_q_bcount" -gt 0 ]; then
        _q_bfmt=$(_q_msg doc_links_broken)
        # shellcheck disable=SC2059
        _q_line warn links "$(printf "$_q_bfmt" "$_q_bcount")"
      fi
      if [ "$_q_acount" -gt 0 ]; then
        _q_afmt=$(_q_msg doc_links_ambiguous)
        # shellcheck disable=SC2059
        _q_line warn links "$(printf "$_q_afmt" "$_q_acount")"
      fi
    fi
    _q_log="$_q_v/$_q_SD/activity.log"
    if [ -f "$_q_log" ]; then
      _q_size=$(wc -c < "$_q_log")
    else
      _q_size=0
    fi
    _q_line ok "$(_q_msg doc_log_size)" "$_q_size"

    # FAZ 16 (AD-4): Threads.md liveness -- informational only, never fails
    # (never touches FAIL/exit code), mirrors the doc_identity_missing
    # pattern above. _q_threads_filled already folds "file missing" into
    # _q_tf=0 (guard at quipu:235's `[ -f "$1" ] || return 0`), so a single
    # call covers all three warn conditions the spec names: absent file,
    # marker-less file, and a marker present but empty (AD-3). A present AND
    # filled block prints no line at all -- the same restraint the reflect
    # block itself gets (no doctor row of its own either).
    _q_threads_filled "$(_q_threads_path "$_q_v")"
    if [ "$_q_tf" -eq 0 ]; then
      _q_line warn threads "$(_q_msg doc_threads_empty)"
    fi
    _q_doctor_stale_topics "$_q_v"
    # B5: the facts file. One informational ok row when present, naming the
    # tagged fact-line count -- the vault's semantic layer reporting that it
    # exists. Silence when absent: an old vault without Facts.md is normal,
    # not drift (the same backwards compatibility the rules file keeps in
    # T-402), and a fresh init seeds the file anyway.
    _q_fts_p=$(_q_facts_path "$_q_v")
    if [ -f "$_q_fts_p" ]; then
      _q_fts_n=$(awk '/^- / { n++ } END { print n + 0 }' "$_q_fts_p")
      _q_ffmt=$(_q_msg doc_facts_n)
      # shellcheck disable=SC2059
      _q_line ok facts "$(printf "$_q_ffmt" "$_q_fts_n")"
    fi
  fi

  # ---- hafıza sapması denetimi (D1..D5, D7) --------------------------------
  # Narrative memory audit. Two invariants hold by construction: a vault
  # with NO narrative memory (fresh init, or remember-only with nothing but
  # Last-Session.md) prints no row here at all, and every check that can
  # warn stays a warning -- only a missing mandatory memory file fails
  # (SD2: the motor is crippled when the memory layer is half-migrated,
  # which is exactly how the 2026-09-02 incident stayed invisible).
  _q_msg doc_sec_memory
  _q_mv=$(_q_vault)
  if [ -n "$_q_mv" ]; then
    # Companion folder of the active layout (same lookup as the B-22 check
    # above). Fresh variable names on purpose: the warnings section below
    # still reads _q_lay as the vault section left it.
    _q_mlay=
    if [ -f "$_q_mv/$_q_SD/config" ]; then
      _q_mlay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_mv/$_q_SD/config" 2>/dev/null || true)
    fi
    _q_mcomp=
    if _q_layout_ok "$_q_mlay"; then
      _q_mcomp=$(awk -F"$_q_tab" '$1=="companion"{print $2;exit}' "$_q_HOME/layout/$_q_mlay.txt" 2>/dev/null || true)
    fi

    # D1: the four narrative files are named after the vault language
    # (i18n keys mem_*), with the other language's spelling kept as the
    # legacy fallback -- vaults renamed in the field and vaults that predate
    # localization must both keep resolving. Root wins over companion
    # folder; the threads file keeps its own resolver (threads_file).
    _q_pri=$(_q_lang_eff)
    _q_sec=$(_q_lang_alt)
    _q_nm_ses_a=$(_q_i18n_key "$_q_HOME/i18n/$_q_pri.txt" mem_session)
    _q_nm_ses_b=$(_q_i18n_key "$_q_HOME/i18n/$_q_sec.txt" mem_session)
    _q_nm_rul_a=$(_q_i18n_key "$_q_HOME/i18n/$_q_pri.txt" mem_rules)
    _q_nm_rul_b=$(_q_i18n_key "$_q_HOME/i18n/$_q_sec.txt" mem_rules)
    _q_nm_cor_a=$(_q_i18n_key "$_q_HOME/i18n/$_q_pri.txt" mem_core)
    _q_nm_cor_b=$(_q_i18n_key "$_q_HOME/i18n/$_q_sec.txt" mem_core)
    _q_nm_jrn_a=$(_q_i18n_key "$_q_HOME/i18n/$_q_pri.txt" mem_journal)
    _q_nm_jrn_b=$(_q_i18n_key "$_q_HOME/i18n/$_q_sec.txt" mem_journal)
    _q_f_ses=$(_q_mem_find "$_q_mv" "$_q_mcomp" "$_q_nm_ses_a" "$_q_nm_ses_b")
    _q_f_rul=$(_q_mem_find "$_q_mv" "$_q_mcomp" "$_q_nm_rul_a" "$_q_nm_rul_b")
    _q_f_cor=$(_q_mem_find "$_q_mv" "$_q_mcomp" "$_q_nm_cor_a" "$_q_nm_cor_b")
    _q_f_jrn=$(_q_mem_find "$_q_mv" "$_q_mcomp" "$_q_nm_jrn_a" "$_q_nm_jrn_b")
    _q_f_thr=$(_q_threads_path "$_q_mv")
    _q_f_com=
    if [ -n "$_q_mcomp" ] && [ -f "$_q_mv/$_q_mcomp/companion.md" ]; then
      _q_f_com="$_q_mv/$_q_mcomp/companion.md"
    fi

    # D1, activation: the mandatory contract wakes only when the vault
    # carries a hand-written narrative file (rules, core or journal).
    # Last-Session.md alone is remember's own artifact -- a remember-only
    # vault is healthy and must stay silent. Once active, EVERY file of the
    # set is mandatory and each missing one is a FAIL, never a silent skip.
    # B3: a rules file that is still byte-identical to the shipped template
    # is the init seed, not an adoption -- it must not wake the mandatory
    # contract, or every fresh init vault would demand Core.md/Journal.md/
    # Last-Session.md on day one (the "fresh vault exits doctor 0"
    # invariant pinned by the suite). The moment the user edits the file,
    # it differs from both templates and counts as hand-written.
    _q_rul_active=0
    if [ -n "$_q_f_rul" ]; then
      _q_rules_adopted "$_q_f_rul"
      _q_rul_active=$_q_ra
    fi
    _q_mactive=0
    for _q_f in "$_q_f_cor" "$_q_f_jrn"; do
      if [ -n "$_q_f" ]; then
        _q_mactive=1
      fi
    done
    if [ "$_q_rul_active" -eq 1 ]; then
      _q_mactive=1
    fi
    if [ "$_q_mactive" -eq 1 ]; then
      _q_mfound=0
      _q_mtotal=5
      if [ -n "$_q_f_ses" ]; then
        _q_mfound=$((_q_mfound + 1))
      else
        _q_mfmt=$(_q_msg doc_mem_missing)
        # shellcheck disable=SC2059
        _q_line fail "$(_q_msg doc_mem)" "$(printf "$_q_mfmt" "$_q_nm_ses_a" "$_q_nm_ses_b")"
      fi
      if [ -n "$_q_f_rul" ]; then
        _q_mfound=$((_q_mfound + 1))
      else
        _q_mfmt=$(_q_msg doc_mem_missing)
        # shellcheck disable=SC2059
        _q_line fail "$(_q_msg doc_mem)" "$(printf "$_q_mfmt" "$_q_nm_rul_a" "$_q_nm_rul_b")"
      fi
      if [ -n "$_q_f_cor" ]; then
        _q_mfound=$((_q_mfound + 1))
      else
        _q_mfmt=$(_q_msg doc_mem_missing)
        # shellcheck disable=SC2059
        _q_line fail "$(_q_msg doc_mem)" "$(printf "$_q_mfmt" "$_q_nm_cor_a" "$_q_nm_cor_b")"
      fi
      if [ -n "$_q_f_jrn" ]; then
        _q_mfound=$((_q_mfound + 1))
      else
        _q_mfmt=$(_q_msg doc_mem_missing)
        # shellcheck disable=SC2059
        _q_line fail "$(_q_msg doc_mem)" "$(printf "$_q_mfmt" "$_q_nm_jrn_a" "$_q_nm_jrn_b")"
      fi
      if [ -f "$_q_f_thr" ]; then
        _q_mfound=$((_q_mfound + 1))
      else
        _q_tfmt=$(_q_msg doc_mem_threads)
        # shellcheck disable=SC2059
        _q_line fail "$(_q_msg doc_mem)" "$(printf "$_q_tfmt" "${_q_f_thr##*/}")"
      fi
      if [ "$_q_mfound" -eq "$_q_mtotal" ]; then
        _q_mfmt=$(_q_msg doc_mem_full)
        # shellcheck disable=SC2059
        _q_line ok "$(_q_msg doc_mem)" "$(printf "$_q_mfmt" "$_q_mfound" "$_q_mtotal")"
      fi
    fi

    # D2 + D7: backtick-quoted vault-relative paths inside the LIVE scope
    # (D3): AGENTS.md/CLAUDE.md, the threads file, Kurallar/Çekirdek,
    # companion.md and the newest session block of Son-Oturum. Günlük and
    # the sessions folder are historical memory -- free text, never scanned.
    # Candidates that cannot be vault-relative (~/, /, http, drive letters)
    # or that carry a glob/ellipsis are dropped; a missing target warns, an
    # existing target that git ignores gets the "breaks on clone" warning.
    _q_tokf=$(mktemp "${TMPDIR:-/tmp}/quipu-doctor-XXXXXX") || _q_tokf=
    if [ -n "$_q_tokf" ]; then
      trap 'rm -f "$_q_tokf" "$_q_tokf.u" "$_q_tokf.b" "$_q_tokf.d"' EXIT HUP INT TERM
      {
        for _q_f in "$_q_mv/AGENTS.md" "$_q_mv/CLAUDE.md"; do
          if [ -f "$_q_f" ]; then
            cat "$_q_f"
          fi
        done
        if [ -n "$_q_f_thr" ] && [ -f "$_q_f_thr" ]; then
          cat "$_q_f_thr"
        fi
        if [ -n "$_q_f_rul" ]; then
          cat "$_q_f_rul"
        fi
        if [ -n "$_q_f_cor" ]; then
          cat "$_q_f_cor"
        fi
        if [ -n "$_q_f_com" ]; then
          cat "$_q_f_com"
        fi
        if [ -n "$_q_f_ses" ] && [ -f "$_q_f_ses" ]; then
          # D3: only the newest session block is live -- from the last
          # "## " heading to EOF. A file with no "## " heading is live in
          # full (a single-block Son-Oturum is all present tense).
          awk '{ l[NR] = $0; if ($0 ~ /^## /) s = NR } END { for (i = (s ? s : 1); i <= NR; i++) print l[i] }' "$_q_f_ses"
        fi
      } > "$_q_tokf"
      awk '
        {
          n = split($0, seg, "`")
          for (i = 2; i <= n; i += 2) {
            p = seg[i]
            gsub(/^[ \t]+/, "", p)
            gsub(/[ \t]+$/, "", p)
            if (index(p, "/") == 0) continue
            c = substr(p, 1, 1)
            if (c == "~" || c == "/") continue
            if (index(p, "http://") == 1 || index(p, "https://") == 1) continue
            if (p ~ /^[A-Za-z]:/) continue
            if (index(p, "*") || index(p, "?") || index(p, "..") || index(p, "…")) continue
            # Not every backticked thing with a slash is a vault path. The
            # measured noise was commands, git branch names and repo slugs:
            # 33 of this vault'\''s 43 "missing" paths were those, and a virgin
            # vault reproduces it with three lines. Filter on shell shape
            # rather than on spaces -- vault folder names legitimately contain
            # spaces ("🔮 Asistan/Kurallar.md"), so a space test would blind
            # the check to exactly the paths it exists to catch.
            if (index(p, "|") || index(p, "&") || index(p, ";") \
                || index(p, "$") || index(p, "<") || index(p, ">") \
                || index(p, "(") || index(p, ")") \
                || index(p, "[") || index(p, "]") \
                || index(p, "=") || index(p, "→")) continue
            # A flag makes it a command line, not a path.
            if (index(p, " -")) continue
            # Quoting inside the candidate means it was a shell snippet.
            if (index(p, "\"") || index(p, "'\''")) continue
            if (seen[p]++) continue
            print p
          }
        }
      ' "$_q_tokf" > "$_q_tokf.u"
      _q_ingit=0
      if [ -n "$(command -v git)" ] && git -C "$_q_mv" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        _q_ingit=1
      fi
      _q_broken=0
      _q_ignrd=0
      : > "$_q_tokf.b"
      while IFS= read -r _q_tok; do
        if [ -z "$_q_tok" ]; then
          continue
        fi
        # A vault file followed by arguments (`./quipu context`) is a command
        # invocation, not a path. Keyed on the head existing as a regular
        # file, so a folder name with a space ("🔮 Asistan/x.md") never
        # matches: its head is not a file.
        case $_q_tok in
          *' '*)
            if [ -f "$_q_mv/${_q_tok%% *}" ]; then
              continue
            fi
            ;;
        esac
        if [ -e "$_q_mv/$_q_tok" ]; then
          if [ "$_q_ingit" -eq 1 ] && git -C "$_q_mv" check-ignore -q -- "$_q_tok"; then
            _q_ignrd=$((_q_ignrd + 1))
          fi
          continue
        fi
        # A bare folder name ("lib/") names a folder, not a location: it
        # resolves if a folder of that name exists anywhere in the vault. A
        # renamed folder exists nowhere and is still reported. The folder
        # list is built once, and only when such a name shows up.
        case $_q_tok in
          */*/*) ;;
          */)
            if [ ! -f "$_q_tokf.d" ]; then
              find "$_q_mv" -name .git -prune -o -type d -print 2>/dev/null \
                | sed 's|.*/||' | sort -u > "$_q_tokf.d"
            fi
            # LC_ALL=C: GNU grep 3.0 fails on multibyte/emoji patterns under UTF-8 locales
            if LC_ALL=C grep -qxF -- "${_q_tok%/}" "$_q_tokf.d"; then
              continue
            fi
            ;;
        esac
        _q_broken=$((_q_broken + 1))
        printf '%s\n' "$_q_tok" >> "$_q_tokf.b"
      done < "$_q_tokf.u"
      if [ "$_q_broken" -gt 0 ]; then
        _q_pfmt=$(_q_msg doc_paths_broken)
        # shellcheck disable=SC2059
        _q_line warn "$(_q_msg doc_paths)" "$(printf "$_q_pfmt" "$_q_broken")"
        # List what is missing, not only how many: one row per path with an
        # empty status column, so the warning total stays one per finding.
        while IFS= read -r _q_tok; do
          _q_line "" "$(_q_msg doc_paths)" "$_q_tok"
        done < "$_q_tokf.b"
      fi
      if [ "$_q_ignrd" -gt 0 ]; then
        _q_pfmt=$(_q_msg doc_paths_ignored)
        # shellcheck disable=SC2059
        _q_line warn "$(_q_msg doc_paths)" "$(printf "$_q_pfmt" "$_q_ignrd")"
      fi
    fi

    # D4: uncommitted memory. The whole safety net (capture --git, remember
    # --git, the pre-commit sır kapanı) assumes the vault lives under git;
    # memory that was edited but never committed has no net at all. Warn per
    # changed memory file; no git, or no repository, stays silent.
    if [ -n "$(command -v git)" ] && git -C "$_q_mv" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      _q_dirty=0
      for _q_f in "$_q_mv/AGENTS.md" "$_q_mv/CLAUDE.md" "$_q_f_thr" "$_q_f_ses" "$_q_f_rul" "$_q_f_cor" "$_q_f_jrn" "$_q_f_com"; do
        if [ -n "$_q_f" ] && [ -f "$_q_f" ]; then
          if [ -n "$(git -C "$_q_mv" status --porcelain -- "$_q_f" 2>/dev/null)" ]; then
            _q_dirty=$((_q_dirty + 1))
          fi
        fi
      done
      if [ "$_q_dirty" -gt 0 ]; then
        _q_dfmt=$(_q_msg doc_mem_dirty)
        # shellcheck disable=SC2059
        _q_line warn "$(_q_msg doc_mem)" "$(printf "$_q_dfmt" "$_q_dirty")"
      fi
    fi

    # D4b: parallel sessions and two machines append cards to the session
    # file; without merge=union a git merge of it conflicts. Git vaults only.
    if [ -n "$(command -v git)" ] && git -C "$_q_mv" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      && [ -n "$_q_f_ses" ] && [ -n "$(_q_union_missing "$_q_mv")" ]; then
      _q_line warn "$(_q_msg doc_mem)" "$(_q_msg doc_union_missing)"
    fi

    # D5: Son-Oturum freshness. A commit from today means the session moved;
    # if the newest session block does not mention today's date ANYWHERE in
    # the block -- the whole block, never just its heading: a block can open
    # the previous day and cross midnight -- the session pointer is stale.
    # No git, no commit from today, or no session file at all: silent.
    if [ -n "$(command -v git)" ] && git -C "$_q_mv" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      _q_today=$(date +%Y-%m-%d)
      _q_lastc=$(git -C "$_q_mv" log -1 --format=%cs 2>/dev/null || true)
      if [ "$_q_lastc" = "$_q_today" ] && [ -n "$_q_f_ses" ] && [ -f "$_q_f_ses" ]; then
        if ! awk -v d="$_q_today" '{ l[NR] = $0; if ($0 ~ /^## /) s = NR } END { for (i = (s ? s : 1); i <= NR; i++) if (index(l[i], d)) f = 1; exit !f }' "$_q_f_ses"; then
          _q_sfmt=$(_q_msg doc_session_stale)
          # shellcheck disable=SC2059
          _q_line warn "$(_q_msg doc_session)" "$(printf "$_q_sfmt" "$_q_today")"
        fi
      fi
    fi

    # D8: companion size. The last-session file and the journal only grow;
    # above companion_max= (config, default 40000 bytes) doctor warns. A
    # missing file or a non-numeric config value falls back / stays silent.
    _q_cmx=
    if [ -f "$_q_mv/$_q_SD/config" ]; then
      _q_cmx=$(awk -F= -v k=companion_max '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_mv/$_q_SD/config" 2>/dev/null || true)
    fi
    case "$_q_cmx" in
      ''|*[!0-9]*|0) _q_cmx=40000 ;;
    esac
    if [ -n "$_q_f_ses" ] && [ -f "$_q_f_ses" ]; then
      _q_cmsz=$(wc -c < "$_q_f_ses" | tr -d ' ')
      if [ "$_q_cmsz" -gt "$_q_cmx" ]; then
        _q_cmfmt=$(_q_msg doc_companion_big_session)
        # shellcheck disable=SC2059
        _q_line warn "$(_q_msg doc_companion_big)" "$(printf "$_q_cmfmt" "${_q_f_ses##*/}" "$_q_cmsz" "$_q_cmx")"
      fi
    fi
    if [ -n "$_q_f_jrn" ] && [ -f "$_q_f_jrn" ]; then
      _q_cmsz=$(wc -c < "$_q_f_jrn" | tr -d ' ')
      if [ "$_q_cmsz" -gt "$_q_cmx" ]; then
        _q_cmfmt=$(_q_msg doc_companion_big_journal)
        # shellcheck disable=SC2059
        _q_line warn "$(_q_msg doc_companion_big)" "$(printf "$_q_cmfmt" "${_q_f_jrn##*/}" "$_q_cmsz" "$_q_cmx")"
      fi
    fi

    # D6: reflection nudge. Today's activity.log holds more events than
    # note_nudge_events= (default 50; 0 turns the check off; a non-number
    # falls back to 50) while today's session reflection block is empty or
    # the day's session file does not exist: the work of the day is not
    # written down yet. Silent otherwise. Event count = log lines that start
    # with today's date; the layout's sessions folder is resolved exactly as
    # `quipu note` resolves it (unknown layout -> emoji).
    _q_nn=
    if [ -f "$_q_mv/$_q_SD/config" ]; then
      _q_nn=$(awk -F= -v k=note_nudge_events '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_mv/$_q_SD/config" 2>/dev/null || true)
    fi
    case "$_q_nn" in
      ''|*[!0-9]*) _q_nn=50 ;;
    esac
    if [ "$_q_nn" -gt 0 ]; then
      _q_nd=$(date +%Y-%m-%d)
      _q_nev=0
      if [ -f "$_q_mv/$_q_SD/activity.log" ]; then
        _q_nev=$(awk -v d="$_q_nd" 'index($0, d) == 1 { n++ } END { print n + 0 }' "$_q_mv/$_q_SD/activity.log")
      fi
      if [ "$_q_nev" -gt "$_q_nn" ]; then
        _q_nlay=${_q_mlay:-}
        _q_layout_ok "$_q_nlay" || _q_nlay=emoji
        _q_tab=$(printf '\t')
        _q_nsess=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_nlay.txt" 2>/dev/null || true)
        _q_reflect_filled "$_q_mv/$_q_nsess/$_q_nd.md"
        if [ "$_q_rf" -eq 0 ]; then
          _q_nfmt=$(_q_msg doc_reflect_unwritten)
          # shellcheck disable=SC2059
          _q_line warn "$(_q_msg doc_reflect_name)" "$(printf "$_q_nfmt" "$_q_nev")"
        fi
      fi
    fi
  fi
  _q_msg doc_sec_agents
  # C-28 fix: quipu install (>=v2.1.3) writes the Claude Code hook
  # vault-local, to <vault>/.claude/settings.json, not the global
  # $HOME/.claude/settings.json this check used to look at exclusively --
  # so a correctly installed vault was reported as "not installed" (the
  # very next thing a fresh install tells the user to run). Check
  # vault-local first, then fall back to global, and say which one was
  # found. _q_v was last set by the vault section above (line ~374) but
  # every _q_msg call since then (doc_sec_agents included) clobbers it as
  # scratch space, so re-derive it here; _q_vault has no side effects and
  # is safe to call again. A checkout with no ancestor .quipu/config (e.g.
  # doctor run from inside the quipu repo itself) makes _q_vault return
  # empty, which the guard below treats the same as "no vault".
  _q_v=$(_q_vault)
  if [ -n "$_q_v" ] && [ -e "$_q_v/.claude/settings.json" ] && grep -qE 'knotlog|quipu' "$_q_v/.claude/settings.json"; then
    _q_line ok 'claude hooks' "$(_q_msg doc_hooks_installed_vault)"
  elif [ -e "$HOME/.claude/settings.json" ] && grep -qE 'knotlog|quipu' "$HOME/.claude/settings.json"; then
    _q_line ok 'claude hooks' "$(_q_msg doc_hooks_installed)"
  else
    _q_line warn 'claude hooks' "$(_q_msg doc_hooks_missing)"
  fi
  # The old check printed "ok codex $HOME/.codex/config.toml" whenever that
  # file existed -- which only proves Codex is installed, not that quipu is
  # wired into it. Measured 2026-09-03: a machine with Codex installed, no
  # hooks.json anywhere and zero memory reaching Codex still got a green
  # "ok codex" row. The check has to look at the adapter, not the runtime.
  # Trust cannot be read from disk (it lives in Codex's own state), so the
  # ok row carries the reminder instead of asserting the hooks will fire.
  if [ -e "$HOME/.codex/config.toml" ] || [ -d "$HOME/.codex" ]; then
    # Re-derive: every _q_msg call above clobbers _q_v as scratch space.
    _q_v=$(_q_vault)
    _q_cxh=''
    if [ -n "$_q_v" ] && [ -e "$_q_v/.codex/hooks.json" ]; then
      _q_cxh="$_q_v/.codex/hooks.json"
    elif [ -e "$HOME/.codex/hooks.json" ]; then
      _q_cxh="$HOME/.codex/hooks.json"
    fi
    if [ -z "$_q_cxh" ]; then
      _q_line warn codex "$(_q_msg doc_codex_no_hooks)"
    elif grep -qE 'knotlog|quipu' "$_q_cxh"; then
      _q_line ok codex "$_q_cxh -- $(_q_msg doc_codex_hooks)"
    else
      _q_line warn codex "$_q_cxh -- $(_q_msg doc_codex_foreign)"
    fi
  fi
  if [ -e "./opencode.json" ]; then
    _q_line ok opencode "./opencode.json"
  elif [ -e "./.opencode" ]; then
    _q_line ok opencode "./.opencode"
  fi
  if [ -e "./cursor-hooks/hooks.json" ]; then
    _q_line ok cursor "./cursor-hooks/hooks.json"
  fi
  if [ -e "./.devin" ]; then
    _q_line ok windsurf "./.devin"
  elif [ -e "./.windsurf" ]; then
    _q_line ok windsurf "./.windsurf"
  fi

  _q_msg doc_sec_warn
  _q_lay=${_q_lay:-}
  _q_v=$(_q_vault)
  # PLAN 4.9: the emoji-folder risk applies when the active layout uses
  # emoji folder names (emoji and the localized language tables), and also
  # when no layout is resolved yet - the next `init` defaults to emoji.
  _q_lay_emoji=0
  if [ -z "$_q_lay" ] || { [ "$_q_lay" != plain ] && _q_layout_ok "$_q_lay"; }; then
    _q_lay_emoji=1
  fi
  if [ "$_q_lay" != plain ]; then
    case "$_q_HOME" in
      *OneDrive*) _q_line warn path "$(_q_msg doc_onedrive)" ;;
    esac
  fi
  if [ "$_q_lay_emoji" -eq 1 ]; then
    case "$_q_v" in
      *OneDrive*) _q_line warn vault "$(_q_msg doc_onedrive_vault)" ;;
    esac
  fi
  if awk 'index($0, sprintf("%c",13)) != 0 {c=1} END{exit !c}' "$0" 2>/dev/null; then
    _q_line warn eol "$(_q_msg doc_crlf)"
  fi
  _q_lc=${LC_ALL:-${LANG:-}}
  if [ -n "$_q_lc" ]; then
    case "$_q_lc" in
      *UTF-8*|*utf-8*|C|POSIX) : ;;
      *) _q_line warn locale "$(_q_msg doc_locale)" ;;
    esac
  fi

  # B11: plans outside the vault. A plan file under a known tool location
  # (today: ~/.claude/plans/) is memory living outside memory -- not in
  # git, invisible to the hooks, unreachable from the bridge. This is the
  # exact 2026-09-02 incident that produced the `plan` command: a plan
  # written under ~/.claude/plans/ could not be inherited by the next
  # session. Warn once per known location that holds *.md files; stays
  # silent when the location is empty, absent, or sits INSIDE the vault
  # (a vault rooted at $HOME legitimately contains it). Never fails.
  _q_plans_home=${HOME:-}
  if [ -n "$_q_plans_home" ]; then
    _q_plans_loc="$_q_plans_home/.claude/plans"
    if [ -d "$_q_plans_loc" ]; then
      _q_plans_skip=0
      _q_plans_v=$(_q_vault)
      if [ -n "$_q_plans_v" ]; then
        case "$_q_plans_loc" in
          "$_q_plans_v"|"$_q_plans_v"/*) _q_plans_skip=1 ;;
        esac
      fi
      if [ "$_q_plans_skip" -eq 0 ]; then
        _q_plans_n=0
        for _q_plans_f in "$_q_plans_loc"/*.md; do
          [ -f "$_q_plans_f" ] && _q_plans_n=$((_q_plans_n + 1))
        done
        if [ "$_q_plans_n" -gt 0 ]; then
          _q_plans_fmt=$(_q_msg doc_plans_outside)
          # shellcheck disable=SC2059
          _q_line warn plans "$(printf "$_q_plans_fmt" "$_q_plans_loc" "$_q_plans_n")"
        fi
      fi
    fi
  fi

  # Update (G3): a staging directory left behind by a `quipu update --apply`
  # that was interrupted before the atomic swap (_q_update_apply_tarball) --
  # unconditional on $_q_HOME, independent of the vault sections above, so
  # this fires even for a vault-less checkout. A stale staging dir must be
  # reported, never silently reused or ignored on the next run (bitiş
  # tanımı #3) -- warn rather than fail: the checkout itself is untouched at
  # this point, only the staging area needs attention. _q_update_paths sets
  # $_q_up_staging -- reused here rather than recomputed, so doctor and
  # update can never disagree on where a staging dir would live.
  _q_update_paths
  if [ -e "$_q_up_staging" ]; then
    _q_usfmt=$(_q_msg doc_update_staging_stale)
    # shellcheck disable=SC2059
    _q_line warn update "$(printf "$_q_usfmt" "$_q_up_staging")"
  fi

  _q_fmt=$(_q_msg doc_summary)
  # doc_summary carries %d placeholders resolved by printf below; the format
  # string comes from i18n, so it must be used as the printf format directly.
  # shellcheck disable=SC2059
  printf "$_q_fmt" "$OK" "$WARN" "$FAIL"
  printf '\n'
  if [ "$FAIL" -gt 0 ]; then
    exit 1
  fi
  exit 0
}

# ---- capture ----------------------------------------------------------------

# Normalize one path held in $_q_p (Windows drive-letter -> POSIX via cygpath
# when the result lives inside the vault; vault-relative strip; TAB/CR/LF
# removal). Caller sets $_q_p and $_q_v first.
_q_norm_path() {
  case "$_q_p" in
    [A-Za-z]:*)
      if command -v cygpath >/dev/null 2>&1; then
        _q_orig=$_q_p
        _q_p=$(cygpath -u "$_q_p" 2>/dev/null || printf '%s\n' "$_q_p")
        case "$_q_p" in
          "$_q_v"/*) : ;;
          *) _q_p=$_q_orig ;;
        esac
      fi
      ;;
  esac
  # Make it vault-relative when inside the vault, then strip TAB/CR/LF.
  _q_p=${_q_p#"$_q_v"/}
  _q_tab=$(printf '\t')
  _q_p=$(printf '%s\n' "$_q_p" | tr -d "$_q_tab$(printf '\r\n')")
}

# Rotate activity.log once: mv to .1 and open a fresh file when over limit.
# Caller sets $_q_v first; this sets $_q_log.
_q_rotate_log() {
  _q_log="$_q_v/$_q_SD/activity.log"
  if [ -f "$_q_log" ]; then
    _q_size=$(wc -c < "$_q_log")
    if [ "$_q_size" -gt "${QUIPU_LOG_MAX:-262144}" ]; then
      mv -f "$_q_log" "$_q_log.1"
      : > "$_q_log"
    fi
  fi
}

# B-K4 (b): true when $1 is a scratch/temp path that will be meaningless
# next session (a screenshot dropped in /tmp, an agent scratchpad dir).
# Only fires on paths that are STILL absolute after _q_norm_path has run:
# _q_norm_path already strips the vault's own prefix ("$_q_v"/) before this
# is ever consulted, so a vault that itself lives under /tmp (every test
# vault in this suite does: tests/run.sh's $TMP is under $TMPDIR/tmp) never
# gets its own files caught here -- they arrived already vault-relative,
# with no leading "/". A path that is STILL absolute at this point is, by
# construction, outside the vault, and is checked against /tmp, $TMPDIR
# (when set, trailing slash trimmed so both "/x" and "/x/" match the same
# way), and any path with a "scratchpad" path segment (covers agent
# scratchpad dirs that don't happen to sit under /tmp or $TMPDIR).
_q_is_tmp_path() {
  case "$1" in
    /*) : ;;
    *) return 1 ;;
  esac
  case "$1" in
    /tmp|/tmp/*) return 0 ;;
    */scratchpad|*/scratchpad/*) return 0 ;;
  esac
  if [ -n "${TMPDIR:-}" ]; then
    _q_itp_td=${TMPDIR%/}
    case "$1" in
      "$_q_itp_td"|"$_q_itp_td"/*) return 0 ;;
    esac
  fi
  return 1
}

# Append one row (already normalized) to activity.log. Caller sets $_q_ev,
# $_q_tool, $_q_p and has run _q_rotate_log (which sets $_q_log). B-K4 (b):
# silently drops a row whose (already vault-relativized) path is still an
# absolute temp/scratchpad path -- meaningless in a future session, and the
# repeated driver of the fixed-part budget overflow B-K4 (a) caps.
_q_append_line() {
  if _q_is_tmp_path "$_q_p"; then
    return 0
  fi
  printf '%s | %s | %s | %s\n' "$(date +%Y-%m-%dT%H:%M)" "$_q_ev" "$_q_tool" "$_q_p" >> "$_q_log"
}

_q_cmd_capture() {
  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  _q_ev=
  _q_tool=
  _q_p=
  _q_flag=0
  _q_git=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --git) _q_git=1; shift ;;
      --event) _q_flag=1; [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_ev=$2; shift 2 ;;
      --tool)  _q_flag=1; [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_tool=$2; shift 2 ;;
      --path)  _q_flag=1; [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_p=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  if [ "$_q_git" -eq 1 ] && [ "$_q_flag" -eq 1 ]; then
    _q_die err_conflict 2
  fi

  # Flag-mode mandatory args: checked before any subshell that reuses _q_p.
  if [ "$_q_flag" -eq 1 ]; then
    if [ -z "$_q_ev" ] || [ -z "$_q_tool" ] || [ -z "$_q_p" ]; then
      _q_die err_missing_arg 2
    fi
  fi

  if [ "$_q_git" -eq 1 ]; then
    # H-2: silent no-op when git is missing or the vault is not a repo.
    if ! command -v git >/dev/null 2>&1 || ! (cd "$_q_v" && git rev-parse --git-dir >/dev/null 2>&1); then
      exit 0
    fi
    # H-3 + DZ-2: changed tracked files only when HEAD exists; an unborn HEAD
    # would make `git diff --name-only HEAD` exit 128 and trip `set -eu`.
    if (cd "$_q_v" && git rev-parse --verify --quiet HEAD >/dev/null 2>&1); then
      _q_ch=$( (cd "$_q_v" && git diff --name-only HEAD 2>/dev/null) )
    else
      _q_ch=""
    fi
    _q_un=$( (cd "$_q_v" && git ls-files --others --exclude-standard 2>/dev/null) )
    # H-4 + DZ-3: single .md filter (stdin -> stdout).
    _q_md=$( { printf '%s\n' "$_q_ch"; printf '%s\n' "$_q_un"; } | _q_md_filter )
    # H-8: nothing changed -> silent success (H-7: stdout stays empty).
    [ -n "$_q_md" ] || exit 0
    # H-6: rotate once before the loop; H-5: shared per-line functions.
    _q_ev=gitdiff
    _q_tool=git
    _q_rotate_log
    printf '%s\n' "$_q_md" | while IFS= read -r _q_ln; do
      [ -n "$_q_ln" ] || continue
      _q_p=$_q_ln
      _q_norm_path
      _q_append_line
    done
    exit 0
  fi

  if [ "$_q_flag" -eq 0 ]; then
    _q_tab=$(printf '\t')
    _q_out=$(head -c "${QUIPU_MAX_STDIN:-65536}" | awk -f "$_q_HOME/lib/jsonfield.awk" -f "$_q_HOME/lib/capture.awk")
    if [ -z "$_q_out" ]; then
      exit 0
    fi
  fi

  # Rotate once, before any append: a multi-row capture must never rotate
  # mid-loop (earlier rows would be moved into activity.log.1 and lost).
  _q_rotate_log

  if [ "$_q_flag" -eq 1 ]; then
    _q_norm_path
    _q_append_line
  else
    # capture.awk may emit zero or many rows. Parameter expansion only: a
    # heredoc would re-expand $ and backticks inside the path (corruption).
    printf '%s\n' "$_q_out" | while IFS= read -r _q_ln; do
      _q_ev=${_q_ln%%"$_q_tab"*}
      _q_rest=${_q_ln#*"$_q_tab"}
      _q_tool=${_q_rest%%"$_q_tab"*}
      _q_p=${_q_rest#*"$_q_tab"}
      if [ -z "$_q_ev" ] || [ -z "$_q_tool" ] || [ -z "$_q_p" ]; then
        continue
      fi
      _q_norm_path
      _q_append_line
    done
  fi
}

# ---- init -------------------------------------------------------------------

_q_scope_has() {
  case ",$_q_scope_list," in
    *,"$1",*) return 0 ;;
    *) return 1 ;;
  esac
}

_q_scope_add() {
  if ! _q_scope_has "$1"; then
    if [ -n "$_q_scope_list" ]; then
      _q_scope_list="$_q_scope_list,$1"
    else
      _q_scope_list=$1
    fi
  fi
}

_q_secret_hooks_setup() {
  # B1 sır kapanı: kasa bir git deposu köküyse .githooks/pre-commit kur ve
  # core.hooksPath=.githooks ayarla. Sonuç _q_hooks_state'e yazılır; yazdırma
  # _q_hooks_report'a aittir (QUIPU_HOOK modunda init zaten hiçbir şey
  # basmaz). Sadece kasa kökündeki .git sayılır: kasa daha büyük bir deponun
  # alt klasörüyse core.hooksPath yabancı depoya yazılmaz, hiçbir şey
  # yapılmaz. Elle düzenlenmiş (knotlog:secret-scan ya da eski quipu:secret-scan imzası taşımayan) bir
  # pre-commit asla ezilmez; hooksPath'e de dokunulmaz.
  _q_sh_v=$1
  _q_hooks_state=none
  _q_sh_hook="$_q_sh_v/.githooks/pre-commit"
  _q_sh_src="$_q_HOME/hooks/pre-commit"
  [ -f "$_q_sh_src" ] || return 0
  [ -e "$_q_sh_v/.git" ] || return 0
  if [ -f "$_q_sh_hook" ] && ! grep -Eq '(knotlog|quipu):secret-scan' "$_q_sh_hook"; then
    _q_hooks_state=kept
    return 0
  fi
  mkdir -p "$_q_sh_v/.githooks"
  _q_hooks_state=installed
  if [ -f "$_q_sh_hook" ] && cmp -s "$_q_sh_hook" "$_q_sh_src"; then
    _q_hooks_state=current
  else
    if ! cp -- "$_q_sh_src" "$_q_sh_hook"; then
      _q_hooks_state=none
      return 0
    fi
    chmod +x "$_q_sh_hook"
  fi
  # git -C yok (Git for Windows POSIX yol argümanlarını yanlış çözer);
  # init'in kendi git init'iyle aynı alt kabuk + cd deseni.
  if ! (cd "$_q_sh_v" && git config core.hooksPath .githooks) 2>/dev/null; then
    _q_hooks_state=none
  fi
  return 0
}

_q_hooks_report() {
  # B1 kurulum sonucunu kullanıcının dilinde tek satırla raporlar.
  case "$_q_hooks_state" in
    installed) _q_msg hooks_installed ;;
    current) _q_msg hooks_current ;;
    kept) _q_warn hooks_kept ;;
    *) _q_msg hooks_none ;;
  esac
}

_q_cmd_init() {
  # shellcheck disable=SC2031 # _q_bridge_refresh sets it only inside its own subshell
  _q_v=${QUIPU_VAULT:-$PWD}
  _q_SD=$(_q_sd_of "$_q_v")
  # Keep the vault path in a name the message helpers cannot touch. _q_msg and
  # _q_lang used to scribble on plain `_q_v` and the baseline commit tried to
  # `cd` into a translated sentence; their scratch names are prefixed now, and
  # this copy keeps init independent of that staying true.
  _q_init_v=$_q_v
  _q_lang=
  _q_git=0
  _q_plain=0
  _q_lay_req=
  _q_scope_req=
  _q_scope_list=
  _q_user=
  _q_cn=
  _q_purpose=
  _q_tone_req=
  _q_flair_req=
  _q_noprompt=0
  _q_purpose_new=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --plain) _q_plain=1; shift ;;
      --git) _q_git=1; shift ;;
      --scope)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          core|goals|money|body|mind|full) _q_scope_req="$_q_scope_req $2" ;;
          *) _q_die err_scope_unknown 2 "$2" ;;
        esac
        shift 2
        ;;
      --layout) [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        # Validate against the shipped layout table at parse time, before
        # any filesystem mutation (same fail-early style as the other
        # value flags). Only files that ship a folder tree qualify.
        if [ ! -f "$_q_HOME/layout/$2.txt" ] || [ "$2" = status ]; then
          _q_die err_layout_flag_unknown 2 "$2"
        fi
        _q_lay_req=$2; shift 2 ;;
      --no-prompt) _q_noprompt=1; shift ;;
      --lang) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_lang=$2; shift 2 ;;
      --user) [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        _q_user=$2; shift 2 ;;
      --companion) [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        _q_cn=$2; shift 2 ;;
      --purpose) [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        _q_purpose=$2; shift 2 ;;
      --tone) [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          varsayilan|profesyonel|dostane|icten|siradisi|etkili|sivridilli|ogretici|kaomoji) : ;;
          *) _q_die err_tone_unknown 2 "$2" ;;
        esac
        _q_tone_req=$2; shift 2 ;;
      --flair) [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          none|kaomoji|emoji) : ;;
          *) _q_die err_flair_unknown 2 "$2" ;;
        esac
        _q_flair_req=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  _q_changed=0

  mkdir -p "$_q_v/$_q_SD"

  if [ ! -f "$_q_v/$_q_SD/config" ]; then
    : > "$_q_v/$_q_SD/config"
    _q_changed=1
  fi

  # Layout resolution (FAZ 2 spec 4.1): an existing config value wins; a
  # conflicting --plain or --layout flag is a hard error before anything is
  # written. The known set grew with the localized number-free layouts
  # (tr/en); emoji/plain keep their exact previous semantics.
  _q_cfg=
  if [ -f "$_q_v/$_q_SD/config" ]; then
    _q_cfg=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  fi
  if [ -n "$_q_cfg" ]; then
    _q_layout_ok "$_q_cfg" || _q_die err_layout_unknown 2
    if [ "$_q_plain" -eq 1 ] && [ "$_q_cfg" = emoji ]; then
      _q_die err_layout_conflict 2
    fi
    if [ -n "$_q_lay_req" ] && [ "$_q_lay_req" != "$_q_cfg" ]; then
      _q_die err_layout_flag_conflict 2 "$_q_lay_req" "$_q_cfg"
    fi
    _q_layout=$_q_cfg
  else
    if [ "$_q_plain" -eq 1 ]; then
      # --plain is the historical ASCII spelling of layout plain; an
      # explicit --layout plain means the same thing, anything else
      # conflicts with it.
      if [ -n "$_q_lay_req" ] && [ "$_q_lay_req" != plain ]; then
        _q_die err_layout_flag_conflict 2 "$_q_lay_req" plain
      fi
      _q_layout=plain
    elif [ -n "$_q_lay_req" ]; then
      _q_layout=$_q_lay_req
    else
      _q_layout=emoji
    fi
    printf 'layout=%s\n' "$_q_layout" >> "$_q_v/$_q_SD/config"
    _q_changed=1
  fi
  # Scopes are additive: init never removes an existing scope. The config
  # stores a comma-separated set so repeated `init --scope` calls are stable.
  _q_scope_cfg=$(awk -F= '$1=="scope"{print $2;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  _q_scope_list=$_q_scope_cfg
  for _q_scope in $(printf '%s\n' "$_q_scope_cfg" | tr ',' ' '); do
    case "$_q_scope" in
      ''|core|goals|money|body|mind|full) : ;;
      *) _q_die err_scope_unknown 2 "$_q_scope" ;;
    esac
  done
  for _q_scope in $_q_scope_req; do
    _q_scope_add "$_q_scope"
  done
  if [ "$_q_scope_list" != "$_q_scope_cfg" ]; then
    if grep -q '^scope=' "$_q_v/$_q_SD/config"; then
      sed "s/^scope=.*/scope=$_q_scope_list/" "$_q_v/$_q_SD/config" > "$_q_v/$_q_SD/config.tmp" && mv "$_q_v/$_q_SD/config.tmp" "$_q_v/$_q_SD/config"
    else
      printf 'scope=%s\n' "$_q_scope_list" >> "$_q_v/$_q_SD/config"
    fi
    _q_changed=1
  fi


  if [ -n "$_q_lang" ]; then
    if grep -q '^lang=' "$_q_v/$_q_SD/config"; then
      sed "s/^lang=.*/lang=$_q_lang/" "$_q_v/$_q_SD/config" > "$_q_v/$_q_SD/config.tmp" && mv "$_q_v/$_q_SD/config.tmp" "$_q_v/$_q_SD/config"
    else
      printf 'lang=%s\n' "$_q_lang" >> "$_q_v/$_q_SD/config"
    fi
    _q_changed=1
  fi

  # Fold profile (V1-DUZELTME R-1/R-2): derived ONCE and pinned to the config.
  # Written only when the line is absent — an existing fold= is NEVER
  # overwritten, unlike lang= above. Rationale: changing the profile
  # invalidates the whole index, and the user may have hand-written a value
  # (e.g. fold=latin). To change it: edit the config, then run `index --full`.
  if ! grep -q '^fold=' "$_q_v/$_q_SD/config"; then
    _q_fold=$(_q_fold_for_lang)
    printf 'fold=%s\n' "$_q_fold" >> "$_q_v/$_q_SD/config"
    _q_changed=1
  fi

  # Interactivity gate (FAZ 15 AB-1): --no-prompt and QUIPU_HOOK ALWAYS win —
  # a hook invocation or an explicit --no-prompt closes the gate before the
  # tty check even runs. QUIPU_FORCE_TTY (test-only; never added to README's
  # env-knob list, AB-2 — there is no portable pty across the three CI OSes)
  # substitutes for `[ -t 0 ]` only when neither of those two already closed
  # it, so a test can force the interactive path over a piped stdin without
  # ever being able to override hook-safety.
  _q_interactive=0
  if [ "$_q_noprompt" -eq 0 ] && [ "${QUIPU_HOOK:-0}" != 1 ]; then
    if [ -t 0 ] || [ "${QUIPU_FORCE_TTY:-0}" = 1 ]; then
      _q_interactive=1
    fi
  fi

  # Two questions (wizard UX round 2): companion -> user, each asked
  # INDEPENDENTLY, only when NOT given by flag AND NOT already in the
  # config -- the exact condition the write blocks below re-check anyway, so
  # asking early never desyncs from what actually gets written. A field that
  # is not asked never calls `read`, so a skipped question never eats the
  # stdin line meant for the next one (AB-6/T-224). The old purpose question
  # left the interactive flow on a maintainer decision (2026-09-02): --purpose
  # and purpose= config stay, the question is never asked. --tone (2026-09-05)
  # follows the same precedent for the same reason: a picker over the tone
  # presets is a separate feature, and an unasked question that
  # defaults to companion.md's existing Tone section is never a silent
  # failure (the fallback IS the pre-preset behavior). --tone/tone= exist
  # for scripted use (install --tone, --no-prompt, QUIPU_HOOK).
  if [ "$_q_interactive" -eq 1 ]; then
    _q_ask_cn=0
    if [ -z "$_q_cn" ] && ! grep -q '^companion=' "$_q_v/$_q_SD/config"; then
      _q_ask_cn=1
    fi
    _q_ask_user=0
    if [ -z "$_q_user" ] && ! grep -q '^user=' "$_q_v/$_q_SD/config"; then
      _q_ask_user=1
    fi
    if [ "$_q_ask_cn" -eq 1 ] || [ "$_q_ask_user" -eq 1 ]; then
      # NOT a bare `_q_msg` call: _q_msg's own body assigns _q_v/_q_f
      # internally (no `local`, forbidden project-wide), and _q_v here is
      # _q_cmd_init's vault path, still needed below. printf/$( ) keeps the
      # assignment inside a subshell so it never clobbers the caller's _q_v.
      printf '%s\n' "$(_q_msg init_ask_head)"
    fi

    # Blank answer (bare Enter) leaves the var untouched -- the write block's
    # own `-n` guard skips it, no separate check needed here (AB-6). `read`'s
    # EOF exit status is caught by `|| _q_ans=` so `set -eu` never kills the
    # script on a short/closed pipe.
    if [ "$_q_ask_cn" -eq 1 ]; then
      printf '%s' "$(_q_msg init_ask_companion)"
      IFS= read -r _q_ans || _q_ans=
      [ -n "$_q_ans" ] && _q_cn=$_q_ans
    fi
    if [ "$_q_ask_user" -eq 1 ]; then
      printf '%s' "$(_q_msg init_ask_user)"
      IFS= read -r _q_ans || _q_ans=
      [ -n "$_q_ans" ] && _q_user=$_q_ans
    fi
  fi

  # Identity (FAZ 9 V-2): user=/companion= written only when the line is
  # absent; an existing value is never overwritten (layout= pattern).
  if [ -n "$_q_user" ] && ! grep -q '^user=' "$_q_v/$_q_SD/config"; then
    printf 'user=%s\n' "$_q_user" >> "$_q_v/$_q_SD/config"
    _q_changed=1
  fi
  if [ -n "$_q_cn" ] && ! grep -q '^companion=' "$_q_v/$_q_SD/config"; then
    printf 'companion=%s\n' "$_q_cn" >> "$_q_v/$_q_SD/config"
    _q_changed=1
  fi

  # purpose= (FAZ 15 AB-7): fold=/user=/companion= pattern -- written only
  # when the line is absent, an existing value is never overwritten. Unlike
  # lang=, there is no "always overwrite" exception here.
  if [ -n "$_q_purpose" ] && ! grep -q '^purpose=' "$_q_v/$_q_SD/config"; then
    printf 'purpose=%s\n' "$_q_purpose" >> "$_q_v/$_q_SD/config"
    _q_changed=1
    _q_purpose_new=1
  fi

  # --tone (init writes only; no interactive question, same call as purpose=
  # -- see the note at the interactivity gate below): fold=/user=/companion=
  # pattern, written only when the line is absent, an existing value is
  # never overwritten. install's --no-prompt path calls init with this flag
  # (quipu install --tone <slug>), so a preset chosen at install time still
  # needs a way to reach init without a live question.
  if [ -n "$_q_tone_req" ] && ! grep -q '^tone=' "$_q_v/$_q_SD/config"; then
    printf 'tone=%s\n' "$_q_tone_req" >> "$_q_v/$_q_SD/config"
    _q_changed=1
  fi
  if [ -n "$_q_flair_req" ] && ! grep -q '^flair=' "$_q_v/$_q_SD/config"; then
    printf 'flair=%s\n' "$_q_flair_req" >> "$_q_v/$_q_SD/config"
    _q_changed=1
  fi

  # Effective identity (V-2/V-3/V-4): config wins (never overwritten), then
  # the flags, then the i18n neutral defaults. Used for the companion.md seed
  # and the AGENTS.md bridge body.
  _q_cn_eff=$(awk -F= -v k=companion '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  _q_us_eff=$(awk -F= -v k=user '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  [ -n "$_q_cn_eff" ] || _q_cn_eff=${_q_cn:-$(_q_msg persona_default_companion)}
  [ -n "$_q_us_eff" ] || _q_us_eff=${_q_user:-$(_q_msg persona_default_user)}

  # purpose= has NO i18n neutral fallback (FAZ 15 AB-8) -- unlike companion/
  # user, the AGENTS.md bridge line for it is conditional (AB-9): no value
  # means no line, never an invented "no purpose set" placeholder.
  _q_purpose_eff=$(awk -F= -v k=purpose '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)

  if [ ! -f "$_q_v/$_q_SD/index.tsv" ]; then
    : > "$_q_v/$_q_SD/index.tsv"
    _q_changed=1
  fi

  if [ ! -f "$_q_v/$_q_SD/activity.log" ]; then
    : > "$_q_v/$_q_SD/activity.log"
    _q_changed=1
  fi

  if [ "$_q_git" -eq 1 ]; then
    # Native Git for Windows misparses POSIX path arguments (/tmp/...), so
    # init the vault by entering it with the shell builtin instead of passing
    # a path argument; the subshell keeps the caller's cwd untouched and the
    # && chain propagates cd/git failure under set -e.
    (cd "$_q_v" && git init -q)
    _q_changed=1
  fi

  # Folder tree: names come from layout/<layout>.txt (spec 2.1, B-3/B-10).
  _q_tab=$(printf '\t')
  while IFS= read -r _q_ln; do
    [ -n "$_q_ln" ] || continue
    case "$_q_ln" in
      '#'*) continue ;;
    esac
    _q_name=${_q_ln#*"$_q_tab"}
    [ "$_q_name" = "$_q_ln" ] && continue
    mkdir -p "$_q_v/$_q_name"
    if [ ! -f "$_q_v/$_q_name/.gitkeep" ]; then
      : > "$_q_v/$_q_name/.gitkeep"
    fi
  done < "$_q_HOME/layout/$_q_layout.txt"
  # Optional scope folders are additive and data-driven. `full` expands to all
  # four definitions; `core` intentionally adds none.
  _q_scope_lang=$_q_layout
  [ -f "$_q_HOME/layout/scope-$_q_scope_lang.txt" ] || _q_scope_lang=en
  for _q_scope in goals money body mind; do
    if _q_scope_has full || _q_scope_has "$_q_scope"; then
      _q_scope_name=$(awk -F"$_q_tab" -v k="$_q_scope" '$1==k{print $2;exit}' "$_q_HOME/layout/scope-$_q_scope_lang.txt")
      [ -n "$_q_scope_name" ] || _q_die err_scope_unknown 2 "$_q_scope"
      mkdir -p "$_q_v/$_q_scope_name"
      if [ ! -f "$_q_v/$_q_scope_name/.gitkeep" ]; then
        : > "$_q_v/$_q_scope_name/.gitkeep"
      fi
    fi
  done


  # Companion, command-center, templates, inbox and projects folder names
  # (seeds + bridge body).
  _q_cname=
  _q_dname=
  _q_tname=
  _q_iname=
  _q_pn=
  while IFS= read -r _q_ln; do
    [ -n "$_q_ln" ] || continue
    case "$_q_ln" in
      '#'*) continue ;;
    esac
    _q_slug=${_q_ln%%"$_q_tab"*}
    [ "$_q_slug" = companion ] && _q_cname=${_q_ln#*"$_q_tab"}
    [ "$_q_slug" = command ] && _q_dname=${_q_ln#*"$_q_tab"}
    [ "$_q_slug" = templates ] && _q_tname=${_q_ln#*"$_q_tab"}
    [ "$_q_slug" = inbox ] && _q_iname=${_q_ln#*"$_q_tab"}
    [ "$_q_slug" = projects ] && _q_pn=${_q_ln#*"$_q_tab"}
  done < "$_q_HOME/layout/$_q_layout.txt"

  # Seeds: only-if-missing, never touched again (spec 4.2, B-9).
  _q_comp=0
  _q_rules=0
  _q_facts=0
  if [ -n "$_q_cname" ]; then
    _q_pers=$(_q_lang)
    if [ ! -f "$_q_HOME/persona/$_q_pers.md" ]; then
      _q_pers=en
    fi
    if [ ! -f "$_q_v/$_q_cname/companion.md" ]; then
      # FAZ 9 V-3: persona/<lang>.md is DATA carrying two %s placeholders
      # (companion name, then user name — printf arg order below). printf
      # fills them — no {{...}} template engine. Names resolve
      # to the effective identity; absent names get i18n neutral values, so
      # no raw %s survives into companion.md.
      # -- guards against printf misparsing the file's leading YAML "---"
      # delimiter as an option (some printf builtins do this).
      # shellcheck disable=SC2059
      printf -- "$(cat "$_q_HOME/persona/$_q_pers.md")\n" "$_q_cn_eff" "$_q_us_eff" > "$_q_v/$_q_cname/companion.md"
      # FAZ 15 (AE-1/AE-2/AE-3): a second, empty "never forget" block --
      # marker knotlog:core, avenoxbeyin's accumulating Core.md lineage --
      # appended in the same only-if-missing branch, right after the persona
      # printf. Same skeleton shape as the reflect block (quipu:1219-1226):
      # one heading, one blank line, nothing else. `init` seeds it once and
      # never touches it again (companion.md's general write-once rule);
      # `remember` never writes here (AE-3) -- filling it is the model's own
      # file edit, exactly like the reflect block.
      {
        printf '%s\n' '<!-- knotlog:core:start -->'
        printf '### %s\n' "$(_q_msg core_head)"
        printf '%s\n' ''
        printf '%s\n' '<!-- knotlog:core:end -->'
      } >> "$_q_v/$_q_cname/companion.md"
      _q_changed=1
      _q_comp=1
    fi
  fi

  if [ ! -f "$(_q_threads_path "$_q_v")" ]; then
    printf '%s\n%s\n' "$(_q_msg threads_seed_title)" "$(_q_msg threads_seed_note)" > "$(_q_threads_path "$_q_v")"
    _q_changed=1
  fi
  # B3: the rules file is seeded from the shipped template, only-if-missing,
  # the same write-once discipline as companion.md/Dashboard.md/Threads.md.
  # The template carries the B4 defaults (approval gates, receipt rule,
  # record-retirement discipline); an existing file -- by either spelling,
  # see _q_rules_path -- is the user's contract and is never overwritten.
  _q_rul_lang=$(_q_lang)
  if [ ! -f "$_q_HOME/templates/$_q_rul_lang/rules.md" ]; then
    _q_rul_lang=en
  fi
  if [ -f "$_q_HOME/templates/$_q_rul_lang/rules.md" ] &&
     [ ! -f "$(_q_rules_path "$_q_v")" ]; then
    cp "$_q_HOME/templates/$_q_rul_lang/rules.md" "$(_q_rules_path "$_q_v")"
    _q_changed=1
    _q_rules=1
  fi
  # B5: the facts file is seeded from the shipped template, only-if-missing,
  # the same write-once discipline as rules.md. The template carries the
  # layer's contract (one line, one fact; the three tags; the identity-not-
  # news criterion) plus two real example lines; an existing file -- by
  # either spelling, see _q_facts_path -- is the user's record and is never
  # overwritten.
  _q_fts_lang=$(_q_lang)
  if [ ! -f "$_q_HOME/templates/$_q_fts_lang/facts.md" ]; then
    _q_fts_lang=en
  fi
  if [ -f "$_q_HOME/templates/$_q_fts_lang/facts.md" ] &&
     [ ! -f "$(_q_facts_path "$_q_v")" ]; then
    cp "$_q_HOME/templates/$_q_fts_lang/facts.md" "$(_q_facts_path "$_q_v")"
    _q_changed=1
    _q_facts=1
  fi

  if [ -n "$_q_dname" ] && [ ! -f "$_q_v/$_q_dname/Dashboard.md" ]; then
    {
      printf '%s\n' "$(_q_msg dashboard_seed_title)"
      printf '%s\n' ''
      printf '%s\n' "$(_q_msg dashboard_seed_note)"
      printf '%s\n' ''
      printf '%s\n' "$(_q_msg dashboard_seed_start)"
      # Deliberately static text, no folder-name interpolation: a layout's
      # display name carries a decorative emoji glyph (data, not code), and
      # that glyph's raw UTF-8 bytes have no business in a note body meant
      # for search indexing -- keep this seed emoji-free so the folded
      # index column only ever holds real, foldable text. Values never
      # start with '-': the bullet prefix is added here, not carried in
      # i18n data, so a leading '-' can never reach printf's format
      # argument (some printf builtins misparse that as an option).
      if [ -n "$_q_iname" ]; then
        printf -- '- %s\n' "$(_q_msg dashboard_seed_capture)"
      fi
      if [ -n "$_q_cname" ]; then
        printf -- '- %s\n' "$(_q_msg dashboard_seed_companion)"
      fi
      if [ -n "$_q_tname" ]; then
        printf -- '- %s\n' "$(_q_msg dashboard_seed_templates)"
      fi
      printf -- '- %s\n' "$(_q_msg dashboard_seed_threads)"
    } > "$_q_v/$_q_dname/Dashboard.md"
    _q_changed=1
  fi

  # Templates: copy the shipped skeletons into the vault's templates folder,
  # only-if-missing per file (same discipline as companion.md/Dashboard.md --
  # quipu seeds once, then never touches user copies again). Content language
  # follows _q_lang(), same fallback-to-en chain as the persona seed above.
  if [ -n "$_q_tname" ] && [ -d "$_q_v/$_q_tname" ]; then
    _q_tpl_lang=$(_q_lang)
    if [ ! -d "$_q_HOME/templates/$_q_tpl_lang" ]; then
      _q_tpl_lang=en
    fi
    for _q_tpl in note project session; do
      if [ -f "$_q_HOME/templates/$_q_tpl_lang/$_q_tpl.md" ] && [ ! -f "$_q_v/$_q_tname/$_q_tpl.md" ]; then
        cp "$_q_HOME/templates/$_q_tpl_lang/$_q_tpl.md" "$_q_v/$_q_tname/$_q_tpl.md"
        _q_changed=1
      fi
    done
  fi

  # Bridge block: body from i18n + layout file, via stdin (B-13). The SAME
  # body goes into AGENTS.md and CLAUDE.md so the two agent families share one
  # protocol: what Codex does through AGENTS.md, Claude sees in CLAUDE.md, and
  # the other way round. CLAUDE.md used to carry a thin pointer to AGENTS.md
  # instead; agents that never open the pointed-at file missed everything.
  # Both are marker-delimited and rewritten from this one source on every
  # init, so the two copies cannot drift apart -- the divergence risk of
  # duplicated text is answered by regenerating both, never by hand-editing.
  : >> "$_q_v/AGENTS.md"
  : >> "$_q_v/CLAUDE.md"
  _q_had_block=0
  if grep -Eq '(knotlog|quipu):start' "$_q_v/AGENTS.md"; then
    _q_had_block=1
  fi
  _q_bridge_body="$_q_v/$_q_SD/bridge-body.tmp"
  {
    printf '%s\n' '## knotlog'
    printf '%s\n' "$(_q_msg bridge_run)"
    printf '%s\n' "$(_q_msg bridge_layout)"
    while IFS= read -r _q_ln; do
      [ -n "$_q_ln" ] || continue
      case "$_q_ln" in
        '#'*) continue ;;
      esac
      _q_slug=${_q_ln%%"$_q_tab"*}
      _q_name=${_q_ln#*"$_q_tab"}
      printf '  - %s — %s\n' "$_q_name" "$(_q_msg "layout_$_q_slug")"
    done < "$_q_HOME/layout/$_q_layout.txt"
    # bridge_companion carries two %s — companion name, then folder path —
    # resolved by printf below (SC2059 pattern). FAZ 9 V-4: name + path.
    # shellcheck disable=SC2059
    printf "$(_q_msg bridge_companion)\n" "$_q_cn_eff" "$_q_cname"
    # FAZ 15 AB-9: conditional line, no fallback (AB-8) -- an unanswered
    # purpose is a skipped line, never an invented placeholder.
    if [ -n "$_q_purpose_eff" ]; then
      # shellcheck disable=SC2059
      printf "$(_q_msg bridge_purpose)\n" "$_q_purpose_eff"
    fi
    printf '%s\n' "$(_q_msg bridge_append)"
    # FAZ 8 (Y-6): the memory protocol is DATA (i18n), never code-embedded.
    printf '%s\n' "$(_q_msg bridge_reflect)"
    # D6: the checkpoint protocol rides the bridge next to the session-end
    # protocol -- DATA, same rule as bridge_reflect above.
    printf '%s\n' "$(_q_msg bridge_checkpoint)"
    # B11: the project-plans location rides the bridge next to the
    # session-end and checkpoint protocols -- DATA (i18n bridge_plans with
    # the layout's projects folder and the localized plans_dir), so the
    # rule binds every agent that reads the bridge, not just one assistant.
    if [ -n "$_q_pn" ]; then
      _q_pdl=$(_q_msg plans_dir)
      if [ -n "$_q_pdl" ]; then
        # shellcheck disable=SC2059
        printf "$(_q_msg bridge_plans)\n" "$_q_pn" "$_q_pdl"
      fi
    fi
    # Zero-level protocols: the 13-item behavior contract rides the bridge
    # as DATA (i18n bridge_protocols + bridge_proto_01..13), same rule as
    # bridge_reflect/bridge_checkpoint/bridge_plans above -- the header text
    # never gets embedded in code, and the loop prints every item instead
    # of hand-written printf lines that could drift out of numeric
    # order.
    printf '%s\n' "$(_q_msg bridge_protocols)"
    _q_proto_n=1
    while [ "$_q_proto_n" -le 13 ]; do
      _q_proto_key=$(printf 'bridge_proto_%02d' "$_q_proto_n")
      printf '  %s\n' "$(_q_msg "$_q_proto_key")"
      _q_proto_n=$((_q_proto_n + 1))
    done
    # Style: OpenCode has no context hook and reads only this block, so the
    # active tone preset and flair ride it. Absent when neither is set.
    _q_style_build "$_q_v"
    if [ "$_q_tres_source" = preset ] || [ -n "$_q_fl_body" ]; then
      printf '%s\n' "$(_q_msg bridge_style)"
      printf '%s' "$_q_tone"
    fi
  } > "$_q_bridge_body"

  awk -f "$_q_HOME/lib/block.awk" "$_q_v/AGENTS.md" < "$_q_bridge_body" > "$_q_v/$_q_SD/agents.tmp" \
    && mv "$_q_v/$_q_SD/agents.tmp" "$_q_v/AGENTS.md"
  awk -f "$_q_HOME/lib/block.awk" "$_q_v/CLAUDE.md" < "$_q_bridge_body" > "$_q_v/$_q_SD/claude.tmp" \
    && mv "$_q_v/$_q_SD/claude.tmp" "$_q_v/CLAUDE.md"
  rm -f "$_q_bridge_body"

  _q_union_ensure "$_q_v"

  # FAZ 15 AB-10: the hook path stays silent on `init` too, the same R-6 rule
  # already applied to `index` (quipu:1327-1329ish, V1-DUZELTME) -- all the
  # file-writing work above already happened (a hook-invoked init still
  # seeds/updates the vault), only the success-path summary text is skipped.
  if [ "${QUIPU_HOOK:-0}" = 1 ]; then
    return 0
  fi
  # B1: sır kapanı bağlama — hook modunun return'ünden SONRA, yani QUIPU_HOOK
  # çağrılarında hiç çalışmaz; install'in sessiz init'inde çalışır (install
  # sonucu _q_hooks_state'ten kendi özetinde basar).
  _q_secret_hooks_setup "$_q_v"
  # NOTE: the baseline commit is deliberately NOT made here. install writes
  # its integrations (.claude, .omp, the icon, repair-hooks) only after this
  # function returns, so committing now would capture a half-built vault --
  # measured: five entries left untracked. Each entry point makes it at its
  # own end instead, and the unborn-HEAD guard keeps exactly one of them firing.
  # `install` owns its guided transcript and compact status summary. Its
  # internal init call sets this flag only for the duration of that function
  # call; direct `quipu init` keeps every historical success/progress line.
  if [ "${QUIPU_INTERNAL_INSTALL_QUIET:-0}" = 1 ]; then
    return 0
  fi

  if [ "$_q_changed" -eq 0 ] && [ "$_q_had_block" -eq 1 ]; then
    _q_msg init_idem
  else
    # shellcheck disable=SC2059
    printf "$(_q_msg init_ok)\n" "$_q_v"
    if [ "$_q_git" -eq 1 ]; then
      _q_msg init_git
    fi
    if [ -n "$_q_lang" ]; then
      # shellcheck disable=SC2059
      printf "$(_q_msg init_lang)\n" "$_q_lang"
    fi
    # shellcheck disable=SC2059
    printf "$(_q_msg init_layout)\n" "$_q_layout"
    if [ "$_q_had_block" -eq 0 ]; then
      _q_msg init_agents
    fi
    if [ "$_q_comp" -eq 1 ]; then
      _q_msg init_companion
    fi
    if [ "$_q_rules" -eq 1 ]; then
      _q_msg init_rules
    fi
    if [ "$_q_facts" -eq 1 ]; then
      _q_msg init_facts
    fi
    if [ "$_q_purpose_new" -eq 1 ]; then
      _q_msg init_purpose
    fi
    _q_msg init_next
  fi
  # B1: sır kapanı sonucu — idempotent yeniden init'te de bilgilendirir;
  # git deposu olmayan kasada hataya düşmeden yol gösterir.
  _q_hooks_report
  # Direct `quipu init` only: install returns above and commits at its own end.
  _q_init_baseline "$_q_init_v"
  _q_baseline_report
}

_q_init_baseline() {
  # A git-by-default install used to leave the vault as a repository with ZERO
  # commits, so the very first `doctor` a new user ran already warned about
  # uncommitted memory (measured 2026-09-03: 24 untracked entries) -- and a
  # repository with no history offers none of the safety the default promises.
  # Seed a .gitignore, then make the baseline commit.
  #
  # Three guards, all deliberate:
  #   * only when HEAD is unborn -- an existing history is the user's, never
  #     ours to write into;
  #   * only when git identity resolves -- committing with a guessed identity
  #     would forge authorship, and `doctor`'s D4 already covers the skip;
  #   * never fatal -- this is convenience on top of a finished install, so
  #     every failure path leaves the vault intact and just stays quiet.
  # $1: vault root.
  _q_baseline_state=none
  command -v git >/dev/null 2>&1 || return 0
  (cd "$1" && git rev-parse --git-dir >/dev/null 2>&1) || return 0
  # Unborn HEAD: `git rev-parse HEAD` fails only while no commit exists.
  if (cd "$1" && git rev-parse --verify -q HEAD >/dev/null 2>&1); then
    return 0
  fi

  # .gitignore is write-once and user-owned afterwards (companion.md's rule).
  # The entries are the machine state quipu regenerates: the activity log and
  # both derived indexes rewrite on every session, and the folder-icon
  # metadata is produced by repair-hooks. Committing them would turn every
  # `quipu index` into a diff.
  if [ ! -e "$1/.gitignore" ]; then
    {
      printf '# knotlog: machine state, regenerated -- not memory.\n'
      printf '%s/activity.log*\n' "$_q_SD"
      printf '%s/index.tsv\n' "$_q_SD"
      printf '%s/links.tsv\n' "$_q_SD"
      printf '%s/blocks.tsv\n' "$_q_SD"
      printf '%s/index.schema\n' "$_q_SD"
      printf '%s/index.version\n' "$_q_SD"
      printf '%s/needs_reflection\n' "$_q_SD"
      printf '%s/remembered\n' "$_q_SD"
      printf '%s/nudged\n' "$_q_SD"
      printf '%s/checkpoint_nudged\n' "$_q_SD"
      printf '\n'
      printf '# Folder-icon metadata, rebuilt by repair-hooks --metadata-only.\n'
      printf 'desktop.ini\n'
      printf '.directory\n'
      printf '\n'
      printf '# Agent-local overrides and editor leftovers.\n'
      printf '**/.claude/settings.local.json\n'
      printf '*.bak\n'
    } > "$1/.gitignore"
  fi

  # No identity pre-check: git also accepts GIT_AUTHOR_*/GIT_COMMITTER_* from
  # the environment, so testing `git config user.email` alone declares a
  # perfectly committable repo identity-less (measured: T-429 went red on it).
  # Attempting the commit is the only honest test -- it fails cleanly when no
  # identity resolves, and that failure is the skip.
  if (cd "$1" && git add -A >/dev/null 2>&1 \
      && git commit -q -m "$(_q_msg init_commit_msg)" >/dev/null 2>&1); then
    _q_baseline_state=made
  else
    _q_baseline_state=skip
  fi
  return 0
}

_q_baseline_report() {
  # Default the state the way _q_hooks_report's caller does: under `set -u` an
  # unset variable is fatal, so a path that reports without having run the
  # baseline would kill the command instead of staying quiet. Found while
  # blinding the tests -- removing the baseline calls took 69 tests down with
  # a crash rather than with the missing feature.
  _q_baseline_state=${_q_baseline_state:-none}
  case "$_q_baseline_state" in
    made) _q_msg init_commit ;;
    skip) _q_msg init_commit_skip ;;
    *) : ;;
  esac
}

_q_create_verified_link() {
  # Git Bash may emulate `ln -s` with a copy or an MSYS-only placeholder.
  # nativestrict requires a real Windows symlink there and is ignored by
  # POSIX ln elsewhere. The filesystem checks also reject copied, dangling,
  # non-executable, or wrong-source results before install can report success.
  _q_cvl_source=$1
  _q_cvl_link=$2
  _q_cvl_msys="${MSYS:+$MSYS }winsymlinks:nativestrict"
  if [ -e "$_q_cvl_link" ] || [ -L "$_q_cvl_link" ]; then
    return 1
  fi
  if ! MSYS=$_q_cvl_msys ln -s "$_q_cvl_source" "$_q_cvl_link"; then
    return 1
  fi
  _q_cvl_resolved=$(_q_resolve_path "$_q_cvl_link" 2>/dev/null || true)
  if [ -L "$_q_cvl_link" ] &&
     [ -f "$_q_cvl_link" ] &&
     [ -x "$_q_cvl_link" ] &&
     [ "$_q_cvl_resolved" = "$_q_cvl_source" ]; then
    return 0
  fi
  rm -f -- "$_q_cvl_link"
  return 1
}

_q_die_install_link() {
  _q_die err_install_link_unusable 2 "$1"
}

_q_term_cols() {
  # Best-effort terminal width, zero-dependency: `stty size` first (prints
  # "rows cols", no terminfo needed), then `tput cols` (needs terminfo but
  # some hosts only have that), then the safe POSIX/Windows-console default
  # of 80 if neither is available or either gives a non-numeric answer.
  #
  # A width is only trusted if it is a POSITIVE integer. `stty size` prints
  # "0 0" on a pty whose winsize was never set -- a real scenario, not a
  # corner case: some CI runners, tty-less ssh, and certain Git Bash launch
  # modes all do this (found live, exactly on the Windows side this script
  # targets). Treating that 0 as a real column count collapsed the whole
  # box to unreadable, wiping out the step counter it exists to show.
  _q_tc_cols=
  if command -v stty >/dev/null 2>&1; then
    _q_tc_cols=$(stty size 2>/dev/null | awk '{print $2}')
  fi
  case "$_q_tc_cols" in
    '' | *[!0-9]*) _q_tc_cols=0 ;;
  esac
  if [ "$_q_tc_cols" -le 0 ]; then
    _q_tc_cols=
    if command -v tput >/dev/null 2>&1; then
      # Guarded assignment: under `set -e`, an unguarded `var=$(cmd)` where
      # cmd exits non-zero aborts the whole script -- found live via a
      # fake tput that always exits 1, the same shape as a real host where
      # tput errors (e.g. TERM unset). `stty size | awk` above is already
      # safe because a pipeline's exit status is its LAST command's (awk,
      # which exits 0 even on empty input); this standalone substitution
      # has no such protection without the explicit `|| true`.
      _q_tc_cols=$(tput cols 2>/dev/null) || true
    fi
    case "$_q_tc_cols" in
      '' | *[!0-9]*) _q_tc_cols=0 ;;
    esac
  fi
  [ "$_q_tc_cols" -gt 0 ] || _q_tc_cols=80
  printf '%s\n' "$_q_tc_cols"
}

_q_install_page() {
  # Starts a boxed wizard page: clears the real terminal (clearing is
  # deliberately tied to stdout's real terminal, not FORCE_TTY -- tests can
  # force prompts over a pipe without receiving terminal controls), then
  # buffers the header + title line for _q_install_page_flush to draw as
  # one ASCII box. $1 = title message key; $2 $3 = optional step/total
  # substituted into a "[%d/%d] ..." template (see install_step_* in i18n).
  if [ -t 1 ]; then
    awk 'BEGIN { printf "%c[2J%c[H", 27, 27 }'
  fi
  _q_pg_lines=$(_q_msg install_header)
  if [ "$#" -ge 3 ]; then
    # shellcheck disable=SC2059
    _q_pg_title=$(printf "$(_q_msg "$1")" "$2" "$3")
  else
    _q_pg_title=$(_q_msg "$1")
  fi
  _q_pg_lines="$_q_pg_lines
$_q_pg_title"
}

_q_disp_width() {
  # True UTF-8 display width in CHARACTERS, locale-independent: total bytes
  # minus continuation bytes (0x80-0xBF). `wc -m` cannot be trusted here --
  # it counts characters on a UTF-8 macOS/Linux but degenerates to bytes in
  # a C-locale Git Bash -- so the count is derived from raw bytes directly.
  # Input must be well-formed UTF-8, which the eliding below guarantees.
  printf '%s' "$1" | LC_ALL=C awk '{
    for (i = 1; i <= length($0); i++) {
      ch = substr($0, i, 1)
      if (ch < "\200" || ch >= "\300") c++
    }
  }
  END { print c + 0 }'
}

_q_install_page_flush() {
  # Draws the header/title/review lines gathered by _q_install_page and
  # _q_install_review as one ASCII box -- no Unicode box-drawing
  # characters, those risk a codepage mismatch in Windows consoles -- then
  # a blank line, after which the caller's own prompt/output continues
  # unboxed. Box width is the widest line in DISPLAY characters -- true
  # UTF-8 characters, via _q_disp_width above -- and padding follows the
  # same count, so content and border line up visually on every platform.
  # The eliding cut itself stays in bytes (see below): bytes are the only
  # measure every platform agrees on, and a byte budget can only over-
  # deliver safety, never under-deliver, since characters <= bytes.
  #
  # The box is capped at min(detected terminal width, 76) total columns,
  # but never shrunk below 40 even on a genuinely narrow/undetectable
  # terminal -- below that the box stops being useful at all, and the two
  # lines that matter most (header, and the "[n/N] Title" step counter --
  # the very thing this whole box exists to make honest) must always
  # survive intact. A long vault path (the only realistic offender: review
  # lines are all "Label: value") would otherwise stretch the border past
  # 80 columns, wrap on a standard terminal (Windows console default
  # included), and make the exact thing the box exists to prevent -- a
  # confusing, broken layout. So only the review lines (added by
  # _q_install_review, everything AFTER the header+title pair
  # _q_install_page buffers first) are eligible for eliding -- the header
  # and the step-counter title are never touched, no matter how narrow the
  # cap ends up. An eligible line that overflows is elided from the FRONT
  # with a leading "..." (the tail of a path is the informative end),
  # entirely in bytes: `cut -b` is byte-based on every platform by POSIX
  # (unlike -c, whose semantics differ between BSD and GNU), and the awk
  # trim then drops any leading UTF-8 continuation bytes (0x80-0xBF) left
  # over when the cut lands inside a multibyte Turkish character -- the
  # tail therefore always starts on a character boundary and the
  # transcript stays well-formed UTF-8. Nothing is actually lost: the
  # install summary prints the full, untruncated path again later,
  # outside any box.
  _q_pf_cap=$(_q_term_cols)
  [ "$_q_pf_cap" -le 76 ] || _q_pf_cap=76
  [ "$_q_pf_cap" -ge 40 ] || _q_pf_cap=40
  _q_pf_content_max=$((_q_pf_cap - 4))
  [ "$_q_pf_content_max" -ge 10 ] || _q_pf_content_max=10

  _q_pf_ifs=$IFS
  IFS='
'
  _q_pf_elided=
  _q_pf_first=1
  _q_pf_idx=0
  # Word-splitting on $_q_pg_lines is deliberate: it is the page buffer,
  # one already-formatted display line per line-break, built exclusively
  # by _q_install_page/_q_install_review just above.
  # shellcheck disable=SC2086
  for _q_pf_line in $_q_pg_lines; do
    _q_pf_idx=$((_q_pf_idx + 1))
    _q_pf_w=$(_q_disp_width "$_q_pf_line")
    if [ "$_q_pf_idx" -gt 2 ] && [ "$_q_pf_w" -gt "$_q_pf_content_max" ]; then
      _q_pf_keep=$((_q_pf_content_max - 3))
      [ "$_q_pf_keep" -ge 1 ] || _q_pf_keep=1
      # The cut budget is in BYTES (never fewer than the character budget
      # would need): the last N bytes carry at most N display characters.
      _q_pf_b=$(printf '%s' "$_q_pf_line" | LC_ALL=C wc -c | tr -d ' ')
      _q_pf_skip=$((_q_pf_b - _q_pf_keep))
      _q_pf_line="...$(printf '%s' "$_q_pf_line" | cut -b"$((_q_pf_skip + 1))-" |
        LC_ALL=C awk '{
          i = 1
          while (i <= length($0) && substr($0, i, 1) >= "\200" && substr($0, i, 1) < "\300") i++
          printf "%s", substr($0, i)
        }')"
    fi
    if [ "$_q_pf_first" -eq 1 ]; then
      _q_pf_elided=$_q_pf_line
      _q_pf_first=0
    else
      _q_pf_elided="$_q_pf_elided
$_q_pf_line"
    fi
  done

  _q_pf_max=0
  # shellcheck disable=SC2086
  for _q_pf_line in $_q_pf_elided; do
    _q_pf_w=$(_q_disp_width "$_q_pf_line")
    [ "$_q_pf_w" -le "$_q_pf_max" ] || _q_pf_max=$_q_pf_w
  done
  _q_pf_border=$(awk -v n="$_q_pf_max" 'BEGIN { s = "+"; for (i = 0; i < n + 2; i++) s = s "-"; print s "+" }')
  printf '%s\n' "$_q_pf_border"
  # shellcheck disable=SC2086
  for _q_pf_line in $_q_pf_elided; do
    _q_pf_w=$(_q_disp_width "$_q_pf_line")
    _q_pf_pad=$(awk -v n="$((_q_pf_max - _q_pf_w))" 'BEGIN { s = ""; for (i = 0; i < n; i++) s = s " "; print s }')
    printf '| %s%s |\n' "$_q_pf_line" "$_q_pf_pad"
  done
  printf '%s\n' "$_q_pf_border"
  IFS=$_q_pf_ifs
  printf '\n'
  _q_pg_lines=
}

_q_install_menu_pick() {
  # Arrow-key menu core, shared by the language and Style questions.
  # $1 = optional headline line, $2 = title, $3 = space-separated codes,
  # $4 = newline-separated labels in the same order. Sets _q_menu_pick to
  # the chosen code. This is a strict optional
  # upgrade over the plain-text prompt: it must only run when raw terminal
  # control is certain, and it must never be the only path. Anything short
  # of "real tty, real stty, real terminal" falls back silently to the
  # caller's plain-text question -- pipes, CI, QUIPU_FORCE_TTY test mode,
  # dumb terminals, and any stty failure all take that path.
  [ -t 0 ] && [ -t 1 ] || return 1
  [ "${QUIPU_FORCE_TTY:-0}" != 1 ] || return 1
  case "${TERM:-}" in
    '' | dumb) return 1 ;;
  esac
  command -v stty >/dev/null 2>&1 || return 1
  _q_menu_saved=$(stty -g 2>/dev/null) || return 1

  # Ctrl+C (or a TERM/HUP) mid-menu must leave the terminal usable, not
  # stuck in raw/no-echo mode. EXIT covers normal return paths too, so the
  # state is restored no matter how this function's raw section is left.
  trap 'stty "$_q_menu_saved" 2>/dev/null || true' EXIT
  trap 'stty "$_q_menu_saved" 2>/dev/null || true; exit 130' HUP INT TERM

  if ! stty raw -echo 2>/dev/null; then
    trap - EXIT HUP INT TERM
    return 1
  fi

  # The option list is codes only; labels are looked up per-code from i18n
  # (install_menu_lang_name_<code>) so nothing user-visible is hardcoded in
  # source, and the modulo below is driven by the actual option count --
  # not a literal 2 -- so a third profile (README promises "other languages
  # via profiles") would not silently break up/down.
  _q_menu_codes=$3
  _q_menu_labels=$4
  # Word-splitting on this list is deliberate: it is a fixed space-separated
  # set of plain ASCII codes (no globs, no embedded spaces), the standard
  # POSIX sh idiom for an ad hoc list where real arrays are unavailable.
  # shellcheck disable=SC2086
  _q_menu_n=$(set -- $_q_menu_codes; printf '%s\n' "$#")
  _q_menu_esc=$(printf '\033')
  _q_menu_sel=0
  while :; do
    stty "$_q_menu_saved" 2>/dev/null || true
    # This screen is deliberately bare -- no "Quipu setup" header, no
    # question line, no hint line, and no box: just the bare title and the
    # options themselves. The language is not chosen yet, so both option
    # labels stay in English regardless of which one ends up selected.
    if [ -t 1 ]; then
      awk 'BEGIN { printf "%c[2J%c[H", 27, 27 }'
    fi
    [ -z "$1" ] || printf '%s\r\n' "$1"
    printf '%s\r\n\r\n' "$2"
    _q_menu_i=0
    for _q_menu_code in $_q_menu_codes; do
      _q_menu_name=$(printf '%s\n' "$_q_menu_labels" | sed -n "$((_q_menu_i + 1))p")
      if [ "$_q_menu_i" -eq "$_q_menu_sel" ]; then
        printf '> %s\r\n' "$_q_menu_name"
      else
        printf '  %s\r\n' "$_q_menu_name"
      fi
      _q_menu_i=$((_q_menu_i + 1))
    done
    stty raw -echo 2>/dev/null || true
    _q_menu_c=$(dd bs=1 count=1 2>/dev/null) || _q_menu_c=
    case "$_q_menu_c" in
      "$_q_menu_esc")
        # Arrow keys arrive as ESC '[' 'A'/'B'; only the final byte
        # distinguishes them. Up and down move in opposite directions,
        # wrapping through the actual option count.
        dd bs=1 count=1 2>/dev/null >/dev/null || true
        _q_menu_c3=$(dd bs=1 count=1 2>/dev/null) || _q_menu_c3=
        case "$_q_menu_c3" in
          A) _q_menu_sel=$(( (_q_menu_sel - 1 + _q_menu_n) % _q_menu_n )) ;;
          B) _q_menu_sel=$(( (_q_menu_sel + 1) % _q_menu_n )) ;;
        esac
        ;;
      '' | "$(printf '\r')" | "$(printf '\n')")
        break
        ;;
    esac
  done
  stty "$_q_menu_saved" 2>/dev/null || true
  trap - EXIT HUP INT TERM

  _q_menu_i=0
  for _q_menu_code in $_q_menu_codes; do
    if [ "$_q_menu_i" -eq "$_q_menu_sel" ]; then
      _q_menu_pick=$_q_menu_code
    fi
    _q_menu_i=$((_q_menu_i + 1))
  done
  return 0
}

_q_install_menu_lang() {
  # Language question: the bare arrow-key menu (no headline), or fall back.
  _q_ml_codes=$(_q_langs | tr '\n' ' ')
  _q_ml_labels=
  for _q_ml_c in $_q_ml_codes; do
    _q_ml_labels="$_q_ml_labels$_q_ml_c -- $(_q_msg "install_menu_lang_name_$_q_ml_c")
"
  done
  _q_install_menu_pick '' "$(_q_msg install_menu_lang_title)" "$_q_ml_codes" "$_q_ml_labels" || return 1
  _q_i_lang=$_q_menu_pick
  _q_i_layout=$_q_i_lang
  _q_layout_ok "$_q_i_layout" || _q_i_layout=en
  return 0
}

_q_install_review() {
  # Appends one "Label: value" line to the page buffer started by
  # _q_install_page, instead of printing it immediately -- so the whole
  # page (header, title, every review line so far) renders as a single
  # box when _q_install_page_flush draws it.
  case "$1" in
    language) _q_pg_key=install_review_language; _q_pg_val=$_q_i_lang ;;
    location) _q_pg_key=install_review_location; _q_pg_val=$_q_i_parent ;;
    user) _q_pg_key=install_review_user; _q_pg_val=$_q_i_user ;;
    companion) _q_pg_key=install_review_companion; _q_pg_val=$_q_i_companion ;;
    purpose) _q_pg_key=install_review_purpose; _q_pg_val=$_q_i_purpose ;;
    tone) _q_pg_key=install_review_tone; _q_pg_val=$(_q_msg "tone_name_${_q_i_tone:-varsayilan}") ;;
    flair) _q_pg_key=install_review_flair; _q_pg_val=${_q_i_flair:-none} ;;
    folders)
      _q_pg_key=install_review_folders
      if [ "$_q_i_plain" -eq 1 ]; then _q_pg_val=$(_q_msg install_style_plain); else _q_pg_val=$(_q_msg install_style_emoji); fi
      ;;
  esac
  # shellcheck disable=SC2059
  _q_pg_line=$(printf "$(_q_msg "$_q_pg_key")" "$_q_pg_val")
  _q_pg_lines="$_q_pg_lines
$_q_pg_line"
}

_q_install_set_step_totals() {
  # $1 = 1 if a numbered "[n/N] Language" page was (or will be) shown, 0 if
  # language was covered some other way -- install.ps1's own screen
  # (KNOTLOG_INSTALL_HANDOFF) or bash's own arrow-key menu, which is itself
  # the language step but carries no box/counter (maintainer decision). With
  # 0 the pages after it renumber from [1/N] -- never a stale count left over
  # from a page that was not actually shown as its own numbered step. The
  # Style page counts only when it will be shown (_q_i_style, set before the
  # first call: interactive and at least one of its three questions open).
  _q_i_n_location=$(( 2 - (1 - $1) ))
  _q_i_n_identity=$((_q_i_n_location + 1))
  _q_i_n_style=$((_q_i_n_identity + 1))
  _q_i_n_install=$((_q_i_n_identity + 1 + _q_i_style))
  _q_i_total_steps=$_q_i_n_install
}

_q_install_pick() {
  # One Style question: the shared arrow-key menu, else numbered plain text
  # (Enter = first option; a number or a code). $1 = headline, $2 = title,
  # $3 = codes, $4 = newline-separated labels. Sets _q_menu_pick.
  _q_install_menu_pick "$@" && return 0
  printf '%s\n' "$2"
  _q_pk_n=0
  for _q_pk_c in $3; do
    _q_pk_n=$((_q_pk_n + 1))
    printf '  %d) %s\n' "$_q_pk_n" "$(printf '%s\n' "$4" | sed -n "${_q_pk_n}p")"
  done
  # shellcheck disable=SC2059
  printf "$(_q_msg install_ask_pick) " "$_q_pk_n"
  IFS= read -r _q_pk_ans || _q_pk_ans=
  _q_menu_pick=${3%% *}
  [ -n "$_q_pk_ans" ] || return 0
  _q_pk_i=0
  for _q_pk_c in $3; do
    _q_pk_i=$((_q_pk_i + 1))
    if [ "$_q_pk_ans" = "$_q_pk_i" ] || [ "$_q_pk_ans" = "$_q_pk_c" ]; then
      _q_menu_pick=$_q_pk_c
      return 0
    fi
  done
  _q_die err_install_style_invalid 2 "$_q_pk_ans"
}

_q_install_style() {
  # The Style step: tone preset, flair, folder names. Each question is asked
  # only when its flag (--tone, --flair, --plain) was not given; the default
  # answer (first option) leaves the state exactly as a flagless install.
  # shellcheck disable=SC2059
  _q_st_head=$(printf "$(_q_msg install_step_style)" "$_q_i_n_style" "$_q_i_total_steps")
  if [ "$_q_i_tone_set" -eq 0 ]; then
    # kaomoji is a flair now; the tone menu leaves it out (--tone kaomoji still works).
    _q_st_codes="varsayilan profesyonel dostane icten siradisi etkili sivridilli ogretici"
    _q_st_labels=
    for _q_st_c in $_q_st_codes; do
      _q_st_labels="$_q_st_labels$(_q_msg "tone_name_$_q_st_c") -- $(_q_msg "tone_desc_$_q_st_c")
"
    done
    _q_install_pick "$_q_st_head" "$(_q_msg install_style_tone)" "$_q_st_codes" "$_q_st_labels"
    if [ "$_q_menu_pick" != varsayilan ]; then _q_i_tone=$_q_menu_pick; _q_i_tone_set=1; fi
  fi
  if [ -z "$_q_i_flair" ]; then
    _q_st_labels=
    for _q_st_c in none kaomoji emoji; do
      _q_st_labels="$_q_st_labels$_q_st_c -- $(_q_msg "flair_desc_$_q_st_c")
"
    done
    _q_install_pick "$_q_st_head" "$(_q_msg install_style_flair)" "none kaomoji emoji" "$_q_st_labels"
    if [ "$_q_menu_pick" != none ]; then _q_i_flair=$_q_menu_pick; fi
  fi
  if [ "$_q_i_plain" -eq 0 ]; then
    _q_st_labels="$(_q_msg install_style_emoji) -- $(_q_msg install_style_emoji_ex)
$(_q_msg install_style_plain) -- 000-Inbox, 100-Command-Center
"
    _q_install_pick "$_q_st_head" "$(_q_msg install_style_folders)" "emoji plain" "$_q_st_labels"
    if [ "$_q_menu_pick" = plain ]; then _q_i_plain=1; _q_i_layout=plain; fi
  fi
}

_q_install_tty() {
  # The real-terminal gate shared by the progress animation and the green
  # closing title: stdout must be an actual terminal, TERM must be
  # meaningful (never ''/dumb), and QUIPU_FORCE_TTY must be off -- FORCE_TTY
  # is the test mode that runs the wizard over pipes, where control
  # characters would corrupt captured transcripts and the line-by-line
  # tests that match them. Everything else (pipes, CI, dumb terminals)
  # gets plain text, the same fallback discipline as the arrow-key menu.
  [ -t 1 ] || return 1
  [ "${QUIPU_FORCE_TTY:-0}" != 1 ] || return 1
  case "${TERM:-}" in
    '' | dumb) return 1 ;;
  esac
  return 0
}

_q_sum_color() {
  # Summary colour: a real terminal and NO_COLOR unset (https://no-color.org).
  # Evaluated once into _q_sum_c: inside $(...) stdout is a pipe, so the
  # terminal test cannot run where the text is painted.
  _q_sum_c=0
  if _q_install_tty && [ -z "${NO_COLOR:-}" ]; then _q_sum_c=1; fi
}

_q_sum_paint() {
  # $1 SGR code, $2 text.
  if [ "$_q_sum_c" -eq 1 ]; then
    printf '\033[%sm%s\033[0m' "$1" "$2"
  else
    printf '%s' "$2"
  fi
}

_q_sum_ok() {
  # $1 group (vault|hooks|safety), $2 text: queue one done line.
  _q_so_line="  $(_q_sum_paint 32 '✔') $2
"
  case $1 in
    vault) _q_sum_vault="$_q_sum_vault$_q_so_line" ;;
    hooks) _q_sum_hooks="$_q_sum_hooks$_q_so_line" ;;
    *) _q_sum_safety="$_q_sum_safety$_q_so_line" ;;
  esac
}

_q_sum_skip() {
  # $1 text, $2 optional fix command: queue one not-done line (+ dim fix line).
  _q_sum_skipped="$_q_sum_skipped  $(_q_sum_paint 33 '!') $1
"
  [ -z "${2:-}" ] || _q_sum_skipped="$_q_sum_skipped$(_q_sum_paint 2 "    $2")
"
}

_q_sum_print() {
  for _q_sp in vault hooks safety skipped; do
    case $_q_sp in
      vault) _q_sp_body=$_q_sum_vault ;;
      hooks) _q_sp_body=$_q_sum_hooks ;;
      safety) _q_sp_body=$_q_sum_safety ;;
      *) _q_sp_body=$_q_sum_skipped ;;
    esac
    [ -n "$_q_sp_body" ] || continue
    _q_sum_paint 1 "$(_q_msg "install_summary_h_$_q_sp")"
    printf '\n%s' "$_q_sp_body"
  done
}

_q_install_busy_loop() {
  # Background tick loop: the label once, then one dot per second. `sleep 1`
  # keeps the POSIX contract (no fractional sleeps); the install work this
  # decorates takes a handful of seconds, so the dots stay readable.
  printf '%s' "$(_q_msg install_busy)"
  while :; do
    printf '.'
    sleep 1
  done
}

_q_install_busy_start() {
  # Start the animation ONLY on a real terminal; a silent no-op everywhere
  # else. Traps guarantee the line is cleaned up even when the install dies
  # mid-work: without them a failed run would leave an orphaned background
  # loop printing dots onto the terminal forever.
  _q_install_tty || return 0
  ( _q_install_busy_loop ) &
  _q_busy_pid=$!
  trap '_q_install_busy_stop' EXIT
  trap '_q_install_busy_stop; trap - EXIT; exit 130' INT TERM HUP
}

_q_install_busy_stop() {
  trap - EXIT INT TERM HUP
  [ -n "${_q_busy_pid:-}" ] || return 0
  kill "$_q_busy_pid" 2>/dev/null || true
  wait "$_q_busy_pid" 2>/dev/null || true
  _q_busy_pid=
  # Erase the busy line completely -- CR + blank + CR, no ANSI CSI. A real
  # terminal is guaranteed here, but a bare carriage-return erase is the
  # oldest, safest form and leaves no stray characters behind.
  printf '\r%80s\r' ''
}

# ---- install ----------------------------------------------------------------

_q_cmd_install() {
  _q_i_origin=$PWD
  _q_i_parent=
  _q_i_parent_set=0
  _q_i_plain=0
  # install git-inits the vault by DEFAULT (2026-09-03). Measured on a fresh
  # install: it did not, so B1's secret gate -- the headline security feature
  # of v2.6.0 -- never reached a new user. Every other safety net here already
  # assumes a repository (D4's uncommitted-memory check, `capture --git`,
  # `remember --git`, the pre-commit gate) and the README sells that
  # assumption, so leaving the vault outside git was the odd one out.
  # `--no-git` is the deliberate way out. `init` is unchanged: it is the
  # lower-level command and flipping its default would shift existing scripts.
  _q_i_git=1
  _q_i_git_explicit=0
  _q_i_no_link=0
  _q_i_force=0
  _q_i_link_replace=0
  _q_i_noprompt=0
  _q_i_lang_set=0
  _q_i_user=
  _q_i_user_set=0
  _q_i_companion=
  _q_i_companion_set=0
  _q_i_purpose=
  _q_i_purpose_set=0
  _q_i_tone=
  _q_i_tone_set=0
  _q_i_flair=
  _q_i_layout=

  # Parse everything before asking questions or touching either destination.
  # install gathers every answer itself, then calls init with --no-prompt.
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --plain) _q_i_plain=1; shift ;;
      --git) _q_i_git=1; _q_i_git_explicit=1; shift ;;
      --no-git) _q_i_git=0; _q_i_git_explicit=1; shift ;;
      --no-link) _q_i_no_link=1; shift ;;
      --force) _q_i_force=1; shift ;;
      --no-prompt) _q_i_noprompt=1; shift ;;
      --lang)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        _q_i_lang=$2
        _q_i_lang_set=1
        shift 2
        ;;
      --user)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        _q_i_user=$2
        _q_i_user_set=1
        shift 2
        ;;
      --companion)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        _q_i_companion=$2
        _q_i_companion_set=1
        shift 2
        ;;
      --purpose)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        _q_i_purpose=$2
        _q_i_purpose_set=1
        shift 2
        ;;
      --tone)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          varsayilan|profesyonel|dostane|icten|siradisi|etkili|sivridilli|ogretici|kaomoji) : ;;
          *) _q_die err_tone_unknown 2 "$2" ;;
        esac
        _q_i_tone=$2
        _q_i_tone_set=1
        shift 2
        ;;
      --flair)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          none|kaomoji|emoji) : ;;
          *) _q_die err_flair_unknown 2 "$2" ;;
        esac
        _q_i_flair=$2
        shift 2
        ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *)
        if [ "$_q_i_parent_set" -eq 1 ]; then
          _q_die err_install_extra_arg 2 "$1"
        fi
        _q_i_parent=$1
        _q_i_parent_set=1
        shift
        ;;
    esac
  done

  _q_i_interactive=0
  if [ "$_q_i_noprompt" -eq 0 ] && [ "${QUIPU_HOOK:-0}" != 1 ]; then
    if [ -t 0 ] || [ "${QUIPU_FORCE_TTY:-0}" = 1 ]; then
      _q_i_interactive=1
    fi
  fi

  # The Style page exists only when interactive and a question is still open.
  _q_i_style=0
  if [ "$_q_i_interactive" -eq 1 ] && { [ "$_q_i_tone_set" -eq 0 ] || [ -z "$_q_i_flair" ] || [ "$_q_i_plain" -eq 0 ]; }; then
    _q_i_style=1
  fi

  # Step numbering must match exactly what bash itself is about to show --
  # never a stale count left over from a page that was skipped. A numbered
  # "[n/N] Language" page is skipped in TWO cases, both of which already
  # showed language some other way: (a) install.ps1 handed off with
  # --lang already forwarded (KNOTLOG_INSTALL_HANDOFF, set only by
  # install.ps1, never a documented public flag) -- its own screen (menu
  # or plain question) already covered it; (b) bash's own arrow-key menu
  # ran right here and is itself the "language step", just with no box or
  # counter (maintainer decision) -- showing a NUMBERED page immediately
  # after it would repeat step 1 under a different name, exactly the
  # "adım atlanıyor" seam this exists to close. Whichever case applies,
  # _q_install_set_step_totals(0) (defined above) shrinks the total to 3
  # and shifts location/identity/install to [1/3]/[2/3]/[3/3]. Neither the
  # flag-set branch (used directly on Linux/macOS, e.g.
  # `quipu install --lang tr`) nor the plain-text fallback (menu
  # unavailable) skips anything -- both show language as a real, counted
  # page, so total stays 4.
  _q_install_set_step_totals 1

  # Language is the first interaction. A flag skips the question, not step 1.
  # Interactive answers are forwarded so all guided values reach config.
  if [ "$_q_i_lang_set" -eq 1 ]; then

    _q_i_layout=$_q_i_lang
    _q_layout_ok "$_q_i_layout" || _q_i_layout=en
    QUIPU_LANG=$_q_i_lang
  else
    _q_i_layout=en
  fi
  if [ "$_q_i_interactive" -eq 1 ]; then
    if [ "$_q_i_lang_set" -eq 1 ]; then
      if [ "${KNOTLOG_INSTALL_HANDOFF:-${QUIPU_INSTALL_HANDOFF:-0}}" = 1 ]; then
        _q_install_set_step_totals 0
      else
        _q_install_set_step_totals 1
        _q_install_page install_step_lang 1 "$_q_i_total_steps"
        _q_install_review language
        _q_install_page_flush
      fi
    elif _q_install_menu_lang; then
      _q_i_lang_set=1
      QUIPU_LANG=$_q_i_lang
      _q_install_set_step_totals 0
    else
      _q_install_set_step_totals 1
      _q_install_page install_step_lang 1 "$_q_i_total_steps"
      _q_install_page_flush
      # shellcheck disable=SC2059
      printf "$(_q_msg install_ask_lang) " "$(_q_langs | paste -sd/ -)"
      IFS= read -r _q_i_ans || _q_i_ans=
      [ -n "$_q_i_ans" ] || _q_i_ans=en
      _q_i_ans=$(QUIPU_LANG=$_q_i_ans _q_lang)
      _q_lang_has "$_q_i_ans" || _q_die err_install_lang_invalid 2 "$_q_i_ans" "$(_q_langs | paste -sd/ -)"
      _q_i_lang=$_q_i_ans
      _q_i_layout=$_q_i_lang
      _q_layout_ok "$_q_i_layout" || _q_i_layout=en
      _q_i_lang_set=1
      QUIPU_LANG=$_q_i_lang
    fi
  fi
  [ "$_q_i_plain" -eq 0 ] || _q_i_layout=plain

  # Guided installs default the parent to HOME. If HOME is unavailable, the
  # original PWD is the only usable fallback. Non-interactive legacy behavior
  # remains PWD when no positional path was supplied.
  if [ -n "${HOME:-}" ]; then
    _q_i_default_parent=$HOME
  else
    _q_i_default_parent=$_q_i_origin
  fi
  if [ "$_q_i_interactive" -eq 1 ]; then
    _q_install_page install_step_location "$_q_i_n_location" "$_q_i_total_steps"
    _q_install_review language
    _q_install_page_flush
    if [ "$_q_i_parent_set" -eq 0 ]; then
      # Three-part question, printed OUTSIDE the box (the box is only for
      # header/title/review; wizard plan 1). Input is read after
      # the bare ": " prompt on the last line, and the [%s] default-directory
      # placeholder survives so Enter-to-accept-default keeps working.
      _q_msg install_ask_location_head
      # shellcheck disable=SC2059
      printf "$(_q_msg install_ask_location_default)\n" "$_q_i_default_parent"
      _q_msg install_ask_location_move
      printf '%s' "$(_q_msg install_ask_location_prompt)"
      IFS= read -r _q_i_parent || _q_i_parent=
      [ -n "$_q_i_parent" ] || _q_i_parent=$_q_i_default_parent
      _q_i_parent_set=1
    fi
  elif [ "$_q_i_parent_set" -eq 0 ]; then
    _q_i_parent=$_q_i_origin
  fi
  # PowerShell passes Windows drive paths through bash.exe. Convert those
  # inputs before the POSIX relative-path branch can prepend the checkout.
  case "$_q_i_parent" in
    [A-Za-z]:*)
      if command -v cygpath >/dev/null 2>&1; then
        _q_i_parent=$(cygpath -u "$_q_i_parent")
      fi
      ;;
  esac


  # Expand only the promised literal tilde spellings; paths are never eval'd.
  case "$_q_i_parent" in
    [~])
      [ -n "${HOME:-}" ] || _q_die err_install_home_required 2
      _q_i_parent=$HOME
      ;;
    [~]/*)
      [ -n "${HOME:-}" ] || _q_die err_install_home_required 2
      _q_i_suffix=${_q_i_parent#\~/}
      _q_i_parent="${HOME%/}/$_q_i_suffix"
      ;;
  esac
  [ -n "$_q_i_parent" ] || _q_die err_install_parent 2 "$_q_i_parent"
  case "$_q_i_parent" in
    /*) : ;;
    *) _q_i_parent="${_q_i_origin%/}/$_q_i_parent" ;;
  esac
  if [ -L "$_q_i_parent" ] && [ ! -d "$_q_i_parent" ]; then
    _q_die err_install_parent 2 "$_q_i_parent"
  fi
  if [ -e "$_q_i_parent" ] && [ ! -d "$_q_i_parent" ]; then
    _q_die err_install_parent 2 "$_q_i_parent"
  fi
  if [ -d "$_q_i_parent" ]; then
    _q_i_parent=$(CDPATH='' cd -- "$_q_i_parent" && pwd -P)
  fi
  if [ "$_q_i_interactive" -eq 1 ]; then
    # shellcheck disable=SC2059
    printf "$(_q_msg install_location_selected)\n" "$_q_i_parent"
    _q_install_page install_step_identity "$_q_i_n_identity" "$_q_i_total_steps"
    _q_install_review language
    _q_install_review location
    _q_install_page_flush
  fi

  # Fixed identity order: required user, optional companion. The old
  # purpose question left the interactive flow (wizard UX round 2, the maintainer's
  # decision) -- --purpose still skips the never-asked question entirely.
  if [ "$_q_i_user_set" -eq 0 ] && [ "$_q_i_interactive" -eq 1 ]; then
    printf '%s ' "$(_q_msg init_ask_user)"
    IFS= read -r _q_i_user || _q_i_user=
    _q_i_user_set=1
  fi
  if [ "$_q_i_user_set" -eq 0 ] || [ -z "$_q_i_user" ]; then
    _q_die err_install_user_required 2
  fi
  case "$_q_i_user" in
    .|..|*/*) _q_die err_install_unsafe_user 2 "$_q_i_user" ;;
  esac
  if [ "$_q_i_companion_set" -eq 0 ] && [ "$_q_i_interactive" -eq 1 ]; then
    printf '%s ' "$(_q_msg init_ask_companion)"
    IFS= read -r _q_i_companion || _q_i_companion=
    _q_i_companion_set=1
  fi

  case "$_q_i_parent" in
    /) _q_i_target="/$_q_i_user's Knotlog" ;;
    *) _q_i_target="${_q_i_parent%/}/$_q_i_user's Knotlog" ;;
  esac

  if [ "$_q_i_style" -eq 1 ]; then
    _q_install_page install_step_style "$_q_i_n_style" "$_q_i_total_steps"
    _q_install_review language
    _q_install_review location
    _q_install_review user
    if [ -n "$_q_i_companion" ]; then
      _q_install_review companion
    fi
    _q_install_page_flush
    _q_install_style
  fi

  if [ "$_q_i_interactive" -eq 1 ]; then
    _q_install_page install_step_install "$_q_i_n_install" "$_q_i_total_steps"
    _q_install_review language
    _q_install_review location
    _q_install_review user
    if [ -n "$_q_i_companion" ]; then
      _q_install_review companion
    fi
    _q_install_review tone
    _q_install_review flair
    _q_install_review folders
    if [ -n "$_q_i_purpose" ]; then
      _q_install_review purpose
    fi
    _q_install_page_flush
  fi
  # The work below (vault creation, asset copies, PATH link, metadata) is
  # the slow part: show the progress animation while it runs, on a real
  # terminal only. Stopped (line erased) right before the closing screen.
  _q_install_busy_start

  # Accept only an existing Knotlog vault or a genuinely empty target.
  _q_i_fresh=1
  if [ -L "$_q_i_target" ] && [ ! -d "$_q_i_target" ]; then
    _q_die err_install_target_occupied 2 "$_q_i_target"
  fi
  if [ -e "$_q_i_target" ]; then
    [ -d "$_q_i_target" ] || _q_die err_install_target_occupied 2 "$_q_i_target"
    _q_SD=$(_q_sd_of "$_q_i_target")
    if [ -f "$_q_i_target/$_q_SD/config" ]; then
      _q_i_fresh=0
    else
      _q_i_nonempty=0
      for _q_i_entry in "$_q_i_target"/* "$_q_i_target"/.[!.]* "$_q_i_target"/..?*; do
        if [ -e "$_q_i_entry" ] || [ -L "$_q_i_entry" ]; then
          _q_i_nonempty=1
          break
        fi
      done
      [ "$_q_i_nonempty" -eq 0 ] || _q_die err_install_target_occupied 2 "$_q_i_target"
    fi
  fi

  # Preflight every shipped asset before init can mutate the vault.
  _q_i_claude_source="$_q_HOME/adapters/claude-code.json"
  if [ ! -f "$_q_i_claude_source" ] || [ ! -r "$_q_i_claude_source" ]; then
    _q_die err_install_claude_source 2 "$_q_i_claude_source"
  fi
  _q_i_omp_source="$_q_HOME/adapters/omp/hooks/pre/knotlog.ts"
  if [ ! -f "$_q_i_omp_source" ] || [ ! -r "$_q_i_omp_source" ]; then
    _q_die err_install_asset_source 2 "$_q_i_omp_source"
  fi
  _q_i_icon_source="$_q_HOME/icon/Knotlog.png"
  if [ ! -f "$_q_i_icon_source" ] || [ ! -r "$_q_i_icon_source" ]; then
    _q_die err_install_asset_source 2 "$_q_i_icon_source"
  fi
  _q_i_ico_source="$_q_HOME/icon/Knotlog.ico"
  if [ ! -f "$_q_i_ico_source" ] || [ ! -r "$_q_i_ico_source" ]; then
    _q_die err_install_asset_source 2 "$_q_i_ico_source"
  fi
  _q_i_repair_source="$_q_HOME/repair-hooks"
  _q_i_repair_ps_source="$_q_HOME/repair-hooks.ps1"
  _q_i_repair_awk_source="$_q_HOME/lib/repair.awk"
  _q_i_metadata_awk_source="$_q_HOME/lib/metadata.awk"
  _q_i_hook_source="$_q_HOME/hooks/pre-commit"
  for _q_i_asset in "$_q_i_repair_source" "$_q_i_repair_ps_source" "$_q_i_repair_awk_source" "$_q_i_metadata_awk_source" "$_q_i_hook_source"; do
    if [ ! -f "$_q_i_asset" ] || [ ! -r "$_q_i_asset" ]; then
      _q_die err_install_asset_source 2 "$_q_i_asset"
    fi
  done

  _q_i_claude_dest="$_q_i_target/.claude/settings.json"
  _q_i_claude_state=copy
  if [ -e "$_q_i_claude_dest" ] || [ -L "$_q_i_claude_dest" ]; then
    if cmp -s "$_q_i_claude_source" "$_q_i_claude_dest"; then
      _q_i_claude_state=ready
    else
      _q_i_claude_state=preserved
    fi
  elif { [ -e "$_q_i_target/.claude" ] || [ -L "$_q_i_target/.claude" ]; } &&
       [ ! -d "$_q_i_target/.claude" ]; then
    _q_die err_install_claude_parent 2 "$_q_i_target/.claude"
  fi

  _q_i_link_same=0
  _q_i_link=
  if [ "$_q_i_no_link" -eq 0 ]; then
    # Select exactly the first non-empty existing writable PATH entry.
    _q_i_path=${PATH:-}
    _q_i_bindir=
    while :; do
      case "$_q_i_path" in
        *:*)
          _q_i_entry=${_q_i_path%%:*}
          _q_i_path=${_q_i_path#*:}
          _q_i_more=1
          ;;
        *)
          _q_i_entry=$_q_i_path
          _q_i_path=
          _q_i_more=0
          ;;
      esac
      if [ -n "$_q_i_entry" ] && [ -d "$_q_i_entry" ] && [ -w "$_q_i_entry" ]; then
        _q_i_bindir=$(CDPATH='' cd -- "$_q_i_entry" && pwd -P)
        break
      fi
      [ "$_q_i_more" -eq 1 ] || break
    done
    [ -n "$_q_i_bindir" ] || _q_die err_install_no_path 2

    _q_i_source=$(_q_resolve_path "$_q_HOME/knotlog")
    if [ ! -f "$_q_i_source" ] || [ ! -x "$_q_i_source" ]; then
      _q_die err_install_source 2 "$_q_i_source"
    fi
    _q_i_link="$_q_i_bindir/knotlog"
    if [ -L "$_q_i_link" ]; then
      _q_i_link_resolved=$(_q_resolve_path "$_q_i_link" 2>/dev/null || true)
      if [ -f "$_q_i_link" ] &&
         [ -x "$_q_i_link" ] &&
         [ "$_q_i_link_resolved" = "$_q_i_source" ]; then
        _q_i_link_same=1
      else
        # A foreign symlink may be replaced (never its target): --force, or a
        # yes on an interactive install; otherwise refuse and name the remedy.
        # shellcheck disable=SC2012
        # (ls: find has no portable link-target print)
        _q_i_tgt=$(ls -ld "$_q_i_link" | sed 's/.* -> //')
        if [ "$_q_i_force" -eq 1 ]; then
          _q_i_link_replace=1
        elif [ "$_q_i_interactive" -eq 1 ]; then
          _q_install_busy_stop
          # shellcheck disable=SC2059
          printf "$(_q_msg install_ask_link_replace) " "$_q_i_link" "$_q_i_tgt"
          IFS= read -r _q_i_ans || _q_i_ans=
          case $_q_i_ans in
            y | Y | yes | Yes | YES) _q_i_link_replace=1 ;;
          esac
          _q_install_busy_start
        fi
        [ "$_q_i_link_replace" -eq 1 ] || _q_die err_install_link_symlink 2 "$_q_i_link" "$_q_i_tgt"
      fi
    elif [ -e "$_q_i_link" ]; then
      _q_die err_install_link_file 2 "$_q_i_link"
    fi

    if [ "$_q_i_link_same" -eq 0 ]; then
      _q_i_probe="$_q_i_link.quipu-link-test-$$"
      if [ -e "$_q_i_probe" ] || [ -L "$_q_i_probe" ]; then
        _q_die err_install_link_occupied 2 "$_q_i_probe"
      fi
      if ! _q_create_verified_link "$_q_i_source" "$_q_i_probe"; then
        _q_die_install_link "$_q_i_probe"
      fi
      if ! rm -f -- "$_q_i_probe"; then
        _q_die_install_link "$_q_i_probe"
      fi
    fi
  fi

  set --
  [ "$_q_i_plain" -eq 0 ] || set -- "$@" --plain
  # The git default applies to a vault install CREATES. Reinstalling over an
  # existing non-repository vault must not quietly convert it: that vault is
  # already the user's, they may have kept it outside git on purpose, and a
  # reinstall is not the moment to decide otherwise. Explicit `--git` still
  # converts, explicit `--no-git` still refuses.
  if [ "$_q_i_git" -eq 1 ] && [ "$_q_i_git_explicit" -eq 0 ] && [ "$_q_i_fresh" -eq 0 ]; then
    _q_i_git=0
  fi
  # Skip --git when git is not on PATH: init's `git init` call is unguarded,
  # so under `set -e` a machine without git would have its install killed by a
  # default it never asked for. init still prints its "secret gate not
  # installed" line, so the user is told rather than left guessing.
  if [ "$_q_i_git" -eq 1 ] && command -v git >/dev/null 2>&1; then
    set -- "$@" --git
  fi
  set -- "$@" --no-prompt
  [ "$_q_i_lang_set" -eq 0 ] || set -- "$@" --lang "$_q_i_lang"
  [ "$_q_i_fresh" -eq 0 ] || set -- "$@" --layout "$_q_i_layout"
  set -- "$@" --user "$_q_i_user"
  [ "$_q_i_companion_set" -eq 0 ] || set -- "$@" --companion "$_q_i_companion"
  [ "$_q_i_purpose_set" -eq 0 ] || set -- "$@" --purpose "$_q_i_purpose"
  [ "$_q_i_tone_set" -eq 0 ] || set -- "$@" --tone "$_q_i_tone"
  [ -z "$_q_i_flair" ] || set -- "$@" --flair "$_q_i_flair"

  QUIPU_INTERNAL_INSTALL_QUIET=1 QUIPU_VAULT="$_q_i_target" _q_cmd_init "$@"

  if [ "$_q_i_claude_state" = copy ]; then
    mkdir -p "$_q_i_target/.claude"
    cp -- "$_q_i_claude_source" "$_q_i_claude_dest"
    _q_i_claude_state=ready
  fi
  if ! cmp -s "$_q_i_repair_source" "$_q_i_target/repair-hooks"; then
    cp -- "$_q_i_repair_source" "$_q_i_target/repair-hooks"
  fi
  if ! cmp -s "$_q_i_repair_ps_source" "$_q_i_target/repair-hooks.ps1"; then
    cp -- "$_q_i_repair_ps_source" "$_q_i_target/repair-hooks.ps1"
  fi
  chmod +x "$_q_i_target/repair-hooks"
  mkdir -p "$_q_i_target/.omp/hooks/pre"
  if ! cmp -s "$_q_i_omp_source" "$_q_i_target/.omp/hooks/pre/knotlog.ts"; then
    cp -- "$_q_i_omp_source" "$_q_i_target/.omp/hooks/pre/knotlog.ts"
  fi
  mkdir -p "$_q_i_target/.icon"
  if ! cmp -s "$_q_i_icon_source" "$_q_i_target/.icon/knotlog.png"; then
    cp -- "$_q_i_icon_source" "$_q_i_target/.icon/knotlog.png"
  fi
  if ! cmp -s "$_q_i_ico_source" "$_q_i_target/.icon/Knotlog.ico"; then
    cp -- "$_q_i_ico_source" "$_q_i_target/.icon/Knotlog.ico"
  fi
  {
    printf '%s\n' '[Desktop Entry]'
    printf '%s\n' 'Type=Directory'
    printf 'Icon=%s/.icon/knotlog.png\n' "$_q_i_target"
  } > "$_q_i_target/.directory"

  if [ "$_q_i_no_link" -eq 0 ] && [ "$_q_i_link_same" -eq 0 ]; then
    [ "$_q_i_link_replace" -eq 0 ] || rm -f -- "$_q_i_link"
    if ! _q_create_verified_link "$_q_i_source" "$_q_i_link"; then
      _q_die_install_link "$_q_i_link"
    fi
  fi

  # Folder-icon metadata (.directory Icon=, desktop.ini) is cosmetic —
  # nothing functional depends on it and `doctor` never checks it. Run it
  # last and let it fail soft: a broken metadata.awk must never cost the
  # user the vault or the `quipu` command that the steps above just built.
  _q_i_metadata_ok=1
  _q_i_repair_err=$(sh "$_q_i_target/repair-hooks" --knotlog "$_q_HOME" --metadata-only 2>&1 >/dev/null) || {
    _q_i_metadata_ok=0
    # shellcheck disable=SC2059
    printf "$(_q_msg warn_install_metadata_failed)\n" "$_q_i_repair_err" >&2
  }

  _q_install_busy_stop

  # Screen cleanup (wizard UX round 2): the pages cleared the terminal
  # before each step; the final screen gets the same treatment so the
  # closing block + summary start on clean ground -- same [ -t 1 ] rule as
  # _q_install_page, never on a pipe.
  if [ -t 1 ]; then
    awk 'BEGIN { printf "%c[2J%c[H", 27, 27 }'
  fi

  # Closing screen: the green title only on a real terminal (same gate as
  # the animation) -- the raw escape is never emitted outside that gate, so
  # a terminal without VT support can never show garbage bytes. Everything
  # else is plain text in both branches.
  if _q_install_tty && [ -z "${NO_COLOR:-}" ]; then
    printf '\033[32m%s\033[0m\n' "$(_q_msg install_done_title)"
  else
    _q_msg install_done_title
  fi
  printf '\n'
  _q_msg install_done_waiting
  printf '\n'
  # shellcheck disable=SC2059
  printf "$(_q_msg install_done_body_1)\n" "$_q_i_target"
  _q_msg install_done_body_2
  printf '\n'

  # Grouped summary: done items go under their heading, anything not done
  # under Skipped with its reason (and a fix line when one command fixes it).
  _q_sum_vault=
  _q_sum_hooks=
  _q_sum_safety=
  _q_sum_skipped=
  _q_sum_color
  if [ "$_q_i_fresh" -eq 1 ]; then
    # shellcheck disable=SC2059
    _q_sum_ok vault "$(printf "$(_q_msg install_summary_vault_created)" "$_q_i_target")"
  else
    # shellcheck disable=SC2059
    _q_sum_ok vault "$(printf "$(_q_msg install_summary_vault_existing)" "$_q_i_target")"
  fi
  if [ "$_q_i_no_link" -eq 1 ]; then
    # install.ps1 passes --no-link on Windows; elsewhere it is the user's flag.
    case $(uname -s 2>/dev/null) in
      MINGW* | MSYS* | CYGWIN*) _q_sum_skip "$(_q_msg install_summary_command_skipped)" ;;
      *) _q_sum_skip "$(_q_msg install_summary_command_nolink)" ;;
    esac
  elif [ "$_q_i_link_same" -eq 1 ]; then
    # shellcheck disable=SC2059
    _q_sum_ok vault "$(printf "$(_q_msg install_summary_command_existing)" "$_q_i_link")"
  else
    # shellcheck disable=SC2059
    _q_sum_ok vault "$(printf "$(_q_msg install_summary_command_linked)" "$_q_i_link")"
  fi
  if [ "$_q_i_claude_state" = preserved ]; then
    # shellcheck disable=SC2059
    _q_sum_skip "$(printf "$(_q_msg install_summary_claude_preserved)" "$_q_i_claude_dest" "$_q_i_claude_source")"
  else
    # shellcheck disable=SC2059
    _q_sum_ok hooks "$(printf "$(_q_msg install_summary_claude_ready)" "$_q_i_claude_dest")"
  fi
  # shellcheck disable=SC2059
  _q_sum_ok hooks "$(printf "$(_q_msg install_summary_omp_ready)" "$_q_i_target/.omp/hooks/pre/knotlog.ts")"
  # B1: sır kapanı — kurulum, kasa git deposuysa hook'u bağlamıştır;
  # değilse hataya düşmeden yol gösteren satır basılır.
  case "${_q_hooks_state:-none}" in
    installed) _q_sum_ok safety "$(_q_msg hooks_installed)" ;;
    current) _q_sum_ok safety "$(_q_msg hooks_current)" ;;
    kept) _q_sum_skip "$(_q_msg hooks_kept)" ;;
    *) _q_sum_skip "$(_q_msg hooks_none)" ;;
  esac
  # Baseline commit last, once every integration above is on disk, so the
  # vault's first commit is the whole finished vault rather than init's half.
  _q_init_baseline "$_q_i_target"
  case "${_q_baseline_state:-none}" in
    made) _q_sum_ok vault "$(_q_msg init_commit)" ;;
    skip) _q_sum_skip "$(_q_msg init_commit_skip)" "$(_q_msg install_summary_fix_git)" ;;
  esac
  if [ "$_q_i_metadata_ok" -eq 1 ]; then
    # shellcheck disable=SC2059
    _q_sum_ok vault "$(printf "$(_q_msg install_summary_icon_ready)" "$_q_i_target/.directory")"
  else
    # shellcheck disable=SC2059
    _q_sum_skip "$(printf "$(_q_msg install_summary_icon_failed)" "$_q_i_target/.directory")"
  fi
  # Clients found on this machine but not wired into the vault: a hint with the
  # remedy, never wired automatically.
  if { command -v opencode >/dev/null 2>&1 || [ -x "$HOME/.opencode/bin/opencode" ]; } &&
    [ ! -f "$_q_i_target/.opencode/plugins/knotlog.js" ]; then
    _q_sum_skip "$(_q_msg install_summary_opencode_off)" "$(_q_msg install_summary_fix_opencode)"
  fi
  if { command -v devin-desktop >/dev/null 2>&1 || command -v windsurf >/dev/null 2>&1; } &&
    [ ! -f "$_q_i_target/.devin/hooks.json" ]; then
    _q_sum_skip "$(_q_msg install_summary_windsurf_off)" "$(_q_msg install_summary_fix_windsurf)"
  fi
  _q_sum_print
  printf '\n'
  printf '%s\n' "$(_q_msg install_summary_next)"
  printf '%s\n' "$(_q_msg install_summary_help)"
}

_q_is_quipu_checkout() {
  # A PATH entry named `quipu` is only ours if it resolves into a real Quipu
  # checkout. Name alone is not proof -- another tool may own that name, and
  # uninstall must never delete a stranger's binary. The checkout markers are
  # ASCII-only on purpose (PLAN 4.11) and are the same files _q_HOME needs.
  _q_iqc_target=$1
  [ -f "$_q_iqc_target" ] || return 1
  _q_iqc_dir=$(dirname -- "$_q_iqc_target")
  [ -f "$_q_iqc_dir/lib/jsonfield.awk" ] || return 1
  [ -f "$_q_iqc_dir/i18n/en.txt" ] || return 1
  return 0
}

_q_cmd_uninstall() {
  _q_u_dry=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) _q_u_dry=1; shift ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_uninstall_extra_arg 2 "$1" ;;
    esac
  done

  # Never reuse install's "first writable PATH dir" heuristic here: PATH may
  # have changed since install, and the link can sit in any entry. Scan them
  # all and act only on entries we can prove are ours.
  _q_u_removed=0
  _q_u_kept=0
  _q_u_path=${PATH:-}
  while :; do
    case "$_q_u_path" in
      *:*)
        _q_u_entry=${_q_u_path%%:*}
        _q_u_path=${_q_u_path#*:}
        _q_u_more=1
        ;;
      *)
        _q_u_entry=$_q_u_path
        _q_u_path=
        _q_u_more=0
        ;;
    esac
    if [ -n "$_q_u_entry" ] && [ -d "$_q_u_entry" ]; then
      # v3 links the command as knotlog; a v2 install linked it as quipu,
      # so both names count.
      for _q_u_name in knotlog quipu; do
        _q_u_cand="$_q_u_entry/$_q_u_name"
        if [ -L "$_q_u_cand" ]; then
          _q_u_target=$(_q_resolve_path "$_q_u_cand" 2>/dev/null || true)
          if [ -n "$_q_u_target" ] && _q_is_quipu_checkout "$_q_u_target"; then
            if [ "$_q_u_dry" -eq 1 ]; then
              # shellcheck disable=SC2059
              printf "$(_q_msg uninstall_would_remove)\n" "$_q_u_cand"
              _q_u_removed=$((_q_u_removed + 1))
            elif rm -f -- "$_q_u_cand"; then
              # shellcheck disable=SC2059
              printf "$(_q_msg uninstall_removed)\n" "$_q_u_cand"
              _q_u_removed=$((_q_u_removed + 1))
            else
              # shellcheck disable=SC2059
              printf "$(_q_msg uninstall_remove_failed)\n" "$_q_u_cand" >&2
            fi
          else
            # A symlink named `quipu` that resolves outside a Quipu checkout is
            # someone else's command wearing our name. Report it, never remove
            # it -- and say so, or the user is left wondering why `quipu` still
            # runs after what looked like a clean uninstall.
            # shellcheck disable=SC2059
            printf "$(_q_msg uninstall_kept_not_link)\n" "$_q_u_cand"
            _q_u_kept=$((_q_u_kept + 1))
          fi
        elif [ -e "$_q_u_cand" ]; then
          # A plain file named `quipu` on PATH is either the checkout itself or
          # someone else's command. Report it; deleting it is the user's call.
          # shellcheck disable=SC2059
          printf "$(_q_msg uninstall_kept_not_link)\n" "$_q_u_cand"
          _q_u_kept=$((_q_u_kept + 1))
        fi
      done
    fi
    [ "$_q_u_more" -eq 1 ] || break
  done

  if [ "$_q_u_removed" -eq 0 ] && [ "$_q_u_kept" -eq 0 ]; then
    _q_msg uninstall_no_command
  fi

  # Windows installs come from install.ps1, which writes shims under
  # %LOCALAPPDATA%\Knotlog\bin and edits the user PATH -- neither is a POSIX
  # symlink, so nothing above can see them. Point at the matching remover.
  if [ -n "${LOCALAPPDATA:-}" ] || [ -n "${USERPROFILE:-}" ]; then
    _q_msg uninstall_windows_note
  fi

  # The vault is the user's notes. uninstall never touches it -- it reports
  # where it is and what Quipu left inside, so removal stays a deliberate act.
  _q_u_vault=$(_q_vault)
  if [ -n "$_q_u_vault" ] && [ -d "$_q_u_vault" ]; then
    # shellcheck disable=SC2059
    printf "$(_q_msg uninstall_vault_kept)\n" "$_q_u_vault"
    _q_u_left=
    # .githooks and .gitignore joined the list when install started making the
    # vault a git repository: under-reporting what Quipu left behind is the
    # one thing this section exists to prevent. `.git` itself is deliberately
    # absent -- that is the user's history, not Quipu's leftovers.
    for _q_u_item in .claude .omp .icon .directory desktop.ini repair-hooks repair-hooks.ps1 .githooks .gitignore; do
      if [ -e "$_q_u_vault/$_q_u_item" ]; then
        _q_u_left="$_q_u_left $_q_u_item"
      fi
    done
    if [ -n "$_q_u_left" ]; then
      # shellcheck disable=SC2059
      printf "$(_q_msg uninstall_vault_contains)\n" "${_q_u_left# }"
    fi
    # shellcheck disable=SC2059
    printf "$(_q_msg uninstall_vault_hint)\n" "$_q_u_vault"
  else
    _q_msg uninstall_vault_unknown
  fi
}

# ---- update -----------------------------------------------------------------

_q_update_fetch() {
  # $1 = url; prints the response body on stdout, returns non-zero (from
  # curl/wget's own exit code, or 1 when neither exists) on any failure.
  # Same curl-then-wget shape as install.sh's _q_fetch (B7) -- reimplemented
  # here rather than sourced from install.sh, because install.sh's security
  # model is that EVERY statement lives inside its own main() (install.sh:
  # 12-19: a download truncated mid-stream must leave main undefined and
  # never called); sourcing it from a second file would put its statements
  # under this script's top level instead and break that guarantee.
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -- "$1" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- -- "$1" 2>/dev/null
  else
    return 1
  fi
}

_q_semver_lt() {
  # $1 = a, $2 = b; true (exit 0) iff a<b, compared component-by-component
  # as numbers. A plain string/sort compare gets "2.9.0" vs "2.10.0"
  # backwards (10 sorts before 9) -- exactly the trap this exists to avoid.
  # Missing/non-numeric components count as 0, so "2.7" reads as "2.7.0".
  awk -v a="$1" -v b="$2" '
    function part(v, i,   n, arr) {
      n = split(v, arr, ".")
      if (i > n) return 0
      return arr[i] + 0
    }
    BEGIN {
      for (i = 1; i <= 3; i++) {
        pa = part(a, i); pb = part(b, i)
        if (pa < pb) exit 0
        if (pa > pb) exit 1
      }
      exit 1
    }
  '
}

_q_update_paths() {
  # Sets _q_up_staging / _q_up_backup from $_q_HOME -- fixed, PID-less names
  # right next to the checkout (same filesystem as $_q_HOME, so the final
  # `mv` in _q_update_apply_tarball is atomic; see install.sh:76-81 for the
  # same reasoning applied to a fresh install). Fixed names (not $$-suffixed
  # like install.sh's own staging dir) are the point: a NEXT invocation of
  # `update` or `doctor` must be able to find a staging dir an earlier,
  # interrupted run left behind, which a PID-scoped name would hide.
  _q_up_parent=$(dirname -- "$_q_HOME")
  _q_up_base=$(basename -- "$_q_HOME")
  _q_up_staging="$_q_up_parent/$_q_up_base.quipu-update-staging"
  _q_up_backup="$_q_up_parent/$_q_up_base.knotlog-previous"
  # Older backups for the rollback chain (N=3 fixed, no setting): .2 is one
  # update older than .knotlog-previous, .3 is two updates older.
  _q_up_backup2="$_q_up_backup.2"
  _q_up_backup3="$_q_up_backup.3"
}

_q_update_legacy_backups() {
  # Backups written before the Quipu -> Knotlog rename sit under the old
  # .quipu-previous names. If only the old chain exists, rename it to the
  # new names so update and rollback see one chain; if the new chain exists
  # the old one is left untouched. Called by apply/rollback, never by doctor.
  _q_lg_old="$_q_up_parent/$_q_up_base.quipu-previous"
  [ -e "$_q_lg_old" ] && [ ! -e "$_q_up_backup" ] || return 0
  for _q_lg_s in "" .2 .3; do
    [ ! -e "$_q_lg_old$_q_lg_s" ] || mv -- "$_q_lg_old$_q_lg_s" "$_q_up_backup$_q_lg_s" || _q_die err_update_rotate_failed 2 "$_q_lg_old$_q_lg_s"
  done
}

_q_update_download() {
  # $1 = url, $2 = destination file. Same curl-then-wget shape as
  # _q_update_fetch above and install.sh's _q_fetch (B7), but writes to a
  # file instead of stdout -- a release tarball is binary, so it can't go
  # through a shell variable the way the release JSON does.
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -- "$1" > "$2" 2>/dev/null
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$2" -- "$1" 2>/dev/null
  else
    return 1
  fi
}

_q_update_find_quipu() {
  # Print the path of the extracted executable, or nothing. Ported from
  # install.sh's _q_find_quipu (same glob-and-grep shape) rather than
  # sourced -- install.sh's single-file security model (a truncated
  # download must leave main() undefined and uncalled) only holds if it is
  # never `.`/sourced into another script. $1 = extracted root, $2 = anchor.
  for _q_uq_f in "$1/knotlog" "$1"/*/knotlog; do
    # LC_ALL=C: byte-level fixed-string search independent of caller locale
    if [ -f "$_q_uq_f" ] && [ -x "$_q_uq_f" ] && LC_ALL=C grep -qF -- "$2" "$_q_uq_f"; then
      printf '%s\n' "$_q_uq_f"
      return 0
    fi
  done
  return 1
}

_q_update_unrotate() {
  # Undo the rotation in _q_update_apply_tarball when the checkout was NOT
  # swapped: .knotlog-previous (now in .2) goes back first, then .3 back to .2.
  # Only moves that actually happened are undone (_q_up_rotp / _q_up_rot2).
  # The oldest backup the rotation dropped (.3) is not restored.
  if [ "$_q_up_rotp" -eq 1 ]; then
    mv -- "$_q_up_backup2" "$_q_up_backup" || _q_die err_update_rotate_failed 2 "$_q_up_backup2"
  fi
  if [ "$_q_up_rot2" -eq 1 ]; then
    mv -- "$_q_up_backup3" "$_q_up_backup2" || _q_die err_update_rotate_failed 2 "$_q_up_backup3"
  fi
}

_q_update_trampoline() {
  # Windows (Git Bash/MSYS) refuses to rename a directory while a running sh
  # script inside it is open, so the `mv` of $_q_HOME in
  # _q_update_apply_tarball fails whenever the script doing the update is the
  # checkout's own `quipu`. Re-run the update from a copy outside the
  # checkout instead: `exec` replaces this process, so the checkout's script
  # is no longer open. Skipped when the running script is not under $_q_HOME,
  # and in the copy itself (QUIPU_UPDATE_TRAMPOLINED=1) so it never loops.
  [ -z "${QUIPU_UPDATE_TRAMPOLINED:-}" ] || return 0
  _q_tr_self=$(_q_resolve_path "$0") || return 0
  _q_tr_home=$(CDPATH='' cd -- "$_q_HOME" && pwd -P) || return 0
  case $_q_tr_self in
    "$_q_tr_home"/*) : ;;
    *) return 0 ;;
  esac
  _q_tr_dir=${TMPDIR:-/tmp}
  # Copies from earlier runs have exited and are removed here. A copy that
  # is still running cannot be deleted on Windows; rm -f just leaves it.
  rm -f -- "$_q_tr_dir"/quipu-update-* 2>/dev/null || true
  _q_tr_copy=$(mktemp "$_q_tr_dir/quipu-update-XXXXXX") || _q_die err_update_trampoline_failed 2 "$_q_tr_dir"
  cp -- "$_q_tr_self" "$_q_tr_copy" || _q_die err_update_trampoline_failed 2 "$_q_tr_copy"
  export QUIPU_HOME="$_q_tr_home"
  # The copy re-runs the KNOTLOG_* mapping; a user's KNOTLOG_HOME would
  # overwrite the home pinned on the line above.
  unset KNOTLOG_HOME
  export QUIPU_UPDATE_TRAMPOLINED=1
  if [ "$_q_up_noverify" -eq 1 ]; then
    exec sh "$_q_tr_copy" update --apply --no-verify
  fi
  exec sh "$_q_tr_copy" update --apply
}

_q_update_hashtool() {
  # Sets _q_up_hasher to the first SHA-256 tool found (empty when none).
  _q_up_hasher=
  for _q_ht in sha256sum shasum openssl; do
    if command -v "$_q_ht" >/dev/null 2>&1; then _q_up_hasher=$_q_ht; return 0; fi
  done
}

_q_update_sha256() {
  # $1 = file; prints its lowercase SHA-256 hex (openssl prints it last).
  case $_q_up_hasher in
    sha256sum) sha256sum -- "$1" | awk '{print tolower($1)}' ;;
    shasum) shasum -a 256 -- "$1" | awk '{print tolower($1)}' ;;
    *) openssl dgst -sha256 "$1" | awk '{print tolower($NF)}' ;;
  esac
}

_q_update_preflight() {
  # Everything knowable before a byte is downloaded: leftovers of an
  # interrupted update/rollback (fixed-name staging and rollback-tmp dirs),
  # the parent's writability (the swap renames $_q_HOME inside it), a SHA-256
  # tool, and free space against twice the checkout size (skipped silently
  # when du/df print nothing numeric).
  _q_update_paths
  [ ! -e "$_q_up_staging" ] || _q_die err_update_staging_stale 2 "$_q_up_staging"
  _q_pf_ro="$_q_up_parent/$_q_up_base.quipu-rollback-tmp"
  [ ! -e "$_q_pf_ro" ] || _q_die err_update_rollback_stale 2 "$_q_pf_ro"
  [ -w "$_q_up_parent" ] || _q_die err_update_not_writable 2 "$_q_up_parent"
  _q_update_hashtool
  if [ -z "$_q_up_hasher" ] && [ "$_q_up_noverify" -eq 0 ]; then _q_die err_update_no_hash_tool 2; fi
  _q_pf_need=$(du -sk "$_q_HOME" 2>/dev/null | awk '{print $1}')
  _q_pf_free=$(df -P -k "$_q_up_parent" 2>/dev/null | awk 'NR == 2 {print $4}')
  case $_q_pf_need in ''|*[!0-9]*) return 0 ;; esac
  case $_q_pf_free in ''|*[!0-9]*) return 0 ;; esac
  if [ "$_q_pf_free" -lt $((_q_pf_need * 2)) ]; then
    _q_die err_update_no_space 2 "$_q_up_parent" "$((_q_pf_need * 2))" "$_q_pf_free"
  fi
}

_q_update_verify_sha() {
  # $1 = package URL. Fetches "$1.sha256" and compares it with the downloaded
  # package BEFORE anything is extracted. Format "<64 hex>  <filename>"; the
  # filename must be the package's own, so a hash file made for another
  # package cannot vouch for this one. CR is stripped (Windows-made files).
  _q_vs_name=${1##*/}
  _q_update_download "$1.sha256" "$_q_up_staging/sha256" || _q_die err_update_sha_missing 2 "$1.sha256"
  _q_vs_line=$(tr -d "$(printf '\r')" < "$_q_up_staging/sha256" | head -n 1)
  _q_vs_want=$(printf '%s\n' "$_q_vs_line" | awk '{print tolower($1)}')
  _q_vs_file=$(printf '%s\n' "$_q_vs_line" | awk '{n = $2; if (substr(n, 1, 1) == "*") n = substr(n, 2); print n}')
  case $_q_vs_want in
    ''|*[!0-9a-f]*) _q_die err_update_sha_missing 2 "$1.sha256" ;;
  esac
  [ "${#_q_vs_want}" -eq 64 ] || _q_die err_update_sha_missing 2 "$1.sha256"
  [ "$_q_vs_file" = "$_q_vs_name" ] || _q_die err_update_sha_name 2 "$_q_vs_file" "$_q_vs_name"
  _q_vs_got=$(_q_update_sha256 "$_q_up_staging/tarball")
  [ "$_q_vs_got" = "$_q_vs_want" ] || _q_die err_update_sha_mismatch 2 "$_q_vs_name" "$_q_vs_want" "$_q_vs_got"
}

_q_update_apply_tarball() {
  # $1 = tarball URL. Stages, extracts, verifies, then atomically swaps
  # $_q_HOME for the extracted tree. Caller (_q_cmd_update) has already
  # called _q_update_paths and confirmed $_q_up_staging does not exist yet
  # (a leftover staging dir means an earlier run was interrupted here --
  # that is reported, never silently reused/overwritten).
  _q_update_trampoline
  _q_update_legacy_backups
  mkdir -p -- "$_q_up_staging/src" || _q_die err_update_staging_mkdir 2 "$_q_up_staging"
  trap 'rm -rf -- "$_q_up_staging"' EXIT HUP INT TERM

  if ! _q_update_download "$1" "$_q_up_staging/tarball" || [ ! -s "$_q_up_staging/tarball" ]; then
    _q_die err_update_download_failed 2 "$1"
  fi
  [ "$_q_up_noverify" -eq 1 ] || _q_update_verify_sha "$1"
  if ! tar -xzf "$_q_up_staging/tarball" -C "$_q_up_staging/src" 2>/dev/null; then
    _q_die err_update_extract_failed 2 "$1"
  fi

  # Same text anchor install.sh guards a fresh install with (install.sh:34-36):
  # the --version line is stable text every release carries, so grepping for
  # it here -- never running the downloaded script -- is the content check.
  _q_up_anchor="--version) printf 'knotlog "
  if ! _q_up_src=$(_q_update_find_quipu "$_q_up_staging/src" "$_q_up_anchor"); then
    _q_die err_update_verify_failed 2
  fi
  _q_up_src_dir=$(CDPATH='' cd -- "$(dirname -- "$_q_up_src")" && pwd)

  # Rollback chain, N=3 fixed: .knotlog-previous (newest) -> .2 -> .3 (oldest,
  # dropped here). Rotated BEFORE the swap so the .knotlog-previous slot is
  # free for the checkout that is about to move aside. A user edit made to
  # the checkout survives in whichever backup holds that version, for three
  # updates; the fourth update drops it.
  _q_up_rot2=0
  _q_up_rotp=0
  rm -rf -- "$_q_up_backup3"
  if [ -e "$_q_up_backup2" ]; then
    mv -- "$_q_up_backup2" "$_q_up_backup3" || { _q_update_unrotate; _q_die err_update_rotate_failed 2 "$_q_up_backup2"; }
    _q_up_rot2=1
  fi
  if [ -e "$_q_up_backup" ]; then
    mv -- "$_q_up_backup" "$_q_up_backup2" || { _q_update_unrotate; _q_die err_update_rotate_failed 2 "$_q_up_backup"; }
    _q_up_rotp=1
  fi
  # Between the two mv's below $_q_HOME is absent. An interrupt there (or a
  # failed second mv) must put the previous checkout back in place, not leave
  # only a backup behind: if $_q_HOME is gone and .knotlog-previous exists, move
  # it back; then drop the staging dir as before.
  trap '[ -e "$_q_HOME" ] || [ ! -e "$_q_up_backup" ] || mv -- "$_q_up_backup" "$_q_HOME"; rm -rf -- "$_q_up_staging"' EXIT HUP INT TERM
  mv -- "$_q_HOME" "$_q_up_backup" || { _q_update_unrotate; _q_die err_update_swap_failed 2 "$_q_HOME"; }
  mv -- "$_q_up_src_dir" "$_q_HOME" || _q_die err_update_swap_failed 2 "$_q_up_src_dir"
  rm -rf -- "$_q_up_staging"
  trap - EXIT HUP INT TERM
}

_q_update_apply_git() {
  # $1 = tag (e.g. v2.8.0). Git's own object store + working-tree update is
  # already atomic-enough for this checkout shape (G1's research note, Soru
  # 3) -- no staging/backup dance needed here, unlike the tarball path.
  # refs/tags/ prefix (not a bare tag name) so a tag string can never be
  # misread as a branch, a path, or a flag by `git checkout`.
  if ! ( cd "$_q_HOME" && git fetch --tags origin ) >/dev/null 2>&1; then
    _q_die err_update_git_fetch_failed 2 "$1"
  fi
  if ! ( cd "$_q_HOME" && git checkout "refs/tags/$1" ) >/dev/null 2>&1; then
    _q_die err_update_git_checkout_failed 2 "$1"
  fi
}

_q_cmd_update() {
  _q_up_check=0
  _q_up_apply=0
  _q_up_noverify=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --check) _q_up_check=1; shift ;;
      --apply) _q_up_apply=1; shift ;;
      --no-verify) _q_up_noverify=1; shift ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_update_extra_arg 2 "$1" ;;
    esac
  done
  if [ "$_q_up_check" -eq 1 ] && [ "$_q_up_apply" -eq 1 ]; then
    _q_die err_update_conflicting_flags 2
  fi
  # A bare `quipu update` (neither flag) has always been rejected rather
  # than silently no-op'ing or silently doing real work -- that stays true
  # now that --apply exists too, exactly as it did when --check was the
  # only flag.
  [ "$_q_up_check" -eq 1 ] || [ "$_q_up_apply" -eq 1 ] || _q_die err_update_check_required 2

  # Two install shapes reach this line: a git clone (this repo checked out
  # with `git clone`, `.git` present in $_q_HOME) and a tarball checkout
  # (installed via install.sh, no `.git`). Both --check and --apply need to
  # know which one applies -- --check to name it, --apply to pick its update
  # strategy (atomic tarball swap vs. `git fetch`+checkout). `.git` is a
  # directory in a plain clone but a file in a worktree or submodule; -d
  # would send those to the tarball swap, so test for existence.
  if [ -e "$_q_HOME/.git" ]; then
    _q_up_kind=git
  else
    _q_up_kind=tarball
  fi

  # --apply on a tarball checkout: refuse up front if a staging dir from an
  # earlier, interrupted run is still there. Checked before the network
  # round-trip below so a stale staging dir is reported even when the
  # up-to-date/available check would otherwise succeed. (Not checked under
  # --check: that path stays read-only and unchanged from before --apply
  # existed; _q_doctor carries the same check for a passive, no-flags-needed
  # way to notice this.)
  if [ "$_q_up_apply" -eq 1 ] && [ "$_q_up_kind" = tarball ]; then
    _q_update_preflight
  fi

  # QUIPU_RELEASE_API_URL lets tests (and anyone else) point this at a
  # file:// fixture instead of the network -- same idea as install.sh's
  # GITHUB_RELEASE_URL override for the tarball download (B7).
  _q_up_api=${QUIPU_RELEASE_API_URL:-https://api.github.com/repos/MSelmanSonmez/Knotlog/releases/latest}
  _q_up_json=$(_q_update_fetch "$_q_up_api") || _q_die err_update_fetch_failed 2 "$_q_up_api"
  [ -n "$_q_up_json" ] || _q_die err_update_fetch_failed 2 "$_q_up_api"

  # GitHub's release JSON shape: {"tag_name": "v2.8.0", ...}. jsonfield.awk
  # is the project's no-jq JSON reader (lib/jsonemit.awk's counterpart for
  # reading); release.awk just asks it for one field.
  _q_up_latest=$(printf '%s\n' "$_q_up_json" | awk -f "$_q_HOME/lib/jsonfield.awk" -f "$_q_HOME/lib/release.awk")
  case $_q_up_latest in
    v*) _q_up_latest=${_q_up_latest#v} ;;
  esac
  [ -n "$_q_up_latest" ] || _q_die err_update_parse_failed 2 "$_q_up_api"
  # tag_name is the only thing read from the reply, and it is spliced into the
  # default download URL (.../archive/refs/tags/v<tag>.tar.gz) and into
  # `git checkout refs/tags/v<tag>`. A value with / ? # % : @ a space or a
  # newline could steer that URL to another repository or query, so anything
  # but a plain version-looking token is refused here, before any fetch.
  case $_q_up_latest in
    *[!0-9A-Za-z._+-]*) _q_die err_update_parse_failed 2 "$_q_up_api" ;;
  esac

  if _q_semver_lt "$_q_version" "$_q_up_latest"; then
    if [ "$_q_up_apply" -eq 1 ]; then
      if [ "$_q_up_kind" = tarball ]; then
        # QUIPU_UPDATE_TARBALL_URL lets tests point the actual download at a
        # file:// fixture, independent of the release-JSON fixture above --
        # same override shape as QUIPU_RELEASE_API_URL just above it. The
        # default is the release's own knotlog-<version>.tar.gz asset, not
        # GitHub's auto source archive: only an asset we build has a
        # .sha256 beside it (see .github/workflows/release.yml).
        _q_up_tarball_url=${QUIPU_UPDATE_TARBALL_URL:-https://github.com/MSelmanSonmez/Knotlog/releases/download/v$_q_up_latest/knotlog-$_q_up_latest.tar.gz}
        _q_update_apply_tarball "$_q_up_tarball_url"
      else
        _q_update_apply_git "v$_q_up_latest"
      fi
      # shellcheck disable=SC2059
      printf "$(_q_msg update_applied)\n" "$_q_version" "$_q_up_latest" "$_q_up_kind"
    else
      # shellcheck disable=SC2059
      printf "$(_q_msg update_available)\n" "$_q_version" "$_q_up_latest" "$_q_up_kind"
    fi
  else
    # shellcheck disable=SC2059
    printf "$(_q_msg update_noop)\n" "$_q_version" "$_q_up_kind"
  fi
}

# ---- rollback (G5: undo the last `quipu update --apply`) --------------------

_q_rollback_version_of() {
  # $1 = a checkout directory; prints its _q_version value (empty if the
  # script is missing or carries no such line). The script is knotlog, or
  # quipu in a pre-rename (v2) backup. Same anchor T-511 already relies on
  # (`_q_version=X.Y.Z`, one literal assignment, no spaces).
  _q_rv_s="$1/knotlog"
  [ -f "$_q_rv_s" ] || _q_rv_s="$1/quipu"
  sed -n 's/^_q_version=//p' "$_q_rv_s" 2>/dev/null | head -n 1
}

_q_rollback_tarball() {
  # Tarball checkout: _q_up_backup (_q_update_paths) is the exact pre-update
  # tree _q_update_apply_tarball moved aside. Up to three backups are kept
  # (.knotlog-previous, .2, .3); this restores the newest and shifts the rest
  # back one step, so a second rollback reaches the next older version. No
  # backup -> nothing to roll back to; say so plainly (bitis tanimi #2),
  # never a silent no-op.
  _q_update_paths
  _q_update_legacy_backups
  if [ ! -e "$_q_up_backup" ]; then
    _q_die err_rollback_no_backup 2 "$_q_up_backup"
  fi

  # Same fixed-name safety-net shape as _q_update_apply_tarball's own staging
  # dir: a rollback interrupted between the two mv's below must be visible on
  # the NEXT run, never silently reused or overwritten.
  _q_ro_tmp="$_q_up_parent/$_q_up_base.quipu-rollback-tmp"
  if [ -e "$_q_ro_tmp" ]; then
    _q_die err_rollback_tmp_stale 2 "$_q_ro_tmp"
  fi

  _q_ro_from=$(_q_rollback_version_of "$_q_HOME")
  _q_ro_to=$(_q_rollback_version_of "$_q_up_backup")

  # Never a bare overwrite: move the current (post-update) tree aside FIRST,
  # then move the backup into place. If the second mv fails, the trap below
  # puts the current tree back rather than leaving $_q_HOME missing.
  # $_q_HOME absent is a half-finished update (see _q_update_apply_tarball's
  # swap): the backup is then the only complete copy, so it goes straight
  # back into place with nothing to move aside.
  if [ -e "$_q_HOME" ]; then
    trap '[ -e "$_q_HOME" ] || [ ! -e "$_q_ro_tmp" ] || mv -- "$_q_ro_tmp" "$_q_HOME"' EXIT HUP INT TERM
    mv -- "$_q_HOME" "$_q_ro_tmp" || _q_die err_rollback_move_failed 2 "$_q_HOME"
  fi
  mv -- "$_q_up_backup" "$_q_HOME" || _q_die err_rollback_move_failed 2 "$_q_up_backup"

  # The moved-aside post-update tree is discarded, not kept as a new backup:
  # an update that has been undone must not leave a backup behind for itself.
  rm -rf -- "$_q_ro_tmp"
  trap - EXIT HUP INT TERM

  # Shift the chain back one step so consecutive rollbacks walk to older
  # versions: .2 becomes .knotlog-previous (the slot just emptied), .3 becomes .2.
  if [ -e "$_q_up_backup2" ]; then
    mv -- "$_q_up_backup2" "$_q_up_backup" || _q_die err_rollback_move_failed 2 "$_q_up_backup2"
  fi
  if [ -e "$_q_up_backup3" ]; then
    mv -- "$_q_up_backup3" "$_q_up_backup2" || _q_die err_rollback_move_failed 2 "$_q_up_backup3"
  fi

  # shellcheck disable=SC2059
  printf "$(_q_msg rollback_applied)\n" "$_q_ro_from" "$_q_ro_to" tarball
}

_q_rollback_git() {
  # Git-clone checkout: _q_update_apply_git keeps no backup directory (see
  # its own comment, quipu:3621-3626) -- git already remembers what was
  # checked out immediately before the last `git checkout` (the `@{-1}`
  # reflog shorthand, same thing `git checkout -` uses), so this reuses that
  # instead of inventing a second bookkeeping mechanism (G1 Soru 3; kept
  # deliberately simple, no extra state file). `git checkout <ref>` only
  # moves the working tree/HEAD -- reversible, unlike the `git reset --hard`
  # the plan explicitly forbids. A fresh clone that was never updated has no
  # such reflog entry, so `@{-1}` fails to resolve and this refuses cleanly
  # (bitis tanimi #2) instead of checking out something unrelated.
  if ! _q_ro_prev=$(cd "$_q_HOME" && git rev-parse --verify -q '@{-1}' 2>/dev/null); then
    _q_die err_rollback_no_previous_ref 2
  fi
  _q_ro_from=$(_q_rollback_version_of "$_q_HOME")
  if ! ( cd "$_q_HOME" && git checkout "$_q_ro_prev" ) >/dev/null 2>&1; then
    _q_die err_rollback_git_checkout_failed 2 "$_q_ro_prev"
  fi
  _q_ro_to=$(_q_rollback_version_of "$_q_HOME")
  # shellcheck disable=SC2059
  printf "$(_q_msg rollback_applied)\n" "$_q_ro_from" "$_q_ro_to" git
}

_q_cmd_rollback() {
  [ "$#" -eq 0 ] || _q_die err_rollback_extra_arg 2 "$1"
  if [ -e "$_q_HOME/.git" ]; then
    _q_rollback_git
  else
    _q_rollback_tarball
  fi
}

# ---- context ----------------------------------------------------------------

_q_ctx_text() {
  # Global setter (DZ-7): builds $_q_text (and $_q_log) for the session
  # context — activity + index + Threads.md (QUIPU_CTX_MAX bounded), no
  # stdout. The nudge block stays OUTSIDE (--json UserPromptSubmit only).
  # Caller sets $_q_v and $_q_limit first.
  _q_log="$_q_v/$_q_SD/activity.log"

  # B-K4: ctx_max resolved here, up front, instead of at its old call site
  # right before the threads section -- Fixed part A (activity) below needs
  # its own slice of the budget BEFORE the variable threads/rules/facts
  # sections claim theirs. Same config file, same read (_q_ctx_max), so
  # $_q_cm/$_q_max come out identical to the old later call; that old call
  # site now reuses $_q_max instead of recomputing it (search _q_max=$_q_cm
  # below).
  _q_ctx_max "$_q_v"
  _q_max=$_q_cm

  # Fixed part -1 (now): current date + time + weekday name, first line of
  # every context emission -- present even in a brand-new/empty vault, since
  # it names no vault state. Without it the model writing memory has no
  # idea what time it is and guesses (a real vault saw headings like
  # "## ~20:xx"); `date` is the only non-POSIX-sh tool touched here, staying
  # inside this project's zero-dependency rule. Weekday name is i18n data
  # (day_1..day_7, Monday=1 per POSIX `date +%u`), never a hardcoded English
  # array -- every user-visible string in this project comes from i18n.
  _q_now_date=$(date +%Y-%m-%d)
  _q_now_time=$(date +%H:%M)
  _q_now_dow=$(date +%u)
  case "$_q_now_dow" in
    1) _q_now_day=$(_q_msg day_1) ;;
    2) _q_now_day=$(_q_msg day_2) ;;
    3) _q_now_day=$(_q_msg day_3) ;;
    4) _q_now_day=$(_q_msg day_4) ;;
    5) _q_now_day=$(_q_msg day_5) ;;
    6) _q_now_day=$(_q_msg day_6) ;;
    7) _q_now_day=$(_q_msg day_7) ;;
    *) _q_now_day= ;;
  esac
  _q_nowfmt=$(_q_msg ctx_now)
  # ctx_now is the controlled i18n template (three %s: date, time, weekday);
  # all three values come from `date`/i18n, never free user text.
  # shellcheck disable=SC2059
  _q_now="$(printf "$_q_nowfmt" "$_q_now_date" "$_q_now_time" "$_q_now_day")
"

  # Fixed part 0 (identity): companion=/user= from config, prepended ahead
  # of everything else so the model sees who it and the user are on first
  # read, without depending on a separate file (e.g. companion.md) getting
  # opened. Same config-awk read pattern as _q_lang()/_q_fold_prof(). Absent
  # entirely when neither key is set in config -- matches existing tests
  # (vbridge etc.) that assume an identity-less vault emits no such line.
  #
  # Phrased as a second-person DIRECTIVE, not third-person data: an earlier
  # version emitted "identity: companion=Sumi, user=Ada" and models read
  # that as neutral info about the vault rather than an instruction to adopt
  # the companion name as their own (they kept introducing themselves as
  # "Claude Code"). Three separate i18n keys cover the three name
  # combinations that actually occur -- only "both"/"companion only" tell
  # the model who IT is; "user only" has no companion identity to assert, so
  # it stays plain info about who it's talking to.
  _q_id=
  if [ -f "$_q_v/$_q_SD/config" ]; then
    _q_id_user=$(awk -F= -v k=user '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    _q_id_comp=$(awk -F= -v k=companion '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    if [ -n "$_q_id_comp" ] && [ -n "$_q_id_user" ]; then
      # ctx_identity_both is the controlled i18n template (three %s: companion,
      # user, companion again); values come only from config's companion=/user=.
      # shellcheck disable=SC2059
      _q_id="$(printf "$(_q_msg ctx_identity_both)" "$_q_id_comp" "$_q_id_user" "$_q_id_comp")
"
    elif [ -n "$_q_id_comp" ]; then
      # shellcheck disable=SC2059
      _q_id="$(printf "$(_q_msg ctx_identity_companion_only)" "$_q_id_comp" "$_q_id_comp")
"
    elif [ -n "$_q_id_user" ]; then
      # shellcheck disable=SC2059
      _q_id="$(printf "$(_q_msg ctx_identity_user_only)" "$_q_id_user")
"
    fi
  fi

  # Fixed part 0b (purpose): purpose= from config, right after identity --
  # init --purpose currently writes this into the static knotlog:start block
  # (bridge_purpose), which lands in BOTH AGENTS.md and CLAUDE.md, byte-
  # identical (see the block.awk write further down) -- but that static
  # block is not quipu context's own output, so quipu context (and thus the
  # SessionStart hook) never carried it. Same config-awk read pattern as
  # identity above. Absent entirely when purpose= isn't set (FAZ 15 AB-8: an
  # unanswered purpose is a skipped line, never an invented placeholder).
  _q_purp=
  if [ -f "$_q_v/$_q_SD/config" ]; then
    _q_purp_val=$(awk -F= -v k=purpose '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    if [ -n "$_q_purp_val" ]; then
      # ctx_purpose is the controlled i18n template (one %s); _q_purp_val is
      # free text from config's purpose=, same trust boundary as bridge_purpose.
      # shellcheck disable=SC2059
      _q_purp="$(printf "$(_q_msg ctx_purpose)" "$_q_purp_val")
"
    fi
  fi

  # Fixed part 0c (tone): companion.md's Tone section body, right after
  # identity/purpose because it's SHORT (a few lines) and because the
  # variable-part sections below (threads/rules/facts) silently drop
  # whole when ctx_max pressure leaves no slack (C-16) -- a dropped tone
  # line would read as "the tone setting doesn't work" with the user
  # unable to tell why. Read from companion.md itself (via
  # _q_companion_path/_q_tone_extract above), not persona/<lang>.md
  # directly, so a hand-edited Tone section is what actually reaches the
  # model, not the shipped default.
  #
  # Unlike the facts section (B5's _q_facts_adopted gate, which withholds
  # an untouched seed because the seed is an empty skeleton), this injects
  # EVEN when companion.md is still the untouched init seed: measured
  # against a fresh vault, the seed's Tone bullets ("brief answers, no
  # filler, state assumptions instead of guessing") are meaningful default
  # behavior, not a placeholder waiting to be filled in -- there is
  # something worth injecting on day one. Absent entirely when
  # companion.md doesn't exist or carries no Tone heading: the same
  # silence the rules/facts sections keep for an absent file.
  #
  # Closes with an explicit priority note (ctx_tone_priority, i18n data):
  # a "warm" tone is never grounds to skip an approval gate --
  # Kurallar.md/Rules.md always outranks it.
  #
  # Tone-preset feature: config's tone= (a shipped tone/<lang>/<slug>.md
  # file) takes priority over companion.md's own Tone section; an unset or
  # invalid tone= falls back to companion.md exactly as before presets
  # existed (_q_tone_resolve above is the single place both paths are
  # decided, so this stays byte-identical for a vault that never sets
  # tone=).
  _q_style_build "$_q_v"

  # Fixed part A: activity section (tail lines + per-path digest table).
  _q_act=
  _q_add_act() {
    _q_act="${_q_act}${1}
"
  }
  _q_add_act "$(_q_msg ctx_activity)"
  if [ -s "$_q_log" ]; then
    _q_add_act "$(awk -v n="$_q_limit" '{ line[NR] = $0 } END { s = NR - n + 1; if (s < 1) s = 1; for (i = s; i <= NR; i++) print line[i] }' "$_q_log")"
    # $_q_act_head_lines protects everything added so far (header + the
    # already-bounded tail-lines block, at most $_q_limit lines) from the
    # cap below -- only the digest table appended next is croppable.
    _q_act_head_lines=$(printf '%s' "$_q_act" | LC_ALL=C wc -l | tr -d ' ')
    _q_add_act "$(awk -f "$_q_HOME/lib/digest.awk" "$_q_log")"
  else
    _q_add_act "$(_q_msg ctx_empty)"
    _q_act_head_lines=$(printf '%s' "$_q_act" | LC_ALL=C wc -l | tr -d ' ')
  fi

  # B-K4 (a): $_q_act joins the FIXED part of the budget ($_q_fixed below,
  # same as the pin/tone blocks) -- unlike threads/rules/facts, nothing
  # ever capped it. Konular-Butce-Tasmasi.md: activity.log's digest table
  # (one line per EVER-SEEN path) grew unbounded across sessions -- 52 of
  # 185 digest lines were one session's /tmp screenshot paths -- silently
  # eating the whole fixed budget and starving the threads section with no
  # warning. Named percentage, not a magic number inline in the arithmetic
  # (mirrors _q_limit=10's plain-default style a few lines above): activity
  # may not exceed $_q_act_pct percent of ctx_max.
  #
  # Cropped at whole-line boundaries (C-17), and ALL-OR-NOTHING for the
  # digest table specifically: the header + tail-lines/ctx_empty block
  # ($_q_act_head_lines, already small and the genuinely newest raw
  # entries -- real timestamps, real chronological order) is always kept
  # in full; the digest table appended after it is dropped WHOLE, never
  # partially, when the total doesn't fit. This is deliberately simpler
  # than the threads section's partial crop: digest.awk's non-digest-mode
  # branch (used here) is `for (path in cnt) print ...`, i.e. AWK'S HASH
  # ITERATION ORDER -- unspecified by POSIX and NOT insertion order
  # (measured: on this machine's awk, a 2-entry table printed the
  # more-recently-added path FIRST, not last). Cropping that table to "the
  # last N lines that fit" would keep an ARBITRARY subset of paths and
  # call it "newest", which would be false. Dropping it whole keeps the
  # one guarantee that IS true (the raw tail lines are real recent
  # history) and never fabricates a recency claim the data doesn't
  # support. No truncation marker is added (unlike the threads section):
  # the digest table is a derived summary, not a record the user edited,
  # and doctor's own ctx_max row already tells the user the budget in
  # force. If even the head alone exceeds the cap (very small ctx_max or a
  # large --limit), it is still kept whole rather than mangled further --
  # a documented edge case, not silently handled.
  _q_act_pct=20
  _q_act_cap=$((_q_max * _q_act_pct / 100))
  _q_act_len=$(printf '%s' "$_q_act" | LC_ALL=C wc -c | tr -d ' ')
  if [ "$_q_act_len" -gt "$_q_act_cap" ]; then
    _q_act=$(printf '%s' "$_q_act" | LC_ALL=C awk -v head="$_q_act_head_lines" 'NR <= head { print }')
    _q_act="$_q_act
"
  fi

  # Fixed part B: index stats section.
  _q_idx=
  _q_add_idx() {
    _q_idx="${_q_idx}${1}
"
  }
  _q_add_idx "$(_q_msg ctx_index)"
  if [ -f "$_q_v/$_q_SD/index.tsv" ]; then
    _q_add_idx "$(wc -l < "$_q_v/$_q_SD/index.tsv" | tr -d ' ')"
  else
    _q_add_idx "0"
  fi

  # Variable part: Threads.md section (ctx_threads header + file content),
  # bounded to QUIPU_CTX_MAX bytes (C-16) at whole-line boundaries (C-17).
  # The ctx_max read and the fixed-part size are hoisted above the threads
  # branch: the rules section below shares the same budget arithmetic.
  #
  # B-K1 (pin block): a <!-- knotlog:pin:start/end --> block inside the
  # threads file is pulled out via _q_pin_extract BEFORE $_q_fixed is
  # computed, so its bytes join the FIXED part of the budget -- the same
  # treatment the tone block (0c) gets, for the same reason: sections after
  # this point are dropped WHOLE under budget pressure (C-16), and a
  # dropped pin would silently break the one guarantee this feature exists
  # to make. The awk filter piped into the crop step below strips the pin's
  # own lines out of what gets cropped (kırpma yalnız pin dışında) --
  # $_q_pin is re-prepended, uncropped, once the crop step is done. When
  # the file has no pin marker at all, $_q_pin is empty and this filter is
  # a no-op passthrough (byte-identical to the old plain `cat`; see
  # _q_pin_extract's own comment for why).
  _q_thr=
  _q_pin=
  # $_q_max was already resolved at the top of this function (B-K4) --
  # reused here rather than calling _q_ctx_max a second time.
  _q_thr_p=$(_q_threads_path "$_q_v")
  if [ -f "$_q_thr_p" ]; then
    _q_pin_extract "$_q_thr_p"
  fi
  _q_pin_fx=
  if [ -n "$_q_pin" ]; then
    _q_pin_fx="$_q_pin
"
  fi
  _q_fixed=$(printf '%s%s%s%s%s%s%s' "$_q_now" "$_q_id" "$_q_purp" "$_q_tone" "$_q_pin_fx" "$_q_act" "$_q_idx" | LC_ALL=C wc -c | tr -d ' ')
  # The rules headings (variable part 2 below) are read HERE, before the
  # threads crop, and their bytes are reserved out of the threads budget
  # (T-538). They used to ride whatever slack the crop left, so a threads
  # file large enough to fill the budget dropped the behaviour contract
  # whole. The reservation is made only when the headings fit next to the
  # fixed part at all; otherwise nothing is reserved and the whole-drop
  # below still applies, so ctx_max stays the hard cap.
  _q_rul=
  _q_rul_path=$(_q_rules_path "$_q_v")
  if [ -f "$_q_rul_path" ]; then
    _q_rul_h=$(awk '/^#/ { print }' "$_q_rul_path")
    if [ -n "$_q_rul_h" ]; then
      _q_rul="$(_q_msg ctx_rules)
$_q_rul_h
"
    fi
  fi
  _q_rul_rez=0
  if [ -n "$_q_rul" ]; then
    _q_rul_rez=$(printf '%s\n' "$_q_rul" | LC_ALL=C wc -c | tr -d ' ')
    if [ "$_q_rul_rez" -gt $((_q_max - _q_fixed)) ]; then
      _q_rul_rez=0
    fi
  fi
  if [ -f "$_q_thr_p" ]; then
    _q_hdr=$(_q_msg ctx_threads)
    _q_marker=$(_q_msg ctx_truncated)
    _q_msize=$(printf '%s\n' "$_q_marker" | LC_ALL=C wc -c | tr -d ' ')
    _q_budget=$((_q_max - _q_fixed - _q_msize - _q_rul_rez))
    # A crop is no longer silent: when (and only when) the section is cut,
    # a second line after the marker says how many bytes never entered this
    # context. Its bytes are reserved out of the budget for the CUT case
    # only (_q_nbudget); a section that fits keeps the old budget and its
    # output is byte-identical to before. The reserve is sized with a digit
    # count that can only overestimate (file size + 100), so ctx_max stays
    # the hard cap.
    _q_dropfmt=$(_q_msg ctx_threads_dropped)
    _q_thr_fsz=$(wc -c < "$_q_thr_p" | tr -d ' ')
    _q_dropsz=$(printf '%s\n' "$_q_dropfmt" | LC_ALL=C wc -c | tr -d ' ')
    _q_dropsz=$((_q_dropsz + ${#_q_thr_fsz} + 3))
    _q_nbudget=$((_q_budget - _q_dropsz))
    _q_thr=$( {
      printf '%s\n' "$_q_marker"
      printf '%s\n' "$_q_hdr"
      awk '
        /<!-- (knotlog|quipu):pin:start -->/ { p = 1 }
        p { if (/<!-- (knotlog|quipu):pin:end -->/) { p = 0 }; next }
        { print }
      ' "$_q_thr_p"
    } | LC_ALL=C awk -v budget="$_q_budget" -v nbudget="$_q_nbudget" -v nmin="$_q_dropsz" -v dfmt="$_q_dropfmt" '
      NR == 1 { m = $0; next }
      { line[++cnt] = $0; total += length($0) + 1 }
      END {
        b = budget
        if (total > budget) {
          b = nbudget
          # The note must not eat the section: when the bytes left for
          # content after the reserve are fewer than the note itself, the
          # budget is too small to afford it and the plain marker with the
          # old crop stays, byte for byte.
          if (b < nmin) { b = budget; plain = 1 }
        }
        for (i = 1; i <= cnt; i++) {
          n = length(line[i])
          if (acc + n + 1 > b) { cut = 1; break }
          acc += n + 1
          print line[i]
        }
        if (cut) {
          print m
          p = index(dfmt, "%d")
          if (!plain) print substr(dfmt, 1, p - 1) (total - acc) substr(dfmt, p + 2)
        }
      }
    ')
    if [ -n "$_q_pin" ]; then
      _q_thr="$_q_pin
$_q_thr"
    fi
  fi

  # Variable part 2 (rules, B3): the localized rules file's headings,
  # injected after the threads section so every hook-fed session carries
  # the vault's behavior contract without opening the file. Headings only:
  # the file is the contract, the context carries its table of contents.
  # Bounded by the SAME ctx_max contract (C-16): its bytes are reserved
  # before the threads crop (T-538), and it is dropped whole -- never cut
  # mid-heading -- only when it cannot fit next to the fixed part at all
  # (the contract still lives on disk and in the bridge blocks). Absent entirely when the file -- or
  # any heading in it -- is missing: an old vault without Kurallar.md must
  # not error, the same silence the threads section keeps for an absent
  # file. $_q_rul was read above, before the threads crop (T-538).
  if [ -n "$_q_rul" ]; then
    _q_thr_len=0
    if [ -n "$_q_thr" ]; then
      _q_thr_len=$(printf '%s\n' "$_q_thr" | LC_ALL=C wc -c | tr -d ' ')
    fi
    _q_rul_len=$(printf '%s\n' "$_q_rul" | LC_ALL=C wc -c | tr -d ' ')
    if [ "$_q_rul_len" -gt $((_q_max - _q_fixed - _q_thr_len)) ]; then
      _q_rul=
    fi
  fi

  # Variable part 3 (facts, B5): the localized facts file's tagged bullet
  # lines, injected after the rules section so every hook-fed session
  # carries the vault's persistent facts without opening the file. Only an
  # ADOPTED file injects: an untouched seed is the init skeleton, not a
  # record -- the same D1 decision b47c5d3 made for doctor's mandatory
  # contract, applied to the context feed. A hand-edited file carries the
  # `- ` bullet lines only; the skeleton prose never leaks into context.
  # Bounded by the SAME ctx_max contract (C-16): the section rides the
  # slack the threads AND rules budget leave and is dropped whole -- never
  # cut mid-line -- when that slack is too small (the record still lives on
  # disk). Absent entirely when the file is missing or still the seed: an
  # old vault without Facts.md must not error, the same silence the rules
  # section keeps.
  _q_fts=
  _q_fts_path=$(_q_facts_path "$_q_v")
  if [ -f "$_q_fts_path" ]; then
    _q_facts_adopted "$_q_fts_path"
    if [ "$_q_fa" -eq 1 ]; then
      _q_fts_h=$(awk '/^- / { print }' "$_q_fts_path")
      if [ -n "$_q_fts_h" ]; then
        _q_fts="$(_q_msg ctx_facts)
$_q_fts_h
"
        _q_thr_len=0
        if [ -n "$_q_thr" ]; then
          _q_thr_len=$(printf '%s\n' "$_q_thr" | LC_ALL=C wc -c | tr -d ' ')
        fi
        _q_rul_len=0
        if [ -n "$_q_rul" ]; then
          _q_rul_len=$(printf '%s\n' "$_q_rul" | LC_ALL=C wc -c | tr -d ' ')
        fi
        _q_fts_len=$(printf '%s\n' "$_q_fts" | LC_ALL=C wc -c | tr -d ' ')
        if [ "$_q_fts_len" -gt $((_q_max - _q_fixed - _q_thr_len - _q_rul_len)) ]; then
          _q_fts=
        fi
      fi
    fi
  fi

  if [ -n "$_q_thr" ]; then
    _q_text="$_q_now$_q_id$_q_purp$_q_tone$_q_act$_q_thr
$_q_rul$_q_fts$_q_idx"
  else
    _q_text="$_q_now$_q_id$_q_purp$_q_tone$_q_act$_q_rul$_q_fts$_q_idx"
  fi
}

_q_checkpoint_due() {
  _q_cd_v=$1
  if ! command -v git >/dev/null 2>&1 || ! (cd "$_q_cd_v" && git rev-parse --git-dir >/dev/null 2>&1); then
    return 1
  fi

  _q_cd_lay=
  if [ -f "$_q_cd_v/$_q_SD/config" ]; then
    _q_cd_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_cd_v/$_q_SD/config" 2>/dev/null || true)
  fi
  _q_layout_ok "$_q_cd_lay" || _q_cd_lay=emoji
  _q_cd_tab=$(printf '\t')
  _q_cd_sess=$(awk -F"$_q_cd_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_cd_lay.txt" 2>/dev/null || true)

  _q_cd_today=$(date +%Y-%m-%d)
  _q_cd_yest=$(date -d yesterday +%Y-%m-%d 2>/dev/null || date -v-1d +%Y-%m-%d 2>/dev/null || true)
  _q_not_at=0
  for _q_cd_g in "$_q_cd_today" "$_q_cd_yest"; do
    [ -n "$_q_cd_g" ] || continue
    _q_cd_f="$_q_cd_v/$_q_cd_sess/$_q_cd_g.md"
    [ -f "$_q_cd_f" ] || continue
    _q_cd_m=$(mtime "$_q_cd_f")
    [ "$_q_cd_m" -gt "$_q_not_at" ] && _q_not_at=$_q_cd_m
  done

  _q_now_epoch=$(date +%s)
  _q_cd_after=${QUIPU_CHECKPOINT_AFTER:-1800}
  if [ $((_q_now_epoch - _q_not_at)) -lt "$_q_cd_after" ]; then
    return 1
  fi

  _q_is_at=$(git -C "$_q_cd_v" log -1 --format=%ct 2>/dev/null || echo 0)
  case "$_q_is_at" in
    ''|*[!0-9]*) _q_is_at=0 ;;
  esac

  if (cd "$_q_cd_v" && git rev-parse --verify --quiet HEAD >/dev/null 2>&1); then
    _q_cd_ch=$(git -C "$_q_cd_v" -c core.quotepath=false diff --name-only HEAD 2>/dev/null || true)
    while IFS= read -r _q_cd_y || [ -n "$_q_cd_y" ]; do
      [ -n "$_q_cd_y" ] || continue
      [ -f "$_q_cd_v/$_q_cd_y" ] || continue
      _q_cd_m=$(mtime "$_q_cd_v/$_q_cd_y")
      [ "$_q_cd_m" -gt "$_q_is_at" ] && _q_is_at=$_q_cd_m
    done <<EOF
$_q_cd_ch
EOF
  fi

  case "$_q_is_at" in
    ''|*[!0-9]*) _q_is_at=0 ;;
  esac

  if [ "$_q_is_at" -le "$_q_not_at" ]; then
    return 1
  fi

  if [ "$_q_not_at" -eq 0 ]; then
    _q_cp_dk="?"
  else
    _q_cp_dk=$(( (_q_now_epoch - _q_not_at) / 60 ))
  fi
  return 0
}

_q_cmd_context() {
  _q_ev=
  _q_limit=10
  _q_bridge=0
  _q_cursor=0
  _q_ag=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_ev=$2; shift 2 ;;
      --limit) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_limit=$2; shift 2 ;;
      --bridge) _q_bridge=1; shift ;;
      --cursor) _q_cursor=1; shift ;;
      --antigravity) _q_ag=1; shift ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  if [ "$_q_bridge" -eq 1 ] && [ -n "$_q_ev" ]; then
    _q_die err_conflict 2
  fi

  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  # Antigravity: only SessionStart and Stop do work; any other event gets the
  # empty object it accepts.
  if [ "$_q_ag" -eq 1 ] && [ -n "$_q_ev" ] && [ "$_q_ev" != SessionStart ] && [ "$_q_ev" != Stop ]; then
    printf '{}\n'
    exit 0
  fi

  # profile= gate (the one place hook output is decided): manual silences
  # every hook event; economical silences the per-turn ones (prompt nudge,
  # Stop reminder). Hand-run `context` (no --json) and --bridge are untouched.
  if [ -n "$_q_ev" ]; then
    _q_profile "$_q_v"
    if [ "$_q_prof" = manual ] || { [ "$_q_prof" = economical ] && [ "$_q_ev" != SessionStart ] && [ "$_q_ev" != PreCompact ]; }; then
      if [ "$_q_ag" -eq 0 ]; then :
      elif [ "$_q_ev" = Stop ]; then printf '{"decision":"allow"}\n'
      else printf '{}\n'
      fi
      exit 0
    fi
  fi

  if [ "$_q_ev" = Stop ]; then
    _q_stdin=$(head -c "${QUIPU_MAX_STDIN:-65536}" 2>/dev/null || cat)
    if [ "$_q_ag" -eq 1 ]; then
      # Antigravity's Stop needs a decision every time: "continue" re-enters the
      # loop with the reason, anything else lets the turn end. No
      # stop_hook_active here; the throttle below is the loop guard.
      case "$_q_stdin" in
        *'"fullyIdle":false'*|*'"fullyIdle": false'*) printf '{"decision":"allow"}\n'; exit 0 ;;
      esac
    else
      case "$_q_stdin" in
        *'"stop_hook_active":true'*|*'"stop_hook_active": true'*) exit 0 ;;
      esac
    fi
    _q_now_epoch=$(date +%s)
    _q_cp_nudged=0
    if [ -f "$_q_v/$_q_SD/checkpoint_nudged" ]; then
      _q_cp_nudged=$(cat "$_q_v/$_q_SD/checkpoint_nudged" 2>/dev/null || echo 0)
      case "$_q_cp_nudged" in
        ''|*[!0-9]*) _q_cp_nudged=0 ;;
      esac
    fi
    _q_cp_after=${QUIPU_CHECKPOINT_AFTER:-1800}
    if [ $((_q_now_epoch - _q_cp_nudged)) -lt "$_q_cp_after" ]; then
      [ "$_q_ag" -eq 0 ] || printf '{"decision":"allow"}\n'
      exit 0
    fi
    if _q_checkpoint_due "$_q_v"; then
      # shellcheck disable=SC2059
      _q_reason=$(printf "$(_q_msg ctx_checkpoint_due)" "$_q_cp_dk")
      if [ "$_q_ag" -eq 1 ]; then
        printf '%s' "$_q_reason" | awk -f "$_q_HOME/lib/jsonemit.awk" -f "$_q_HOME/lib/emit_agstop.awk"
      else
        printf '%s' "$_q_reason" | awk -f "$_q_HOME/lib/jsonemit.awk" -f "$_q_HOME/lib/emit_hookblock.awk"
      fi
      printf '%s\n' "$_q_now_epoch" > "$_q_v/$_q_SD/checkpoint_nudged"
    elif [ "$_q_ag" -eq 1 ]; then
      printf '{"decision":"allow"}\n'
    fi
    exit 0
  fi

  _q_ctx_text

  # Nudge (C-19/C-20): only --json UserPromptSubmit or BeforeAgent (Gemini), once more than
  # QUIPU_NUDGE_AFTER lines accumulate past the watermarks.
  if [ -n "$_q_ev" ] && { [ "$_q_ev" = UserPromptSubmit ] || [ "$_q_ev" = BeforeAgent ]; } && [ -s "$_q_log" ]; then
    _q_nudge_after=${QUIPU_NUDGE_AFTER:-50}
    _q_total=$(wc -l < "$_q_log" | tr -d ' ')
    _q_last=0
    for _q_w in "$_q_v/$_q_SD/remembered" "$_q_v/$_q_SD/nudged"; do
      if [ -f "$_q_w" ]; then
        _q_pos=$(awk 'NR == 1 { wm = $0; next } $0 == wm { last = FNR } END { print (last + 0) }' "$_q_w" "$_q_log")
        if [ "$_q_pos" -gt "$_q_last" ]; then
          _q_last=$_q_pos
        fi
      fi
    done
    if [ $((_q_total - _q_last)) -gt "$_q_nudge_after" ]; then
      _q_lay=
      if [ -f "$_q_v/$_q_SD/config" ]; then
        _q_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
      fi
      _q_layout_ok "$_q_lay" || _q_lay=emoji
      _q_tab=$(printf '\t')
      _q_sess=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_lay.txt" 2>/dev/null || true)
      # shellcheck disable=SC2059
      _q_nudge=$(printf "$(_q_msg ctx_precompact)" "$_q_sess")
      _q_text="${_q_text}${_q_nudge}
"
      _q_lastline=$(awk 'END { print $0 }' "$_q_log")
      printf '%s\n' "$_q_lastline" > "$_q_v/$_q_SD/nudged"
    fi
  fi

  # Checkpoint reminder on UserPromptSubmit (and BeforeAgent, Gemini)
  if [ -n "$_q_ev" ] && { [ "$_q_ev" = UserPromptSubmit ] || [ "$_q_ev" = BeforeAgent ]; }; then
    _q_now_epoch=$(date +%s)
    _q_cp_nudged=0
    if [ -f "$_q_v/$_q_SD/checkpoint_nudged" ]; then
      _q_cp_nudged=$(cat "$_q_v/$_q_SD/checkpoint_nudged" 2>/dev/null || echo 0)
      case "$_q_cp_nudged" in
        ''|*[!0-9]*) _q_cp_nudged=0 ;;
      esac
    fi
    _q_cp_after=${QUIPU_CHECKPOINT_AFTER:-1800}
    if [ $((_q_now_epoch - _q_cp_nudged)) -ge "$_q_cp_after" ]; then
      if _q_checkpoint_due "$_q_v"; then
        # shellcheck disable=SC2059
        _q_cp_msg=$(printf "$(_q_msg ctx_checkpoint_due)" "$_q_cp_dk")
        _q_text="${_q_text}${_q_cp_msg}
"
        printf '%s\n' "$_q_now_epoch" > "$_q_v/$_q_SD/checkpoint_nudged"
      fi
    fi
  fi

  # FAZ 8 (Y-3/Y-4): SessionStart-only reflection prompts.
  if [ -n "$_q_ev" ] && [ "$_q_ev" = SessionStart ]; then
    # Y-3: one-shot missed-reflection notice, placed at the TOP of the
    # context; the flag file is deleted here (single shot).
    if [ -f "$_q_v/$_q_SD/needs_reflection" ]; then
      _q_miss=$(cat "$_q_v/$_q_SD/needs_reflection")
      rm -f "$_q_v/$_q_SD/needs_reflection"
      _q_miss_day=${_q_miss%% *}
      _q_miss_n=${_q_miss#* }
      # ctx_reflect_missed carries two %s (day, count); resolved by printf.
      # shellcheck disable=SC2059
      _q_missmsg=$(printf "$(_q_msg ctx_reflect_missed)" "$_q_miss_day" "$_q_miss_n")
      _q_text="${_q_missmsg}
${_q_text}"
    fi
    # Y-4: when today's session file exists and its block is empty, ask the
    # model to fill it; the message names the block path and the marker.
    _q_lay=
    if [ -f "$_q_v/$_q_SD/config" ]; then
      _q_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
    fi
    _q_layout_ok "$_q_lay" || _q_lay=emoji
    _q_tab=$(printf '\t')
    _q_sess=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_lay.txt" 2>/dev/null || true)
    _q_day=$(date +%Y-%m-%d)
    _q_today="$_q_v/$_q_sess/$_q_day.md"
    if [ -f "$_q_today" ]; then
      _q_reflect_filled "$_q_today"
      if [ "$_q_rf" -eq 0 ]; then
        # ctx_reflect_ask carries two %s (path, marker name); resolved here.
        # Name the marker family the file actually carries (legacy quipu: kept).
        _q_rmk=knotlog:reflect
        grep -q 'quipu:reflect:start' "$_q_today" && _q_rmk=quipu:reflect
        # shellcheck disable=SC2059
        _q_ask=$(printf "$(_q_msg ctx_reflect_ask)" "$_q_sess/$_q_day.md" "$_q_rmk")
        _q_text="${_q_text}${_q_ask}
"
      fi
    fi
  fi

  if [ "$_q_bridge" -eq 1 ]; then
    # H-11/H-13: write the context into a dedicated context block, never the
    # static knotlog:start block (init's property; legacy quipu:start too). printf (not echo)
    # the exact text; block.awk guarantees idempotence + user-content safety.
    # Written to BOTH bridge files: this is the hook-less path, and it is the
    # only way a Codex session (whose hooks do not fire) learns what a Claude
    # session did -- and vice versa when Claude reads CLAUDE.md.
    : >> "$_q_v/AGENTS.md"
    : >> "$_q_v/CLAUDE.md"
    _q_ctx_body="$_q_v/$_q_SD/context-body.tmp"
    printf '%s' "$_q_text" > "$_q_ctx_body"
    awk -v start='<!-- knotlog:context:start -->' -v end='<!-- knotlog:context:end -->' \
      -f "$_q_HOME/lib/block.awk" "$_q_v/AGENTS.md" < "$_q_ctx_body" > "$_q_v/$_q_SD/agents.tmp" \
      && mv "$_q_v/$_q_SD/agents.tmp" "$_q_v/AGENTS.md"
    awk -v start='<!-- knotlog:context:start -->' -v end='<!-- knotlog:context:end -->' \
      -f "$_q_HOME/lib/block.awk" "$_q_v/CLAUDE.md" < "$_q_ctx_body" > "$_q_v/$_q_SD/claude.tmp" \
      && mv "$_q_v/$_q_SD/claude.tmp" "$_q_v/CLAUDE.md"
    rm -f "$_q_ctx_body"
    _q_msg bridge_updated
    exit 0
  fi

  if [ -n "$_q_ev" ] && [ "$_q_ag" -eq 1 ]; then
    printf '%s' "$_q_text" | awk -f "$_q_HOME/lib/jsonemit.awk" -f "$_q_HOME/lib/emit_agctx.awk"
  elif [ -n "$_q_ev" ] && [ "$_q_cursor" -eq 1 ]; then
    printf '%s' "$_q_text" | awk -v JE_EV="$_q_ev" -f "$_q_HOME/lib/jsonemit.awk" -f "$_q_HOME/lib/emit_cursorctx.awk"
  elif [ -n "$_q_ev" ]; then
    # Context via stdin, not -v: awk -v processes escape sequences and
    # would corrupt Windows paths (C:\Users\...). JE_EV is a plain event
    # name, safe as -v.
    printf '%s' "$_q_text" | awk -v JE_EV="$_q_ev" -f "$_q_HOME/lib/jsonemit.awk" -f "$_q_HOME/lib/emit_hookctx.awk"
  else
    printf '%s' "$_q_text"
  fi
}

# ---- remember ---------------------------------------------------------------

_q_remember_lock_acquire() {
  # _q_remember_lock_acquire LOCKDIR BUSY_KEY — take the remember lock (an
  # atomic mkdir). Returns 0 when acquired; after the bounded wait it warns
  # with BUSY_KEY and returns 1, leaving the decision to exit to the caller.
  _q_rla_lock=$1
  _q_rla_wait=0
  while ! mkdir "$_q_rla_lock" 2>/dev/null; do
    # Recover a lock left by a process that was killed, but never steal a
    # live owner's lock.  The bounded wait keeps hook shutdown responsive.
    _q_rla_pid=
    if [ -r "$_q_rla_lock/pid" ]; then
      _q_rla_pid=$(cat "$_q_rla_lock/pid" 2>/dev/null || true)
    fi
    if [ -n "$_q_rla_pid" ] && ! kill -0 "$_q_rla_pid" 2>/dev/null; then
      rm -f "$_q_rla_lock/pid"
      rmdir "$_q_rla_lock" 2>/dev/null || true
      continue
    fi
    if [ "$_q_rla_wait" -ge 50 ]; then
      # A skipped transaction is safe to retry because the watermark is
      # advanced only after the session and pointer writes succeed.  Surface
      # the skip to standalone callers; hooks keep rc=0 so a SessionStart or
      # SessionEnd chain can continue to its context/index step.
      _q_warn "$2"
      return 1
    fi
    sleep 0.1
    _q_rla_wait=$((_q_rla_wait + 1))
  done
  return 0
}

_q_reflect_scaffold() {
  # _q_reflect_scaffold FILE — append the empty reflection block skeleton.
  # Callers check for the start marker first; this never inspects FILE.
  {
    printf '%s\n' '<!-- knotlog:reflect:start -->'
    printf '### %s\n' "$(_q_msg reflect_head_what)"
    printf '%s\n' ''
    printf '### %s\n' "$(_q_msg reflect_head_where)"
    printf '%s\n' ''
    printf '### %s\n' "$(_q_msg reflect_head_threads)"
    printf '%s\n' ''
    printf '%s\n' '<!-- knotlog:reflect:end -->'
  } >> "$1"
}

_q_cmd_remember() {
  _q_git=0
  _q_dry=0
  _q_limit=10

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --git) _q_git=1; shift ;;
      --dry-run) _q_dry=1; shift ;;
      --limit) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_limit=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done

  # A hook's stdout is read as the agent's JSON (and chained before `context`),
  # so in hook mode remember says nothing there; errors stay on stderr.
  [ "${QUIPU_HOOK:-0}" != 1 ] || exec >/dev/null

  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  _q_tab=$(printf '\t')
  _q_log="$_q_v/$_q_SD/activity.log"
  _q_wm="$_q_v/$_q_SD/remembered"

  # Hook mode only: the hook payload on stdin names the session (id8 TAB
  # client). Never read stdin interactively; no id means the single-block
  # fallback below, so CLI and omp (no payload) behave as before.
  _q_sid=
  if [ "${QUIPU_HOOK:-0}" = 1 ] && [ ! -t 0 ]; then
    _q_sid=$(head -c "${QUIPU_MAX_STDIN:-65536}" | awk -f "$_q_HOME/lib/jsonfield.awk" -f "$_q_HOME/lib/hookid.awk" 2>/dev/null || true)
  fi

  # remember is an append-then-watermark transaction.  SessionEnd and the
  # next SessionStart can overlap, so serialize the whole transaction; an
  # atomic mkdir gives us a portable POSIX lock without requiring flock.
  _q_lock="$_q_v/$_q_SD/remember.lock"
  _q_remember_lock_acquire "$_q_lock" remember_busy || {
    if [ "${QUIPU_HOOK:-0}" = 1 ]; then
      exit 0
    fi
    exit 1
  }
  printf '%s\n' "$$" > "$_q_lock/pid"
  _q_body=
  _q_remember_cleanup() {
    [ -z "${_q_body:-}" ] || rm -f "$_q_body"
    rm -f "$_q_lock/pid"
    rmdir "$_q_lock" 2>/dev/null || true
  }
  trap '_q_remember_cleanup' EXIT HUP INT TERM

  # Slice: the lines AFTER the last occurrence of the watermark line (C-7).
  # The watermark is user data, so it flows via a file argument, never -v.
  if [ -s "$_q_wm" ]; then
    _q_slice=$(awk 'NR == 1 { wm = $0; next } { if ($0 == wm) last = NR; line[NR] = $0 } END { if (last) { for (i = last + 1; i <= NR; i++) print line[i] } else { for (i = 2; i <= NR; i++) print line[i] } }' "$_q_wm" "$_q_log")
  else
    _q_slice=$(cat "$_q_log" 2>/dev/null || true)
  fi

  if [ -z "$_q_slice" ]; then
    _q_msg remember_empty
    exit 0
  fi

  _q_digest=$(printf '%s\n' "$_q_slice" | awk -v mode=digest -f "$_q_HOME/lib/digest.awk")
  _q_last=$(printf '%s\n' "$_q_slice" | awk 'END{print}')

  _q_first=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" '$1=="RANGE"{print $2; exit}')
  _q_lastts=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" '$1=="RANGE"{print $3; exit}')
  _q_count=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" '$1=="RANGE"{print $4; exit}')
  # Defensive (spec C-1): when the slice holds no valid events, nothing is
  # written and the watermark does not advance.
  if [ -z "$_q_count" ] || [ "$_q_count" = 0 ]; then
    _q_msg remember_empty
    exit 0
  fi

  _q_tools=$(printf '%s\n' "$_q_digest" | awk -F"$_q_tab" 'BEGIN{OFS=sprintf("%c",9)} $1=="TOOL"{print $2, $3}' | sort -t "$_q_tab" -k2,2nr | awk -F"$_q_tab" '{ if (first) printf ", "; printf "%s %s", $1, $2; first=1 }')

  _q_layout=
  if [ -f "$_q_v/$_q_SD/config" ]; then
    _q_layout=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  fi
  if [ -z "$_q_layout" ]; then
    _q_layout=emoji
  fi
  _q_sessions=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_layout.txt" 2>/dev/null || true)

  _q_day=$(date +%Y-%m-%d)
  _q_rel="$_q_sessions/$_q_day.md"
  _q_now=$(date +%H:%M)

  _q_body=$(mktemp "${TMPDIR:-/tmp}/quipu-remember-XXXXXX") || exit 1
  {
    printf '## %s\n' "$_q_now"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_range)\n" "$_q_first" "$_q_lastts" "$_q_count"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_tools)\n" "$_q_tools"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_files)\n" "$_q_limit"
    printf '%s\n' "$_q_digest" | awk -F"$_q_tab" 'BEGIN{OFS=sprintf("%c",9)} $1=="FILE"{print $2, $3}' | sort -t "$_q_tab" -k2,2nr | head -n "$_q_limit" | while IFS="$_q_tab" read -r _q_p _q_c; do
      printf '  - %2d  %s\n' "$_q_c" "$_q_p"
    done
  } > "$_q_body"

  if [ "$_q_dry" -eq 1 ]; then
    cat "$_q_body"
    exit 0
  fi

  mkdir -p "$_q_v/$_q_sessions"
  cat "$_q_body" >> "$_q_v/$_q_rel"

  # FAZ 8 (Y-1): reflection block, appended ONLY when absent. Detection is the
  # marker's existence (awk index, per spec); a present block is never touched
  # so the model's own lines survive a same-day second `remember`. block.awk
  # is NOT used here — it replaces block content, which would erase what the
  # model wrote. The insertion is a plain append; append-only stays intact.
  if ! awk 'index($0, "knotlog:reflect:start") || index($0, "quipu:reflect:start") { found = 1 } END { exit !found }' "$_q_v/$_q_rel"; then
    _q_reflect_scaffold "$_q_v/$_q_rel"
  fi

  # FAZ 16 (AD-1/AD-2): Threads.md scaffold, same discipline as the reflect
  # block above -- marker existence via awk index, added ONLY when absent,
  # never touching a single byte inside or outside an existing block
  # (T-242/T-244). The one guard `init` already applies (create the file
  # empty when missing) is repeated here for the direct-`remember`-without-
  # `init` hook path. Unlike the reflect block, this one is PREPENDED, not
  # appended (>>): Threads.md is a single, permanently-growing file and
  # _q_ctx_text's QUIPU_CTX_MAX budget silently drops whatever falls off the
  # BOTTOM once the file is large (AC-4) -- putting the block at the TOP
  # keeps it inside the surviving half of the file for longer as the file
  # grows (AD-2's accepted risk: the budget logic itself is untouched, only
  # the block's own position is protected). The temp-file + mv idiom mirrors
  # Last-Session.md's own .quipu/*.tmp pattern just below.
  # Resolve once: the path must not change between the existence check and the
  # mv below, or a freshly created file would be written back under the other
  # name and the scaffold would land in a second, empty file.
  _q_threads_f=$(_q_threads_path "$_q_v")
  [ -f "$_q_threads_f" ] || : > "$_q_threads_f"
  if ! awk 'index($0, "knotlog:threads:start") || index($0, "quipu:threads:start") { found = 1 } END { exit !found }' "$_q_threads_f"; then
    {
      printf '%s\n' '<!-- knotlog:threads:start -->'
      printf '### %s\n' "$(_q_msg threads_head_active)"
      printf '%s\n' ''
      printf '### %s\n' "$(_q_msg threads_head_closed)"
      printf '%s\n' ''
      printf '%s\n' '<!-- knotlog:threads:end -->'
      cat "$_q_threads_f"
    } > "$_q_v/$_q_SD/threads.tmp" && mv "$_q_v/$_q_SD/threads.tmp" "$_q_threads_f"
  fi

  _q_ls_body="$_q_day · $_q_count $(_q_msg remember_events) · $_q_rel"
  _q_ls_f=$(_q_session_file "$_q_v")
  : >> "$_q_ls_f"
  if [ -n "$_q_sid" ]; then
    # Per-session handoff card (lib/card.awk): this session's card only,
    # replaced by id8 and moved to the bottom. An old marked block is left
    # exactly as it is (nothing is migrated); only id-less runs still update it.
    _q_sid_id=${_q_sid%%"$_q_tab"*}
    _q_sid_cl=${_q_sid#*"$_q_tab"}
    printf '%s\n' "$_q_ls_body" | awk -v tail=" · $_q_sid_id" -v head="## $_q_day $_q_now · $_q_sid_cl · $_q_sid_id" -f "$_q_HOME/lib/card.awk" "$_q_ls_f" > "$_q_v/$_q_SD/lastsession.tmp" && mv "$_q_v/$_q_SD/lastsession.tmp" "$_q_ls_f"
  else
    printf '%s\n' "$_q_ls_body" | awk -f "$_q_HOME/lib/block.awk" "$_q_ls_f" > "$_q_v/$_q_SD/lastsession.tmp" && mv "$_q_v/$_q_SD/lastsession.tmp" "$_q_ls_f"
  fi

  printf '%s\n' "$_q_last" > "$_q_wm"

  # FAZ 8 (Y-3): missed-reflection catcher. When the most recent previous
  # session file's block is empty, a one-line flag (day + event count) is
  # written to .quipu/needs_reflection; the next `context --json SessionStart`
  # shows it once and deletes it. The flag lives under .quipu/, never in the
  # visible vault tree. No mtime is consulted (S-5.2); "previous" is the
  # lexicographically latest YYYY-MM-DD session file strictly before today.
  _q_prev=
  _q_prevn=0
  _q_dayn=$(printf '%s\n' "$_q_day" | tr -d '-')
  for _q_f in "$_q_v/$_q_sessions"/*.md; do
    [ -f "$_q_f" ] || continue
    _q_base=${_q_f##*/}
    _q_d=${_q_base%.md}
    case "$_q_d" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
      *) continue ;;
    esac
    _q_dn=$(printf '%s\n' "$_q_d" | tr -d '-')
    if [ "$_q_dn" -lt "$_q_dayn" ] && [ "$_q_dn" -gt "$_q_prevn" ]; then
      _q_prevn=$_q_dn
      _q_prev=$_q_d
    fi
  done
  if [ -n "$_q_prev" ]; then
    _q_reflect_filled "$_q_v/$_q_sessions/$_q_prev.md"
    if [ "$_q_rf" -eq 0 ]; then
      # Event count: parenthesized integer on the digest Range line(s) of the
      # mechanical area (quipu's own output, before the reflection marker).
      # The files/tools headers ("(top 10)" / "(en çok 10)") are skipped by
      # requiring the parenthesized text to start with a digit.
      _q_prev_count=$(awk '
        (index($0, "knotlog:reflect:start") || index($0, "quipu:reflect:start")) { stop = 1 }
        stop { next }
        {
          p = index($0, "(")
          if (p > 0) {
            s = substr($0, p + 1)
            if (substr(s, 1, 1) >= "0" && substr(s, 1, 1) <= "9") {
              n = s + 0
              if (n > 0) sum = sum + n
            }
          }
        }
        END { print sum + 0 }
      ' "$_q_v/$_q_sessions/$_q_prev.md")
      printf '%s %s\n' "$_q_prev" "$_q_prev_count" > "$_q_v/$_q_SD/needs_reflection"
    fi
  fi

  if [ "$_q_git" -eq 1 ] && command -v git >/dev/null 2>&1; then
    if (cd "$_q_v" && git rev-parse --git-dir >/dev/null 2>&1); then
      if (cd "$_q_v" && git add -A && ! git diff --cached --quiet); then
        if (cd "$_q_v" && git commit -m "knotlog: $_q_day" >/dev/null); then
          _q_msg remember_git
        fi
      fi
    fi
  fi

  # shellcheck disable=SC2059
  printf "$(_q_msg remember_ok)\n" "$_q_rel"
}

# ---- note -------------------------------------------------------------------

_q_note_thread_write() {
  # _q_note_thread_write VAULT TEXT — `note --thread`: one list line appended
  # at the END of the active section of the threads block
  # (<!-- knotlog:threads:start/end -->). Nothing is ever inserted inside the
  # pin block, and a missing file or section is an error, never a seed: the
  # file is rebuilt through head/cat/tail into a temp file and moved over it,
  # so every other line stays byte for byte.
  _q_nt_v=$1
  _q_nt_text=$2
  _q_nt_tp=$(_q_threads_path "$_q_nt_v")
  if [ ! -f "$_q_nt_tp" ]; then
    _q_die err_thread_nofile 1 "${_q_nt_tp#"$_q_nt_v"/}"
  fi
  _q_nt_cr=$(printf '\r')
  _q_nt_lock="$_q_nt_v/$_q_SD/remember.lock"
  _q_remember_lock_acquire "$_q_nt_lock" note_busy || exit 1
  printf '%s\n' "$$" > "$_q_nt_lock/pid"
  _q_nt_tmp="$_q_nt_v/$_q_SD/thread.tmp"
  _q_nt_line="$_q_nt_v/$_q_SD/thread.line"
  _q_nt_cleanup() {
    rm -f "$_q_nt_tmp" "$_q_nt_line"
    rm -f "$_q_nt_lock/pid"
    rmdir "$_q_nt_lock" 2>/dev/null || true
  }
  trap '_q_nt_cleanup' EXIT HUP INT TERM

  # Insertion point: the line after the last non-blank line of the active
  # section (or right after its heading when the section is empty). Exit 1
  # when the threads block or its active heading is missing; exit 2 when the
  # insertion point falls inside the pin block (pin start < point <= pin end).
  _q_nt_head=$(_q_msg threads_head_active)
  _q_nt_rc=0
  _q_nt_anchor=$(awk -v h="### $_q_nt_head" '
    { line[NR] = $0 }
    END {
      s = 0
      for (i = 1; i <= NR; i++) if ((index(line[i], "knotlog:threads:start") || index(line[i], "quipu:threads:start"))) { s = i; break }
      if (s == 0) exit 1
      e = 0
      for (i = s + 1; i <= NR; i++) if ((index(line[i], "knotlog:threads:end") || index(line[i], "quipu:threads:end"))) { e = i; break }
      if (e == 0) exit 1
      a = 0
      for (i = s + 1; i < e; i++) {
        t = line[i]; sub(/\r$/, "", t)
        if (t == h) { a = i; break }
      }
      if (a == 0) exit 1
      last = a
      for (i = a + 1; i < e; i++) {
        if (line[i] ~ /^#/) break
        if (line[i] !~ /^[ \t\r]*$/) last = i
      }
      ps = 0; pe = 0
      for (i = 1; i <= NR; i++) if ((index(line[i], "knotlog:pin:start") || index(line[i], "quipu:pin:start"))) { ps = i; break }
      if (ps > 0) for (i = ps + 1; i <= NR; i++) if ((index(line[i], "knotlog:pin:end") || index(line[i], "quipu:pin:end"))) { pe = i; break }
      ins = last + 1
      if (ps > 0 && ins > ps && (pe == 0 || ins <= pe)) exit 2
      print ins
    }' "$_q_nt_tp") || _q_nt_rc=$?
  if [ "$_q_nt_rc" -eq 2 ]; then
    _q_die err_thread_pinned 1
  elif [ "$_q_nt_rc" -ne 0 ]; then
    _q_die err_thread_nosection 1
  fi

  _q_nt_crs=
  if [ "$(head -n "$((_q_nt_anchor - 1))" "$_q_nt_tp" | tail -n 1 | tr -d '\n' | tail -c 1 | od -An -c | tr -d ' ')" = '\r' ]; then
    _q_nt_crs=$_q_nt_cr
  fi
  _q_nt_now=$(date +%H:%M)
  printf '%s %s %s%s\n' '-' "$_q_nt_now" "$_q_nt_text" "$_q_nt_crs" > "$_q_nt_line"
  if ! {
    head -n "$((_q_nt_anchor - 1))" "$_q_nt_tp"
    cat "$_q_nt_line"
    tail -n "+$_q_nt_anchor" "$_q_nt_tp"
  } > "$_q_nt_tmp" || ! mv -f "$_q_nt_tmp" "$_q_nt_tp"; then
    _q_die err_note_write 1 "${_q_nt_tp#"$_q_nt_v"/}"
  fi

  # shellcheck disable=SC2059
  printf "$(_q_msg thread_ok)\n" "${_q_nt_tp#"$_q_nt_v"/}"
}

_q_cmd_note() {
  # quipu note "<text>" — one line appended to today's reflection block. The
  # text is user data: it reaches the file through head/cat, never awk -v or
  # a shell-expanded format, so \ % & $ survive byte for byte.
  # `--thread` as the first argument routes the line to the active threads
  # section instead (_q_note_thread_write); without it nothing changes.
  _q_note_thread=0
  if [ "${1:-}" = --thread ]; then
    _q_note_thread=1
    shift
  fi
  case "$#" in
    0) _q_die err_missing_arg 2 ;;
    1) ;;
    *) _q_die err_note_args 2 ;;
  esac
  _q_note_text=$1
  case "$_q_note_text" in
    '') _q_die err_missing_arg 2 ;;
    -*) _q_die err_unknown_flag 2 "$1" ;;
  esac
  # $(...) strips trailing newlines, so the LF probe keeps a sentinel byte.
  _q_lf=$(printf '\nx')
  _q_lf=${_q_lf%x}
  _q_cr=$(printf '\r')
  case "$_q_note_text" in
    *"$_q_lf"*|*"$_q_cr"*) _q_die err_note_newline 2 ;;
  esac

  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi
  if [ "$_q_note_thread" = 1 ]; then
    _q_note_thread_write "$_q_v" "$_q_note_text"
    return 0
  fi

  _q_tab=$(printf '\t')
  _q_layout=
  if [ -f "$_q_v/$_q_SD/config" ]; then
    _q_layout=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  fi
  if [ -z "$_q_layout" ]; then
    _q_layout=emoji
  fi
  _q_sessions=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_layout.txt" 2>/dev/null || true)
  _q_day=$(date +%Y-%m-%d)
  _q_rel="$_q_sessions/$_q_day.md"
  _q_now=$(date +%H:%M)
  _q_note_file="$_q_v/$_q_rel"

  # Same lock as remember: the two commands edit the same session file.
  _q_lock="$_q_v/$_q_SD/remember.lock"
  _q_remember_lock_acquire "$_q_lock" note_busy || exit 1
  printf '%s\n' "$$" > "$_q_lock/pid"
  _q_note_tmp="$_q_v/$_q_SD/note.tmp"
  _q_note_line="$_q_v/$_q_SD/note.line"
  _q_note_cleanup() {
    rm -f "$_q_note_tmp" "$_q_note_line"
    rm -f "$_q_lock/pid"
    rmdir "$_q_lock" 2>/dev/null || true
  }
  trap '_q_note_cleanup' EXIT HUP INT TERM

  mkdir -p "$_q_v/$_q_sessions"
  : >> "$_q_note_file"
  if ! awk 'index($0, "knotlog:reflect:start") || index($0, "quipu:reflect:start") { found = 1 } END { exit !found }' "$_q_note_file"; then
    _q_reflect_scaffold "$_q_note_file"
  fi

  # Anchor: the second "### " heading inside the first start..end pair, or
  # the end marker when the block has only one heading. Exits 1 when the
  # start marker has no end marker, so nothing below runs. Neither awk nor a
  # plain command substitution is trusted with CR here (some awk builds drop
  # it, and $(...) strips the CR before an LF); the last byte goes through od.
  _q_anchor=$(awk '
    { line[NR] = $0 }
    END {
      s = 0
      for (i = 1; i <= NR; i++) if ((index(line[i], "knotlog:reflect:start") || index(line[i], "quipu:reflect:start"))) { s = i; break }
      if (s == 0) exit 1
      e = 0
      for (i = s + 1; i <= NR; i++) if ((index(line[i], "knotlog:reflect:end") || index(line[i], "quipu:reflect:end"))) { e = i; break }
      if (e == 0) exit 1
      at = e
      cnt = 0
      for (i = s + 1; i < e; i++) if (substr(line[i], 1, 4) == "### ") { cnt++; if (cnt == 2) { at = i; break } }
      print at
    }' "$_q_note_file") || _q_die err_note_block 1
  _q_crs=
  if [ "$(tail -n "+$_q_anchor" "$_q_note_file" | head -n 1 | tr -d '\n' | tail -c 1 | od -An -c | tr -d ' ')" = '\r' ]; then
    _q_crs=$_q_cr
  fi
  printf '%s %s %s%s\n' '-' "$_q_now" "$_q_note_text" "$_q_crs" > "$_q_note_line"
  if ! {
    head -n "$((_q_anchor - 1))" "$_q_note_file"
    cat "$_q_note_line"
    tail -n "+$_q_anchor" "$_q_note_file"
  } > "$_q_note_tmp" || ! mv "$_q_note_tmp" "$_q_note_file"; then
    _q_die err_note_write 1 "$_q_rel"
  fi

  # shellcheck disable=SC2059
  printf "$(_q_msg note_ok)\n" "$_q_rel"
}

# ---- compile ---------------------------------------------------------------

_q_cmd_compile() {
  [ "$#" -eq 0 ] || _q_die err_unknown_flag 2 "$1"
  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  [ -f "$_q_v/$_q_SD/index.tsv" ] || _q_die err_no_index
  _q_tab=$(printf '\t')
  _q_cp=$(_q_compiled_path "$_q_v")
  _q_cpre=${_q_cp#"$_q_v"/}/
  mkdir -p "$_q_cp" || exit 1
  _q_tmp=$(mktemp -d "${TMPDIR:-/tmp}/quipu-compile-XXXXXX") || exit 1
  trap 'rm -rf "$_q_tmp"' EXIT HUP INT TERM
  awk -F"$_q_tab" '{if ($1 != "") print $1}' "$_q_v/$_q_SD/index.tsv" | sort > "$_q_tmp/paths.txt"
  Q_COMPILE_VAULT="$_q_v" awk -v mode=scan \
    -v indexfile="$_q_v/$_q_SD/index.tsv" \
    -v pathsfile="$_q_tmp/paths.txt" \
    -v compiled_prefix="$_q_cpre" \
    -f "$_q_HOME/lib/compile.awk" </dev/null > "$_q_tmp/events.tsv"
  if [ -s "$_q_tmp/events.tsv" ]; then
    LC_ALL=C sort -t "$_q_tab" -k2,2 -k1,1 -k3,3 -k4,4 "$_q_tmp/events.tsv" > "$_q_tmp/events.sorted"
  else
    : > "$_q_tmp/events.sorted"
  fi
  _q_compile_count=$(Q_COMPILE_VAULT="$_q_v" awk -v mode=render \
    -v outdir="$_q_cp" \
    -v status_file="$_q_HOME/layout/status.txt" \
    -v band="$(_q_msg compile_band)" \
    -v first_label="$(_q_msg compile_first)" \
    -v last_label="$(_q_msg compile_last)" \
    -v count_label="$(_q_msg compile_occurrences)" \
    -v timeline_label="$(_q_msg compile_timeline)" \
    -v timeline_empty="$(_q_msg compile_timeline_empty)" \
    -v pointer_label="$(_q_msg compile_pointers)" \
    -v comention_label="$(_q_msg compile_comention)" \
    -v source_label="$(_q_msg compile_source)" \
    -v source_text="$(_q_msg compile_source_text)" \
    -f "$_q_HOME/lib/compile.awk" "$_q_tmp/events.sorted")
  _q_fmt=$(_q_msg compile_summary)
  # shellcheck disable=SC2059
  printf "$_q_fmt\n" "$_q_compile_count"
}

# ---- index ------------------------------------------------------------------

_q_cmd_index() {
  _q_full=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --full) _q_full=1 ;;
      *) usage; exit 2 ;;
    esac
    shift
  done

  _q_v=$(_q_vault)
  if [ -z "$_q_v" ]; then
    _q_die err_no_vault
  fi

  # V1-DUZELTME R-4: profile comes from the single helper, not a local copy.
  _q_prof=$(_q_fold_prof "$_q_v")

  _q_tmp=$(mktemp -d "${TMPDIR:-/tmp}/quipu-index-XXXXXX") || exit 1
  trap 'rm -rf "$_q_tmp"' EXIT HUP INT TERM

  _q_tab=$(printf '\t')

  # FAZ 10 Z-2: index.tsv now carries 7 columns. A pre-FAZ10 (5-column) file
  # is detected here (by column count, no user prompt) and forces the same
  # path as --full: every row becomes stale, nothing is "reused" from a row
  # shaped for the old schema. NF is a plain awk field count, not a regex.
  if [ "$_q_full" -eq 0 ] && [ -s "$_q_v/$_q_SD/index.tsv" ]; then
    if ! awk -F"$_q_tab" 'NR==1{exit !(NF>=7)}' "$_q_v/$_q_SD/index.tsv"; then
      _q_full=1
    fi
  fi

  # Block index (2026-09-30): an index built before blocks.tsv existed has no
  # block rows for its over-cap notes and would "reuse" them as they are, so
  # the missing file forces the same full rebuild (no --full needed). An empty
  # index has nothing to lose; blocks.tsv is written by every run after this.
  if [ "$_q_full" -eq 0 ] && [ -s "$_q_v/$_q_SD/index.tsv" ] && [ ! -f "$_q_v/$_q_SD/blocks.tsv" ]; then
    _q_full=1
  fi

  # Alias field (2026-09-30): rows written before frontmatter `aliases:` went
  # into the search field cannot be told apart from current ones by mtime, so
  # .quipu/index.schema records which row shape the index was built with; any
  # other value (or none) forces the same full rebuild. Written at the end of
  # every successful run.
  if [ "$_q_full" -eq 0 ] && [ -s "$_q_v/$_q_SD/index.tsv" ]; then
    _q_schema=
    [ ! -f "$_q_v/$_q_SD/index.schema" ] || read -r _q_schema < "$_q_v/$_q_SD/index.schema" || true
    [ "$_q_schema" = 3 ] || _q_full=1
  fi

  # Version stamp (2026-10-16): the Knotlog version that wrote the index is kept
  # in .knotlog/index.version. A different version (or none, e.g. an index from
  # before the stamp existed) forces one full rebuild, without --full. Written
  # at the end of every successful run, next to index.schema.
  if [ "$_q_full" -eq 0 ] && [ -s "$_q_v/$_q_SD/index.tsv" ]; then
    _q_ver=
    [ ! -f "$_q_v/$_q_SD/index.version" ] || read -r _q_ver < "$_q_v/$_q_SD/index.version" || true
    [ "$_q_ver" = "$_q_version" ] || _q_full=1
  fi

  _q_old="$_q_tmp/old.tsv"
  if [ "$_q_full" -eq 1 ] || [ ! -f "$_q_v/$_q_SD/index.tsv" ]; then
    : > "$_q_old"
  else
    cp "$_q_v/$_q_SD/index.tsv" "$_q_old"
  fi

  # FAZ 10 Z-5: links.tsv rows follow the SAME reuse/stale split as
  # index.tsv — a reused/carried doc's outgoing links are carried forward
  # from the previous links.tsv (no re-scan); a stale doc is rescanned in
  # the SAME per-file loop below (no second pass over the vault).
  _q_links_old="$_q_tmp/links_old.tsv"
  if [ "$_q_full" -eq 1 ] || [ ! -f "$_q_v/$_q_SD/links.tsv" ]; then
    : > "$_q_links_old"
  else
    cp "$_q_v/$_q_SD/links.tsv" "$_q_links_old"
  fi
  : > "$_q_tmp/kept_paths.txt"
  : > "$_q_tmp/links_new.tsv"

  # Block rows (blocks.tsv) follow the same reuse/stale split as links.tsv:
  # kept notes' rows are carried, stale notes' rows are rebuilt by flatjoin.
  _q_blocks_old="$_q_tmp/blocks_old.tsv"
  if [ "$_q_full" -eq 1 ] || [ ! -f "$_q_v/$_q_SD/blocks.tsv" ]; then
    : > "$_q_blocks_old"
  else
    cp "$_q_v/$_q_SD/blocks.tsv" "$_q_blocks_old"
  fi
  : > "$_q_tmp/blocks_new.tsv"

  (cd "$_q_v" && _q_mdlist) > "$_q_tmp/all.txt"

  if [ "$_q_full" -eq 1 ] || [ ! -f "$_q_v/$_q_SD/index.tsv" ]; then
    cp "$_q_tmp/all.txt" "$_q_tmp/changed.txt"
  else
    (cd "$_q_v" && _q_mdlist "$_q_SD/index.tsv") > "$_q_tmp/changed.txt"
  fi

  # FAZ 11 F-5: batch stat, not one subshell + one `stat` per changed file
  # (quipu:1219 pre-FAZ11 shape — B-3/B-4 in docs/FAZ11-BULGULAR.md). Process
  # count drops to roughly len(changed.txt)/200 + a fixed handful, not
  # 2 * len(changed.txt).
  (cd "$_q_v" && _q_nul_list < "$_q_tmp/changed.txt" > "$_q_tmp/changed.nul" && _q_stat_batch "$_q_tmp/changed.nul" "$_q_tmp/stat_raw.txt") > "$_q_tmp/cur.txt"

  # FAZ 11 F-2: the five-stage batch pipeline that replaces the old
  # per-stale-file loop (B-1 in docs/FAZ11-BULGULAR.md: 8 external process
  # spawns for EVERY stale file). Every stage below runs a FIXED number of
  # processes no matter how many files are stale — only mode=scan's internal
  # getline loop and mode=flatjoin's stream scale with file count, and
  # neither forks anything to do it.
  : > "$_q_tmp/raw.txt"
  : > "$_q_tmp/bounds.tsv"
  : > "$_q_tmp/meta.tsv"

  # Stage 1 (existing mode=plan, expanded): plan.txt as before, PLUS a
  # stalepathsout side output — the bare stale paths, streamed out as
  # mode=plan detects them, with no second read of plan.txt needed to
  # extract them. This file becomes stage 2's pathsfile directly.
  awk -v mode=plan -v oldfile="$_q_tmp/old.tsv" -v allfile="$_q_tmp/all.txt" \
    -v stalepathsout="$_q_tmp/stale_paths.txt" -f "$_q_HOME/lib/index.awk" \
    "$_q_tmp/old.tsv" "$_q_tmp/cur.txt" "$_q_tmp/all.txt" > "$_q_tmp/plan.txt"

  # Stage 2 (mode=scan, F-3): one awk process reads every stale file via
  # getline and emits meta.tsv/links_new.tsv/bounds.tsv/raw.txt in a single
  # pass — no second read of any file (FAZ 10 Z-5 generalized).
  (cd "$_q_v" && awk -v mode=scan -v pathsfile="$_q_tmp/stale_paths.txt" \
    -v rawout="$_q_tmp/raw.txt" -v boundsout="$_q_tmp/bounds.tsv" \
    -v metaout="$_q_tmp/meta.tsv" -v linksout="$_q_tmp/links_new.tsv" \
    -f "$_q_HOME/lib/index.awk" </dev/null)

  # Stages 3+4 (ONE sed|tr pass over the combined raw stream, then
  # mode=flatjoin, F-4): folds/lowercases every stale file's content in a
  # single pipeline invocation, then mode=flatjoin re-splits it back into
  # per-file segments purely by bounds.tsv's line counts (no text
  # delimiter) and joins each with its meta.tsv row.
  # shellcheck disable=SC2018,SC2019
  (cd "$_q_v" && sed -f "$_q_HOME/fold/$_q_prof.sed" "$_q_tmp/raw.txt" | tr 'A-Z' 'a-z' | \
    awk -v mode=flatjoin -v boundsfile="$_q_tmp/bounds.tsv" -v metafile="$_q_tmp/meta.tsv" \
    -v blocksout="$_q_tmp/blocks_new.tsv" -f "$_q_HOME/lib/index.awk" > "$_q_tmp/joined.tsv")

  # Stage 5 (mode=assemble, F-6): re-walks plan.txt in its ORIGINAL order,
  # printing reuse/carry rows verbatim and stale rows joined from stage 4's
  # table — this is index.tsv's final form, row order matching plan.txt
  # (and so matching the pre-FAZ11 per-file loop's order too).
  awk -v mode=assemble -v joinfile="$_q_tmp/joined.tsv" -v planfile="$_q_tmp/plan.txt" \
    -v keptout="$_q_tmp/kept_paths.txt" -v countsout="$_q_tmp/counts.txt" \
    -f "$_q_HOME/lib/index.awk" "$_q_tmp/joined.tsv" "$_q_tmp/plan.txt" > "$_q_v/$_q_SD/index.tsv"

  read -r R S D < "$_q_tmp/counts.txt"
  N=$((R + S))

  # FAZ 10 Z-5: assemble links.tsv — carried rows (single join pass over the
  # old file, no per-doc re-read) plus the freshly scanned rows collected
  # above.
  if [ -s "$_q_links_old" ] && [ -s "$_q_tmp/kept_paths.txt" ]; then
    awk -F"$_q_tab" '
      FNR == NR { keep[$0] = 1; next }
      ($1 in keep) { print }
    ' "$_q_tmp/kept_paths.txt" "$_q_links_old" > "$_q_tmp/links_carried.tsv"
  else
    : > "$_q_tmp/links_carried.tsv"
  fi
  cat "$_q_tmp/links_carried.tsv" "$_q_tmp/links_new.tsv" > "$_q_v/$_q_SD/links.tsv"

  # Same carry for block rows: a kept note keeps its old rows, a dropped or
  # rebuilt note's old rows are not carried (only the fresh ones are added).
  if [ -s "$_q_blocks_old" ] && [ -s "$_q_tmp/kept_paths.txt" ]; then
    awk -F"$_q_tab" '
      FNR == NR { keep[$0] = 1; next }
      ($1 in keep) { print }
    ' "$_q_tmp/kept_paths.txt" "$_q_blocks_old" > "$_q_tmp/blocks_carried.tsv"
  else
    : > "$_q_tmp/blocks_carried.tsv"
  fi
  cat "$_q_tmp/blocks_carried.tsv" "$_q_tmp/blocks_new.tsv" > "$_q_v/$_q_SD/blocks.tsv"
  printf '3\n' > "$_q_v/$_q_SD/index.schema"
  printf '%s\n' "$_q_version" > "$_q_v/$_q_SD/index.version"

  # V1-DUZELTME R-6: on the hook path stdout stays empty (FAZ 5 H-7 rule,
  # now applied to `index` too — adapters run it on SessionEnd).
  if [ "${QUIPU_HOOK:-0}" = 1 ]; then
    return 0
  fi

  _q_fmt=$(_q_msg idx_summary)
  # shellcheck disable=SC2059
  printf "$_q_fmt" "$N" "$R" "$S" "$D"
  printf '\n'
}

# ---- search -----------------------------------------------------------------

_q_cmd_search() {
  _q_limit=10
  _q_paths=0
  _q_brief=0
  _q_tag=
  _q_all=0
  _q_status=
  _q_query=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --limit) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_limit=$2; shift 2 ;;
      --paths) _q_paths=1; shift ;;
      --brief) _q_brief=1; shift ;;
      --all) _q_all=1; shift ;;
      --tag) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_tag=$2; shift 2 ;;
      --status) [ "$#" -ge 2 ] || _q_die err_missing_arg 2; _q_status=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *)
        if [ -n "$_q_query" ]; then
          _q_query="$_q_query $1"
        else
          _q_query=$1
        fi
        shift
        ;;
    esac
  done

  if [ "$_q_brief" -eq 1 ] && [ "$_q_paths" -eq 1 ]; then
    _q_die err_conflict 2
  fi

  _q_v=$(_q_vault)

  # V1-DUZELTME R-4: same single helper as `quipu index` (was a copy, P-2).
  _q_prof=$(_q_fold_prof "$_q_v")

  # Fold the query with the same profile and order as the index (PLAN 4.3):
  # sed -f fold/PROFIL.sed, THEN tr 'A-Z' 'a-z'. SC2018/SC2019 suggest
  # [:upper:]/[:lower:], but BSD tr is byte-based; after folding, plain ASCII
  # ranges are safe on every platform.
  # shellcheck disable=SC2018,SC2019
  _q_terms=$(printf '%s\n' "$_q_query" | sed -f "$_q_HOME/fold/$_q_prof.sed" | tr 'A-Z' 'a-z')
  [ -n "$_q_terms" ] || _q_die err_empty_query 2

  [ -n "$_q_v" ] || _q_die err_no_vault
  [ -f "$_q_v/$_q_SD/index.tsv" ] || _q_die err_no_index

  # FAZ 10 Z-3/Z-4: --tag/--status fold through the SAME pipeline as the
  # query — the only category PLAN 4.16 allows through awk -v. Matched
  # against the RAW tag/status columns in search.awk: an unfolded tag such
  # as `#İstanbul` will not match `--tag istanbul` (documented limit, README).
  _q_tagf=
  if [ -n "$_q_tag" ]; then
    # shellcheck disable=SC2018,SC2019
    _q_tagf=$(printf '%s\n' "$_q_tag" | sed -f "$_q_HOME/fold/$_q_prof.sed" | tr 'A-Z' 'a-z')
  fi
  _q_statf=
  if [ -n "$_q_status" ]; then
    # shellcheck disable=SC2018,SC2019
    _q_statf=$(printf '%s\n' "$_q_status" | sed -f "$_q_HOME/fold/$_q_prof.sed" | tr 'A-Z' 'a-z')
  fi

  _q_tab=$(printf '\t')

  # FAZ 12 K-1: the old single `awk -v mode=bm25` call read index.tsv once
  # into four parallel per-document arrays, so memory grew with document
  # count (docs/FAZ12-SPEC.md E-1/E-2). BM25 needs two logical passes (df/
  # avgdl, then scoring); both now read index.tsv straight off disk instead
  # of an in-memory array, joined by a small dfstats scratch file whose size
  # is bounded by the QUERY term count, not the document count. The scratch
  # file lives under the vault's own .quipu/ dir (the same place agents.tmp/
  # claude.tmp already use for one-shot scratch output, PLAN 4.16 — never
  # /tmp, and never raw user data through awk -v) with the shell PID appended
  # so two concurrent `quipu search` calls in the same vault cannot collide.
  _q_df="$_q_v/$_q_SD/search-dfstats.$$"
  trap 'rm -f "$_q_df"' EXIT HUP INT TERM

  # Block index (2026-09-30): blocks.tsv holds the text past index.tsv's
  # 2000-character cap for long notes. Absent or empty -> /dev/null and the
  # pipeline below is exactly the pre-block one (no extra column, same sort).
  _q_bf="$_q_v/$_q_SD/blocks.tsv"
  _q_blk=0
  if [ -s "$_q_bf" ]; then
    _q_blk=1
  else
    _q_bf=/dev/null
  fi
  # Sort keys: score, then tags (as before); with block rows the internal
  # 0/1 kind column (5th, or 6th with --brief) comes last so a note row beats
  # its own block row on an equal score.
  _q_sortk="-k1,1nr -k4,4nr"
  if [ "$_q_blk" -eq 1 ]; then
    if [ "$_q_brief" -eq 1 ]; then _q_sortk="$_q_sortk -k6,6n"; else _q_sortk="$_q_sortk -k5,5n"; fi
  fi

  # Pass 1 (mode=bm25count): df/avgdl/n + fallback detection, streamed.
  awk -v mode=bm25count -v terms="$_q_terms" \
    -v tagf="$_q_tagf" -v statf="$_q_statf" \
    -v showall="$_q_all" \
    -v idxfile="$_q_v/$_q_SD/index.tsv" -v dfout="$_q_df" \
    -v blocksfile="$_q_bf" \
    -f "$_q_HOME/lib/search.awk" "$_q_v/$_q_SD/index.tsv" "$_q_bf"

  # Pass 2 (mode=bm25score): dfout first (FNR==NR join, same idiom as
  # lib/index.awk's mode=plan oldfile/allfile and mode=assemble joinfile),
  # then index.tsv again, scoring each surviving row from its own fields,
  # then the block rows the same way.
  # $_q_sortk is deliberately unquoted: it is a fixed list of sort options.
  # shellcheck disable=SC2086
  awk -v mode=bm25score -v terms="$_q_terms" -v brief="$_q_brief" -v snip=120 \
    -v tagf="$_q_tagf" -v statf="$_q_statf" \
    -v showall="$_q_all" \
    -v blocksfile="$_q_bf" -v blocks="$_q_blk" \
    -f "$_q_HOME/lib/search.awk" "$_q_df" "$_q_v/$_q_SD/index.tsv" "$_q_bf" \
    | sort $_q_sortk \
    | awk -v n="$_q_limit" -v p="$_q_paths" -v blk="$_q_blk" -F "$_q_tab" '
        # The limit lives HERE, not in `head -n`: head closes the pipe as soon
        # as it has enough lines, which hands `sort` a SIGPIPE and makes GNU and
        # BSD sort write "Broken pipe" to stderr. That noise is harmless to the
        # rows but it is real stderr output, and T-87 used to fold it into the
        # row file (CI 32576726590). awk drains the pipe instead, so sort always
        # finishes cleanly. At index scale the extra read is a few thousand lines.
        #
        # With block rows a path can appear twice (its note row and one or more
        # block rows). Rows arrive best-first, so the first row of a path wins
        # and later ones are skipped; only the (at most n) paths already shown
        # are remembered, so memory stays bounded by the limit.
        blk == 1 && ($2 in shown) { next }
        cnt >= n { next }
        {
          cnt++
          if (blk == 1) shown[$2] = 1
          if (p == 1) { print $2; next }
          if (blk == 1) {
            line = $1
            for (i = 2; i < NF; i++) line = line "\t" $i
            print line
          } else print $0
        }'

  rm -f "$_q_df"
}

# ---- links ------------------------------------------------------------------

_q_cmd_links() {
  _q_p=${1:-}
  [ -n "$_q_p" ] || _q_die err_missing_arg 2

  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  [ -f "$_q_v/$_q_SD/links.tsv" ] || _q_die err_no_index
  # _q_msg below reassigns the global $_q_v as a side effect (no `local` in
  # this codebase — same reason doctor re-derives $_q_v after calling
  # _q_msg bare); the links/index file paths are captured first so that is
  # harmless (FAZ 13 N-4 adds _q_if for the same reason as _q_lf).
  _q_lf="$_q_v/$_q_SD/links.tsv"
  _q_if="$_q_v/$_q_SD/index.tsv"
  # T-4xx: the argument the user typed is now resolved the same way a
  # wikilink target is (mode=resolve needs index.tsv's path/title columns
  # to do that), so index.tsv is required here too, not only links.tsv.
  [ -f "$_q_if" ] || _q_die err_no_index

  # The target path is user input, so it is never handed to awk via -v (PLAN
  # 4.16 — a Windows-style backslash path would be corrupted by -v's escape
  # processing). It flows as a one-line key FILE instead, the same pattern
  # oldfile/allfile already use for mode=plan.
  _q_keyf=$(mktemp "${TMPDIR:-/tmp}/quipu-links-XXXXXX") || exit 1
  _q_resf=$(mktemp "${TMPDIR:-/tmp}/quipu-links-resolve-XXXXXX") || exit 1
  _q_qf=$(mktemp "${TMPDIR:-/tmp}/quipu-links-query-XXXXXX") || exit 1
  trap 'rm -f "$_q_keyf" "$_q_resf" "$_q_qf"' EXIT HUP INT TERM

  _q_tab=$(printf '\t')

  # T-4xx (was M-1's sibling bug in the *argument*, not the incoming scan):
  # `quipu links <hedef>` used to require <hedef> to be the note's exact
  # vault path — a title or bare filename silently matched nothing and the
  # command printed empty sections either way, so "no links" and "wrong
  # argument" looked identical. The argument is now run through the SAME
  # mode=resolve staged lookup (exists -> title -> basename) that N-4 above
  # already uses for links.tsv rows, by feeding it as a one-row synthetic
  # links.tsv (kaynak is unused, only hedef=$_q_p matters). ambiguous/broken
  # are NOT silently dropped here the way N-4 drops ambiguous incoming rows
  # — this is the user's own argument, so they get told, not left staring
  # at empty output (spec: don't repeat M-1's silence one layer up).
  printf 'x\t%s\n' "$_q_p" > "$_q_qf"
  _q_qres=$(awk -v mode=resolve -f "$_q_HOME/lib/index.awk" "$_q_if" "$_q_qf")
  _q_qdurum=$(printf '%s\n' "$_q_qres" | awk -F"$_q_tab" '{print $3; exit}')
  _q_qbilgi=$(printf '%s\n' "$_q_qres" | awk -F"$_q_tab" '{print $4; exit}')
  case "$_q_qdurum" in
    ok)
      _q_key=$_q_qbilgi
      ;;
    ambiguous)
      _q_qcands=$(printf '%s' "$_q_qbilgi" | awk -F';' '{for (i = 1; i <= NF; i++) if ($i != "") printf "  - %s\n", $i}')
      _q_die err_links_ambiguous 1 "$_q_p" "$_q_qcands"
      ;;
    *)
      _q_die err_links_not_found 1 "$_q_p"
      ;;
  esac
  printf '%s\n' "$_q_key" > "$_q_keyf"

  _q_msg links_out
  awk -F"$_q_tab" '
    FNR == NR { key = $0; next }
    $1 == key { print $2 }
  ' "$_q_keyf" "$_q_lf"

  # FAZ 13 N-4: incoming resolves each links.tsv row's wikilink target to a
  # vault path via mode=resolve's staged exists/title/basename lookup
  # (N-1/N-2), instead of the old bare-name-plus-".md" string equality — a
  # wikilink written as a page TITLE ([[Doc A]]) now matches the note whose
  # title (or filename) is "Doc A", not only a literal path match (M-1).
  # durum=ambiguous rows are dropped here on purpose: silently picking one
  # candidate would repeat the M-1 mistake in a new place. doctor's
  # doc_links_ambiguous warns about them at the vault level instead — no
  # separate "ambiguous incoming" section in this command (N-4 scope note,
  # spec §11 Kapsam dışı).
  awk -v mode=resolve -f "$_q_HOME/lib/index.awk" "$_q_if" "$_q_lf" > "$_q_resf"

  _q_msg links_in
  awk -F"$_q_tab" '
    FNR == NR { key = $0; next }
    $3 == "ok" && $4 == key { print $1 }
  ' "$_q_keyf" "$_q_resf"
}

# ---- digest -----------------------------------------------------------------

# _q_digest_render DATE LOG BODY TMP -- writes one day's digest body to BODY.
# Returns 1 (BODY untouched) when LOG is missing or has no events on DATE.
_q_digest_render() {
  [ -f "$2" ] || return 1
  awk -v day="$1" 'substr($0, 1, 10) == day' "$2" > "$4"
  _q_fact=$(awk -v mode=digest -f "$_q_HOME/lib/digest.awk" "$4")
  _q_count=$(printf '%s\n' "$_q_fact" | awk -F"$(printf '\t')" '$1=="RANGE"{print $4;exit}')
  if [ -z "$_q_count" ] || [ "$_q_count" = 0 ]; then
    return 1
  fi
  _q_first=$(printf '%s\n' "$_q_fact" | awk -F"$(printf '\t')" '$1=="RANGE"{print $2;exit}')
  _q_last=$(printf '%s\n' "$_q_fact" | awk -F"$(printf '\t')" '$1=="RANGE"{print $3;exit}')
  _q_tools=$(printf '%s\n' "$_q_fact" | awk -F"$(printf '\t')" 'BEGIN{OFS=sprintf("%c",9)} $1=="TOOL"{print $2,$3}' | sort -t "$(printf '\t')" -k2,2nr | awk -F"$(printf '\t')" '{if(first)printf ", ";printf "%s %s",$1,$2;first=1}')
  {
    printf '%s\n' '---'
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_title)\n" "$1"
    printf '%s\n' 'type: digest'
    printf '%s\n' 'status: generated'
    printf '%s\n' '---'
    printf '\n'
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_range)\n" "$_q_first" "$_q_last" "$_q_count"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_tools)\n" "$_q_tools"
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_files)\n" "$_q_limit"
    printf '%s\n' "$_q_fact" | awk -F"$(printf '\t')" '$1=="FILE"{print $2 "\t" $3}' | sort -t "$(printf '\t')" -k2,2nr | awk -F"$(printf '\t')" -v n="$_q_limit" 'NR<=n{printf "- %s (%s)\n",$1,$2}'
  } > "$3"
}

_q_cmd_digest() {
  _q_date=
  _q_date_given=0
  _q_since=
  _q_until=
  _q_range=0
  _q_until_given=0
  _q_limit=10
  _q_dry=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --date)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        _q_date=$2
        _q_date_given=1
        shift 2
        ;;
      --since)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        _q_since=$2
        _q_range=1
        shift 2
        ;;
      --until)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        _q_until=$2
        _q_until_given=1
        shift 2
        ;;
      --limit)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        _q_limit=$2
        shift 2
        ;;
      --dry-run) _q_dry=1; shift ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_missing_arg 2 ;;
    esac
  done
  case "$_q_limit" in
    ''|*[!0-9]*) _q_die err_limit 2 "$_q_limit" ;;
  esac
  [ "$_q_limit" -gt 0 ] || _q_die err_limit 2 "$_q_limit"
  if [ "$_q_range" -eq 1 ] && [ "$_q_date_given" -eq 1 ]; then
    _q_die err_digest_conflict 2
  fi
  if [ "$_q_range" -eq 0 ] && [ "$_q_until_given" -eq 1 ]; then
    _q_die err_digest_until_alone 2
  fi
  if [ "$_q_range" -eq 1 ]; then
    [ "$_q_until_given" -eq 1 ] || _q_until=$(date +%Y-%m-%d)
    case "$_q_since" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
      *) _q_die err_import_date 2 "$_q_since" ;;
    esac
    case "$_q_until" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
      *) _q_die err_import_date 2 "$_q_until" ;;
    esac
  else
    [ "$_q_date_given" -eq 1 ] || _q_date=$(date +%Y-%m-%d)
    case "$_q_date" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
      *) _q_die err_import_date 2 "$_q_date" ;;
    esac
  fi

  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  _q_log="$_q_v/$_q_SD/activity.log"
  _q_tmp=$(mktemp "${TMPDIR:-/tmp}/quipu-digest-XXXXXX") || exit 1
  _q_body=$(mktemp "${TMPDIR:-/tmp}/quipu-digest-body-XXXXXX") || exit 1
  trap 'rm -f "$_q_tmp" "$_q_body"' EXIT HUP INT TERM
  _q_tab=$(printf '\t')
  _q_layout=$(awk -F= '$1=="layout"{print $2;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  _q_layout_ok "$_q_layout" || _q_layout=emoji
  if [ "$_q_range" -eq 1 ]; then
    # Range: session-note file names YYYY-MM-DD.md inside the sessions folder
    # select the days (string order = date order); each day prints the same
    # body as --date. A day without events prints the digest_empty line.
    _q_sessions=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_layout.txt" 2>/dev/null || true)
    [ -n "$_q_sessions" ] || _q_sessions='📆 700-Sessions'
    _q_days=$(for _q_f in "$_q_v/$_q_sessions"/*.md; do
      [ -f "$_q_f" ] || continue
      basename "$_q_f" .md
    done | awk -v a="$_q_since" -v b="$_q_until" '/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && $0 >= a && $0 <= b')
    if [ -z "$_q_days" ]; then
      # shellcheck disable=SC2059
      printf "$(_q_msg digest_range_none)\n" "$_q_since" "$_q_until"
      exit 0
    fi
    for _q_d in $_q_days; do
      if _q_digest_render "$_q_d" "$_q_log" "$_q_body" "$_q_tmp"; then
        cat "$_q_body"
      else
        # shellcheck disable=SC2059
        printf "$(_q_msg digest_empty)\n" "$_q_d"
      fi
    done
    exit 0
  fi
  if ! _q_digest_render "$_q_date" "$_q_log" "$_q_body" "$_q_tmp"; then
    # shellcheck disable=SC2059
    printf "$(_q_msg digest_empty)\n" "$_q_date"
    exit 0
  fi
  _q_dump=$(awk -F"$_q_tab" '$1=="dump"{print $2;exit}' "$_q_HOME/layout/$_q_layout.txt")
  [ -n "$_q_dump" ] || _q_dump='📥 000-Inbox/Dump'
  _q_rel="$_q_dump/$_q_date-digest.md"
  if [ "$_q_dry" -eq 1 ]; then
    cat "$_q_body"
    exit 0
  fi
  mkdir -p "$_q_v/$_q_dump"
  cat "$_q_body" > "$_q_v/$_q_rel"
  # shellcheck disable=SC2059
  printf "$(_q_msg digest_written)\n" "$_q_rel"
}

# ---- import -----------------------------------------------------------------

_q_cmd_import() {
  _q_file=
  _q_date=$(date +%Y-%m-%d)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --date)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        _q_date=$2
        shift 2
        ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *)
        [ -z "$_q_file" ] || _q_die err_missing_arg 2
        _q_file=$1
        shift
        ;;
    esac
  done
  case "$_q_date" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
    *) _q_die err_import_date 2 "$_q_date" ;;
  esac
  [ -n "$_q_file" ] || _q_die err_import_file 2 "$_q_file"
  if [ ! -f "$_q_file" ] || [ ! -r "$_q_file" ]; then
    _q_die err_import_file 2 "$_q_file"
  fi
  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  _q_tmp=$(mktemp "${TMPDIR:-/tmp}/quipu-import-XXXXXX") || exit 1
  trap 'rm -f "$_q_tmp"' EXIT HUP INT TERM
  tr -d '\r\n' < "$_q_file" > "$_q_tmp"
  _q_count=$(awk -v mode=count -f "$_q_HOME/lib/jsonfield.awk" -f "$_q_HOME/lib/import.awk" "$_q_tmp")
  if [ -z "$_q_count" ] || [ "$_q_count" = 0 ]; then
    _q_die err_import_format 2 "$_q_file"
  fi
  _q_layout=$(awk -F= '$1=="layout"{print $2;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  _q_layout_ok "$_q_layout" || _q_layout=emoji
  _q_tab=$(printf '\t')
  _q_sessions=$(awk -F"$_q_tab" '$1=="sessions"{print $2;exit}' "$_q_HOME/layout/$_q_layout.txt")
  [ -n "$_q_sessions" ] || _q_sessions='📆 700-Sessions'
  _q_base=$(basename -- "$_q_file")
  _q_sep=$(awk 'BEGIN{printf "%c",92}')
  case "$_q_base" in
    *"$_q_sep"*) _q_base=${_q_base##*"$_q_sep"} ;;
  esac
  _q_slug=$(printf '%s' "$_q_base" | tr -c 'A-Za-z0-9._-' '_')
  [ -n "$_q_slug" ] || _q_slug=conversation
  _q_rel="$_q_sessions/$_q_date-import-$_q_slug.md"
  _q_suffix=1
  while [ -e "$_q_v/$_q_rel" ]; do
    _q_rel="$_q_sessions/$_q_date-import-$_q_slug-$_q_suffix.md"
    _q_suffix=$((_q_suffix + 1))
  done
  mkdir -p "$_q_v/$_q_sessions"
  awk -f "$_q_HOME/lib/jsonfield.awk" -f "$_q_HOME/lib/import.awk" "$_q_tmp" > "$_q_v/$_q_rel"
  # shellcheck disable=SC2059
  printf "$(_q_msg import_written)\n" "$_q_rel"
}

# ---- plan (B11) --------------------------------------------------------------

_q_cmd_plan() {
  # quipu plan <ad> [--proje <Proje>] -- open a project plan under
  # <projects>/<Proje>/<plans_dir>/<ad>.md from the localized front-matter
  # template. The deliberate edges (B11 spec): a MISSING project folder is
  # an error, never auto-created -- creating a project is the user's
  # decision, not the tool's; the plans DIRECTORY inside an existing
  # project is the resolver's job and is created when absent; an existing
  # plan file is never overwritten.
  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  _q_pl_name=
  _q_pl_proj=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --proje)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        case "$2" in
          -*) _q_die err_unknown_flag 2 "$2" ;;
        esac
        _q_pl_proj=$2; shift 2 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *)
        [ -z "$_q_pl_name" ] || _q_die err_plan_extra_arg 2 "$1"
        _q_pl_name=$1; shift ;;
    esac
  done
  [ -n "$_q_pl_name" ] || _q_die err_missing_arg 2
  case "$_q_pl_name" in
    */*|.|..) _q_die err_plan_name 2 "$_q_pl_name" ;;
  esac
  case "$_q_pl_name" in
    *.md) ;;
    *) _q_pl_name="$_q_pl_name.md" ;;
  esac

  # Project resolution: --proje wins; otherwise the project folder the
  # caller is currently working in (inside the vault's projects folder)
  # counts as resolved; anything else is an error, never a guess.
  _q_pl_tab=$(printf '\t')
  _q_pl_lay=$(awk -F= -v k=layout '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_v/$_q_SD/config" 2>/dev/null || true)
  _q_layout_ok "$_q_pl_lay" || _q_pl_lay=emoji
  _q_pl_pdir=$(awk -F"$_q_pl_tab" -v k=projects '$1==k{print $2;exit}' "$_q_HOME/layout/$_q_pl_lay.txt" 2>/dev/null || true)
  if [ -z "$_q_pl_proj" ]; then
    _q_pl_pwd=$PWD
    case "$_q_pl_pwd" in
      "$_q_v"/"$_q_pl_pdir"/*)
        _q_pl_rel=${_q_pl_pwd#"$_q_v/$_q_pl_pdir/"}
        _q_pl_proj=${_q_pl_rel%%/*}
        ;;
    esac
  fi
  if [ -z "$_q_pl_proj" ] || [ -z "$_q_pl_pdir" ]; then
    _q_die err_plan_project_required 2
  fi
  _q_pl_projdir="$_q_v/$_q_pl_pdir/$_q_pl_proj"
  if [ ! -d "$_q_pl_projdir" ]; then
    _q_die err_plan_project_missing 2 "$_q_pl_projdir"
  fi

  _q_pl_dir=$(_q_plans_dir_path "$_q_pl_projdir")
  if [ ! -d "$_q_pl_dir" ]; then
    mkdir -p "$_q_pl_dir" || _q_die err_plan_mkdir 2 "$_q_pl_dir"
  fi
  _q_pl_file="$_q_pl_dir/$_q_pl_name"
  if [ -e "$_q_pl_file" ]; then
    _q_die err_plan_exists 1 "$_q_pl_file"
  fi

  _q_pl_lang=$(_q_lang)
  if [ ! -f "$_q_HOME/templates/$_q_pl_lang/plan.md" ]; then
    _q_pl_lang=en
  fi
  if [ ! -f "$_q_HOME/templates/$_q_pl_lang/plan.md" ]; then
    _q_die err_plan_template 2 "$_q_HOME/templates/$_q_pl_lang/plan.md"
  fi
  # Fill the skeleton: today's date into the front matter, the plan name
  # into title and the H1. Values travel through ENVIRON, not awk -v:
  # -v interprets backslash escapes, a plan name must land verbatim.
  Q_PLAN_TITLE=${_q_pl_name%.md} Q_PLAN_DATE=$(date +%Y-%m-%d) awk '
    BEGIN { t = ENVIRON["Q_PLAN_TITLE"]; d = ENVIRON["Q_PLAN_DATE"] }
    $0 == "title: " { print "title: " t; next }
    $0 == "# " { print "# " t; next }
    { gsub(/YYYY-MM-DD/, d); print }
  ' "$_q_HOME/templates/$_q_pl_lang/plan.md" > "$_q_pl_file" || _q_die err_plan_template 2 "$_q_HOME/templates/$_q_pl_lang/plan.md"

  # shellcheck disable=SC2059
  printf "$(_q_msg plan_written)\n" "$_q_pl_file"
  if [ -n "${EDITOR:-}" ]; then
    "$EDITOR" "$_q_pl_file"
  fi
}

# ---- archive ----------------------------------------------------------------

_q_cmd_archive() {
  # B-K3 (Konular-Butce-Tasmasi.md): moves ONE closed/stale section of the
  # threads file into a separate, append-only archive file, so a vault
  # that has accreted years of history can shrink the file `quipu context`
  # crops from without losing a single byte of what it wrote down.
  #
  # Deliberately NOT automatic. Which topic is "closed" is a judgment call
  # only the user can make (init_no_prompt: 09-06 KB1/2/4's whole point was
  # that quipu cannot infer meaning from bytes) -- this command never runs
  # on its own, has no cron/hook wiring anywhere in this repo, and is
  # invoked by heading text, not by age or any other guess.
  #
  # Interface choice: a single positional argument naming a heading's
  # TRIMMED TEXT (after its leading "#"s), matched by plain string
  # equality against every heading in the threads file -- chosen over (a)
  # a byte/line-range argument, which forces the user to first `cat -n`
  # the file and is one manual miscount away from cutting a thread in
  # half, and (b) an interactive picker, which cannot run under
  # QUIPU_HOOK=1 or in a script and would make the command untestable
  # headlessly. `--list` (below) exists precisely so the user never has to
  # open the file to learn the exact heading text to pass.
  #
  # Destructive-action contract (sözleşme #7): every run FIRST prints what
  # it is about to do (archive_preview: heading, line count, source path,
  # destination path) before touching any file; `--dry-run` stops right
  # there. This is the same shape _q_cmd_uninstall already uses (print,
  # then either --dry-run or act) -- not a second, novel confirmation UI.
  #
  # Never-truncated boundary (sözleşme #5): a heading whose line sits
  # inside the <!-- knotlog:pin:start/end --> block is refused outright
  # (STATUS PINNED from lib/archive.awk) -- the pin block is the vault's
  # single most protected content, B-K1's entire reason to exist, and
  # `archive` moving part of it out from under the user would be exactly
  # the silent-loss failure class this whole plan document is about.
  #
  # Append-only contract (sözleşme #3): the archive file is only ever
  # opened with `>>`. An existing archive is read (to decide whether a
  # leading blank line is needed) but never rewritten, matching "quipu bu
  # dosyaları asla yeniden yazmaz" for every other memory file in this
  # project (Konular.md/Kurallar.md/companion.md/Gerçekler.md all share
  # this rule; the archive file just joins the list).
  _q_ar_dry=0
  _q_ar_list=0
  _q_ar_heading=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) _q_ar_dry=1; shift ;;
      --list) _q_ar_list=1; shift ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *)
        [ -z "$_q_ar_heading" ] || _q_die err_archive_extra_arg 2 "$1"
        _q_ar_heading=$1
        shift
        ;;
    esac
  done

  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault

  _q_ar_thr=$(_q_threads_path "$_q_v")
  if [ ! -f "$_q_ar_thr" ]; then
    _q_die err_archive_no_threads 1 "$_q_ar_thr"
  fi

  if [ "$_q_ar_list" -eq 1 ]; then
    [ -z "$_q_ar_heading" ] || _q_die err_conflict 2
    _q_ar_rows=$(awk -v mode=list -f "$_q_HOME/lib/archive.awk" "$_q_ar_thr")
    if [ -z "$_q_ar_rows" ]; then
      _q_msg archive_list_empty
      return 0
    fi
    _q_msg archive_list_header
    _q_ar_tab=$(printf '\t')
    printf '%s\n' "$_q_ar_rows" | while IFS="$_q_ar_tab" read -r _q_ar_row_pin _q_ar_row_txt; do
      if [ "$_q_ar_row_pin" = pin ]; then
        _q_ar_rfmt=$(_q_msg archive_list_row_pinned)
      else
        _q_ar_rfmt=$(_q_msg archive_list_row)
      fi
      # shellcheck disable=SC2059
      printf "$_q_ar_rfmt\n" "$_q_ar_row_txt"
    done
    return 0
  fi

  [ -n "$_q_ar_heading" ] || _q_die err_missing_arg 2

  _q_ar_res=$(Q_AR_TARGET="$_q_ar_heading" awk -v mode=analyze -f "$_q_HOME/lib/archive.awk" "$_q_ar_thr")
  _q_ar_tab=$(printf '\t')
  _q_ar_status=$(printf '%s\n' "$_q_ar_res" | awk -F"$_q_ar_tab" 'NR==1{print $2}')

  case "$_q_ar_status" in
    NOTFOUND) _q_die err_archive_not_found 1 "$_q_ar_heading" ;;
    AMBIGUOUS) _q_die err_archive_ambiguous 1 "$_q_ar_heading" ;;
    PINNED) _q_die err_archive_pinned 1 "$_q_ar_heading" ;;
    OK) : ;;
    *) _q_die err_archive_not_found 1 "$_q_ar_heading" ;;
  esac

  _q_ar_start=$(printf '%s\n' "$_q_ar_res" | awk -F"$_q_ar_tab" 'NR==1{print $3}')
  _q_ar_end=$(printf '%s\n' "$_q_ar_res" | awk -F"$_q_ar_tab" 'NR==1{print $4}')
  _q_ar_lines=$((_q_ar_end - _q_ar_start + 1))

  _q_ar_dst=$(_q_archive_path "$_q_v")
  _q_ar_thr_name=${_q_ar_thr#"$_q_v"/}
  _q_ar_dst_name=${_q_ar_dst#"$_q_v"/}

  _q_ar_pfmt=$(_q_msg archive_preview)
  # shellcheck disable=SC2059
  printf "$_q_ar_pfmt\n" "$_q_ar_heading" "$_q_ar_lines" "$_q_ar_thr_name" "$_q_ar_dst_name"

  if [ "$_q_ar_dry" -eq 1 ]; then
    _q_msg archive_dry_run_note
    return 0
  fi

  _q_ar_dstdir=$(dirname "$_q_ar_dst")
  if [ ! -d "$_q_ar_dstdir" ]; then
    mkdir -p "$_q_ar_dstdir" || _q_die err_archive_mkdir 2 "$_q_ar_dstdir"
  fi

  # Append-only: the section's exact lines stream STRAIGHT from `sed -n`
  # into the destination (`>>`), never through a $()-captured shell
  # variable -- command substitution strips trailing newlines, which would
  # silently reshape a section whose last archived line is blank. A
  # literal HTML-comment marker (matching the knotlog:pin/knotlog:threads
  # convention of an untranslated literal marker, not an i18n key) is
  # written immediately BEFORE the section, never inside it, so the
  # archived bytes themselves stay untouched.
  _q_ar_had_content=0
  [ -s "$_q_ar_dst" ] && _q_ar_had_content=1
  {
    [ "$_q_ar_had_content" -eq 1 ] && printf '\n'
    printf '<!-- knotlog:archived %s from=%s -->\n' "$(date +%Y-%m-%d)" "$_q_ar_thr_name"
    # head/tail, not sed: sed drops the CR of CRLF lines on Windows (see compact).
    tail -n +"$_q_ar_start" "$_q_ar_thr" | head -n "$_q_ar_lines"
  } >> "$_q_ar_dst" || _q_die err_archive_write 2 "$_q_ar_dst"

  # Remove the archived lines from the source -- the >tmp&&mv idiom
  # `quipu tone` already uses for `.quipu/config`, not `sed -i` (BSD sed
  # requires an extension argument to -i that GNU sed instead treats as a
  # literal suffix, so a single `-i` spelling is not portable across the
  # two -- PLAN's own portability rule, unrelated to this feature).
  _q_ar_tmp="$_q_ar_thr.archive-tmp.$$"
  if { head -n "$(( _q_ar_start - 1 ))" "$_q_ar_thr"; tail -n +"$(( _q_ar_end + 1 ))" "$_q_ar_thr"; } > "$_q_ar_tmp"; then
    mv "$_q_ar_tmp" "$_q_ar_thr"
  else
    rm -f "$_q_ar_tmp"
    _q_die err_archive_write 2 "$_q_ar_thr"
  fi

  _q_ar_dfmt=$(_q_msg archive_done)
  # shellcheck disable=SC2059
  printf "$_q_ar_dfmt\n" "$_q_ar_dst_name"
}

_q_cp_emit() {
  # The exact byte stream `compact --apply` appends to the archive: a blank
  # separator line when the archive already holds text, a literal marker
  # line, then lines $2..$3 of the threads file $1 verbatim. Called twice
  # (once to append, once to re-derive the expected bytes for the
  # verification), so both come from the SOURCE, never from a copy of the
  # first. $_q_cp_had, $_q_cp_day and $_q_cp_srcname are set by the caller.
  # head/tail, not sed/awk: on Windows (Git Bash, MSYS) sed and awk drop the
  # CR of a CRLF line on output, head and tail keep it (measured, T-650).
  [ "$_q_cp_had" -eq 1 ] && printf '\n'
  printf '<!-- knotlog:compacted %s from=%s -->\n' "$_q_cp_day" "$_q_cp_srcname"
  tail -n +"$2" "$1" | head -n "$(( $3 - $2 + 1 ))"
}

_q_cp_move() {
  # The apply sequence shared by both compact targets. $1 source file,
  # $2..$3 first/last line to move, $4 their byte count, $5 archive file.
  # Needs $_q_cp_srcname and $_q_v from the caller; dies on any failed step
  # before the cut, so the source is untouched on error.
  _q_cp_thr=$1; _q_cp_s=$2; _q_cp_e=$3; _q_cp_bytes=$4; _q_cp_dst=$5
  _q_cp_dstname=${_q_cp_dst#"$_q_v"/}
  _q_cp_dstdir=$(dirname "$_q_cp_dst")
  if [ ! -d "$_q_cp_dstdir" ]; then
    mkdir -p "$_q_cp_dstdir" || _q_die err_archive_mkdir 2 "$_q_cp_dstdir"
  fi

  _q_cp_day=$(date +%Y-%m-%d)
  _q_cp_had=0
  [ -s "$_q_cp_dst" ] && _q_cp_had=1
  _q_cp_before=0
  [ -f "$_q_cp_dst" ] && _q_cp_before=$(wc -c < "$_q_cp_dst" | tr -d ' ')
  _q_cp_t1="$_q_v/$_q_SD/compact.$$.chunk"
  _q_cp_t2="$_q_v/$_q_SD/compact.$$.check"
  _q_cp_t3="$_q_v/$_q_SD/compact.$$.src"

  # 1. Append to the archive (>>, never a rewrite).
  _q_cp_emit "$_q_cp_thr" "$_q_cp_s" "$_q_cp_e" > "$_q_cp_t1" || { rm -f "$_q_cp_t1"; _q_die err_compact_write 2 "$_q_cp_dst"; }
  _q_cp_csz=$(wc -c < "$_q_cp_t1" | tr -d ' ')
  if ! cat "$_q_cp_t1" >> "$_q_cp_dst"; then
    rm -f "$_q_cp_t1"
    _q_die err_compact_write 2 "$_q_cp_dst"
  fi

  # 2. Verify: the archive grew by exactly the chunk, and its last bytes
  # equal a fresh derivation from the source (not the chunk file).
  _q_cp_after=$(wc -c < "$_q_cp_dst" | tr -d ' ')
  _q_cp_ok=0
  if [ "$_q_cp_after" -eq $((_q_cp_before + _q_cp_csz)) ] \
    && _q_cp_emit "$_q_cp_thr" "$_q_cp_s" "$_q_cp_e" > "$_q_cp_t2" \
    && tail -c "$_q_cp_csz" "$_q_cp_dst" | cmp -s - "$_q_cp_t2"; then
    _q_cp_ok=1
  fi
  rm -f "$_q_cp_t1" "$_q_cp_t2"
  [ "$_q_cp_ok" -eq 1 ] || _q_die err_compact_verify 2 "$_q_cp_dstname"

  # 3. Only now cut the entries out of the source: copy (keeps mode), edit
  # the copy, check its size, then an atomic mv.
  if cp -p "$_q_cp_thr" "$_q_cp_t3" \
    && { head -n "$(( _q_cp_s - 1 ))" "$_q_cp_thr"; tail -n +"$(( _q_cp_e + 1 ))" "$_q_cp_thr"; } > "$_q_cp_t3" \
    && [ "$(wc -c < "$_q_cp_t3" | tr -d ' ')" -eq $(( $(wc -c < "$_q_cp_thr" | tr -d ' ') - _q_cp_bytes )) ] \
    && mv "$_q_cp_t3" "$_q_cp_thr"; then
    :
  else
    rm -f "$_q_cp_t3"
    _q_die err_compact_source 2 "$_q_cp_srcname"
  fi
}

_q_compact_session() {
  # The last-session file: blocks are "## " sections, appended at the bottom
  # (doctor D3/D5 treat the LAST "## " heading as the newest block), so the
  # FIRST ones are the oldest. Keeps the newest $1 blocks; the rest move,
  # verbatim and in order, to the session archive next to the threads
  # archive. Silent when there is nothing to move. $2: 1 = apply.
  _q_cs_f=$(_q_session_file "$_q_v")
  [ -f "$_q_cs_f" ] || return 0
  _q_cs_tab=$(printf '\t')
  _q_cs_res=$(awk -v keep="$1" -v tab="$_q_cs_tab" '/^## /{n++; h[n]=NR} END{if(n>keep) print h[1] tab ((keep==0) ? NR : h[n-keep+1]-1) tab n-keep tab n}' "$_q_cs_f")
  [ -n "$_q_cs_res" ] || return 0
  _q_cs_s=$(printf '%s\n' "$_q_cs_res" | awk -F"$_q_cs_tab" '{print $1}')
  _q_cs_e=$(printf '%s\n' "$_q_cs_res" | awk -F"$_q_cs_tab" '{print $2}')
  _q_cs_mv=$(printf '%s\n' "$_q_cs_res" | awk -F"$_q_cs_tab" '{print $3}')
  _q_cs_tot=$(printf '%s\n' "$_q_cs_res" | awk -F"$_q_cs_tab" '{print $4}')
  _q_cs_bytes=$(tail -n +"$_q_cs_s" "$_q_cs_f" | head -n "$(( _q_cs_e - _q_cs_s + 1 ))" | wc -c | tr -d ' ')
  _q_cp_srcname=${_q_cs_f#"$_q_v"/}
  _q_cs_dst="$(dirname "$(_q_archive_path "$_q_v")")/$(_q_msg session_archive_file)"
  _q_cs_fmt=$(_q_msg compact_session_preview)
  # shellcheck disable=SC2059
  printf "$_q_cs_fmt\n" "$_q_cs_mv" "$_q_cs_tot" "$_q_cs_bytes" "$1" "$_q_cp_srcname" "${_q_cs_dst#"$_q_v"/}"
  if [ "$2" -eq 0 ]; then
    _q_msg compact_dry_run_note
    return 0
  fi
  _q_cp_move "$_q_cs_f" "$_q_cs_s" "$_q_cs_e" "$_q_cs_bytes" "$_q_cs_dst"
  _q_cs_fmt=$(_q_msg compact_session_done)
  # shellcheck disable=SC2059
  printf "$_q_cs_fmt\n" "$_q_cs_mv" "$_q_cs_bytes" "$_q_cp_srcname" "${_q_cs_dst#"$_q_v"/}"
}

_q_cmd_compact() {
  # quipu compact [--keep N] [--apply]
  #
  # Move the OLD entries of the "Closed threads" section of Threads.md into
  # the archive file (the same one `quipu archive` uses), losslessly. This
  # is the ONE place Quipu edits a file the user wrote, so it is fenced:
  # it runs only when typed (no hook, no timer), it is a dry run unless
  # --apply is given, and --apply is a strict sequence -- append to the
  # archive FIRST, verify the appended bytes against the source byte for
  # byte, and only then cut the entries out of the source (temp file + mv).
  # Any failed step before the cut leaves the source untouched.
  #
  # What moves: the "Closed threads" heading must sit inside the
  # <!-- knotlog:threads:start/end --> block. Its section ends at the next
  # heading of the same or a shallower level, the pin block, or the end
  # marker. Inside it an ENTRY is a list item at column 0 ("- " or "* ")
  # or a deeper heading, plus everything up to the next entry (blank lines
  # and indented lines belong to the entry above). Entries are assumed to
  # be appended, so the FIRST ones are the oldest; the last N (--keep,
  # default 20) stay. The last-session file is handled first, see
  # _q_compact_session. The Active section, the skeleton, the markers, the
  # pin block and all free text outside the section are never moved.
  _q_cp_keep=20
  _q_cp_kg=
  _q_cp_apply=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply) _q_cp_apply=1; shift ;;
      --keep)
        [ "$#" -ge 2 ] || _q_die err_missing_arg 2
        _q_cp_keep=$2
        case "$_q_cp_keep" in
          ''|*[!0-9]*) _q_die err_compact_keep 2 "$_q_cp_keep" ;;
        esac
        _q_cp_kg=$_q_cp_keep
        shift 2
        ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_compact_extra_arg 2 "$1" ;;
    esac
  done

  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault

  # The last-session file first (its own default keep is 5, --keep overrides
  # both targets); silent when it has nothing to move.
  _q_compact_session "${_q_cp_kg:-5}" "$_q_cp_apply"

  _q_cp_thr=$(_q_threads_path "$_q_v")
  if [ ! -f "$_q_cp_thr" ]; then
    _q_die err_archive_no_threads 1 "$_q_cp_thr"
  fi
  _q_cp_srcname=${_q_cp_thr#"$_q_v"/}

  # Both languages' spelling of the closed heading are accepted, like the
  # file-name resolvers do (a vault whose language changed keeps working).
  _q_cp_cl='|'
  for _q_cp_c in $(_q_langs); do
    _q_cp_cl="$_q_cp_cl$(_q_i18n_key "$_q_HOME/i18n/$_q_cp_c.txt" threads_head_closed)|"
  done

  _q_cp_res=$(awk -v keep="$_q_cp_keep" -v cl="$_q_cp_cl" '
    function trim(s) {
      while (substr(s, 1, 1) == " " || substr(s, 1, 1) == tab) s = substr(s, 2)
      while (substr(s, length(s), 1) == " " || substr(s, length(s), 1) == tab) s = substr(s, 1, length(s) - 1)
      return s
    }
    BEGIN { cr = sprintf("%c", 13); tab = sprintf("%c", 9) }
    {
      l = $0
      if (substr(l, length(l), 1) == cr) l = substr(l, 1, length(l) - 1)
      if ((index(l, "<!-- knotlog:threads:start -->") == 1 || index(l, "<!-- quipu:threads:start -->") == 1) && !endseen) { started = 1; inblock = 1; next }
      if ((index(l, "<!-- knotlog:threads:end -->") == 1 || index(l, "<!-- quipu:threads:end -->") == 1) && inblock) { inblock = 0; endseen = 1; insec = 0; next }
      if (!inblock) next
      h = 0
      while (substr(l, h + 1, 1) == "#") h++
      if (h > 0 && substr(l, h + 1, 1) != " ") h = 0
      if (!found && h > 0) {
        t = trim(substr(l, h + 1))
        if (index(cl, "|" t "|")) { found = 1; clvl = h; insec = 1; next }
      }
      if (!insec) next
      if ((index(l, "<!-- knotlog:pin:start -->") == 1 || index(l, "<!-- quipu:pin:start -->") == 1)) { insec = 0; next }
      if (h > 0 && h <= clvl) { insec = 0; next }
      if (h > clvl || substr(l, 1, 2) == "- " || substr(l, 1, 2) == "* ") { ne++; es[ne] = NR }
      if (ne > 0) last = NR
    }
    END {
      if (!started || !endseen) { print "NOBLOCK"; exit }
      if (!found) { print "NOSECTION"; exit }
      if (ne <= keep) { print "NOTHING" tab ne; exit }
      mv = ne - keep
      en = (mv == ne) ? last : es[mv + 1] - 1
      print "OK" tab es[1] tab en tab mv tab ne
    }
  ' "$_q_cp_thr")

  _q_cp_tab=$(printf '\t')
  _q_cp_status=$(printf '%s\n' "$_q_cp_res" | awk -F"$_q_cp_tab" 'NR==1{print $1}')
  case "$_q_cp_status" in
    NOBLOCK) _q_die err_compact_no_block 1 "$_q_cp_srcname" ;;
    NOSECTION) _q_die err_compact_no_closed 1 "$_q_cp_srcname" ;;
    NOTHING)
      _q_cp_n=$(printf '%s\n' "$_q_cp_res" | awk -F"$_q_cp_tab" 'NR==1{print $2}')
      _q_cp_fmt=$(_q_msg compact_nothing)
      # shellcheck disable=SC2059
      printf "$_q_cp_fmt\n" "$_q_cp_n" "$_q_cp_keep"
      return 0
      ;;
    OK) : ;;
    *) _q_die err_compact_no_closed 1 "$_q_cp_srcname" ;;
  esac

  _q_cp_s=$(printf '%s\n' "$_q_cp_res" | awk -F"$_q_cp_tab" 'NR==1{print $2}')
  _q_cp_e=$(printf '%s\n' "$_q_cp_res" | awk -F"$_q_cp_tab" 'NR==1{print $3}')
  _q_cp_mv=$(printf '%s\n' "$_q_cp_res" | awk -F"$_q_cp_tab" 'NR==1{print $4}')
  _q_cp_tot=$(printf '%s\n' "$_q_cp_res" | awk -F"$_q_cp_tab" 'NR==1{print $5}')
  _q_cp_bytes=$(tail -n +"$_q_cp_s" "$_q_cp_thr" | head -n "$(( _q_cp_e - _q_cp_s + 1 ))" | wc -c | tr -d ' ')

  _q_cp_dst=$(_q_archive_path "$_q_v")
  _q_cp_dstname=${_q_cp_dst#"$_q_v"/}

  _q_cp_fmt=$(_q_msg compact_preview)
  # shellcheck disable=SC2059
  printf "$_q_cp_fmt\n" "$_q_cp_mv" "$_q_cp_tot" "$_q_cp_bytes" "$_q_cp_keep" "$_q_cp_srcname" "$_q_cp_dstname"

  if [ "$_q_cp_apply" -eq 0 ]; then
    _q_msg compact_dry_run_note
    return 0
  fi

  _q_cp_move "$_q_cp_thr" "$_q_cp_s" "$_q_cp_e" "$_q_cp_bytes" "$_q_cp_dst"

  _q_cp_fmt=$(_q_msg compact_done)
  # shellcheck disable=SC2059
  printf "$_q_cp_fmt\n" "$_q_cp_mv" "$_q_cp_bytes" "$_q_cp_srcname" "$_q_cp_dstname"
}

_q_cmd_tone() {
  # quipu tone [--list | <slug>] -- show/set the active tone preset.
  #
  # No args: print WHICH tone is active and WHY -- preset slug, or
  # companion.md's own Tone section, or neither. "Why is it talking like
  # this" needs an answer, same rationale as doc_tone_invalid existing at
  # all (silent fallback is this project's most expensive failure class).
  #
  # --list: print all nine shipped presets (name + description, in the
  # vault's language) and mark the active one, if a preset is active.
  #
  # <slug>: write tone=<slug> to .quipu/config. NEVER touches companion.md
  # -- same "quipu never rewrites these files" boundary every other
  # config-only setting keeps (lang=, fold=, ctx_max=, purpose=).
  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  _q_tn_slugs='varsayilan profesyonel dostane icten siradisi etkili sivridilli ogretici kaomoji'

  case "$#" in
    0)
      _q_tone_resolve "$_q_v"
      case "$_q_tres_source" in
        preset)
          _q_tn_name=$(_q_msg "tone_name_$_q_tres_slug")
          # shellcheck disable=SC2059
          printf "$(_q_msg tone_current_preset)\n" "$_q_tn_name" "$_q_tres_slug"
          ;;
        companion)
          # tone= may be EMPTY (never set) or NON-EMPTY-but-invalid (a slug
          # that names no shipped preset for this vault's language) --
          # _q_tone_resolve only ever counts the latter as a fallback to
          # companion, never confuses the two, but this command must say
          # so out loud: "no preset set" is a lie when the user (or a typo)
          # actually wrote a tone= line that just doesn't resolve.
          if [ -n "$_q_tres_slug" ]; then
            # shellcheck disable=SC2059
            printf "$(_q_msg tone_current_invalid_companion)\n" "$_q_tres_slug"
          else
            _q_msg tone_current_companion
          fi
          ;;
        none)
          if [ -n "$_q_tres_slug" ]; then
            # shellcheck disable=SC2059
            printf "$(_q_msg tone_current_invalid_none)\n" "$_q_tres_slug"
          else
            _q_msg tone_current_none
          fi
          ;;
      esac
      ;;
    1)
      case "$1" in
        --list)
          _q_tone_resolve "$_q_v"
          _q_msg tone_list_header
          for _q_tn_s in $_q_tn_slugs; do
            _q_tn_mark=
            if [ "$_q_tres_source" = preset ] && [ "$_q_tn_s" = "$_q_tres_slug" ]; then
              _q_tn_mark=$(_q_msg tone_list_marker)
            fi
            _q_tn_name=$(_q_msg "tone_name_$_q_tn_s")
            _q_tn_desc=$(_q_msg "tone_desc_$_q_tn_s")
            # shellcheck disable=SC2059
            printf "$(_q_msg tone_list_row)\n" "$_q_tn_mark" "$_q_tn_s" "$_q_tn_name" "$_q_tn_desc"
          done
          # Same invalid-vs-unset distinction as the no-args branch above.
          case "$_q_tres_source" in
            companion)
              if [ -n "$_q_tres_slug" ]; then
                # shellcheck disable=SC2059
                printf "$(_q_msg tone_list_footer_invalid_companion)\n" "$_q_tres_slug"
              else
                _q_msg tone_list_footer_companion
              fi
              ;;
            none)
              if [ -n "$_q_tres_slug" ]; then
                # shellcheck disable=SC2059
                printf "$(_q_msg tone_list_footer_invalid_none)\n" "$_q_tres_slug"
              else
                _q_msg tone_list_footer_none
              fi
              ;;
          esac
          ;;
        -*) _q_die err_unknown_flag 2 "$1" ;;
        *)
          _q_tn_ok=0
          for _q_tn_s in $_q_tn_slugs; do
            [ "$_q_tn_s" = "$1" ] && _q_tn_ok=1
          done
          [ "$_q_tn_ok" -eq 1 ] || _q_die err_tone_unknown 2 "$1"
          mkdir -p "$_q_v/$_q_SD"
          [ -f "$_q_v/$_q_SD/config" ] || : > "$_q_v/$_q_SD/config"
          if grep -q '^tone=' "$_q_v/$_q_SD/config"; then
            sed "s/^tone=.*/tone=$1/" "$_q_v/$_q_SD/config" > "$_q_v/$_q_SD/config.tmp" && mv "$_q_v/$_q_SD/config.tmp" "$_q_v/$_q_SD/config"
          else
            printf 'tone=%s\n' "$1" >> "$_q_v/$_q_SD/config"
          fi
          _q_bridge_refresh "$_q_v"
          # shellcheck disable=SC2059
          printf "$(_q_msg tone_set)\n" "$1"
          ;;
      esac
      ;;
    *) _q_die err_tone_extra_arg 2 "$2" ;;
  esac
}

_q_cmd_flair() {
  # knotlog flair [--list | none|kaomoji|emoji] -- show/set the reply flair
  # (flair= in config). Mirrors `knotlog tone`; never touches companion.md.
  _q_v=$(_q_vault)
  [ -n "$_q_v" ] || _q_die err_no_vault
  _q_flair_resolve "$_q_v"
  case "$#" in
    0)
      if [ -n "$_q_fl_raw" ] && [ "$_q_fl_val" = none ] && [ "$_q_fl_raw" != none ]; then
        # shellcheck disable=SC2059
        printf "$(_q_msg flair_current_invalid)\n" "$_q_fl_raw"
      else
        # shellcheck disable=SC2059
        printf "$(_q_msg flair_current)\n" "$_q_fl_val"
      fi
      ;;
    1)
      case "$1" in
        --list)
          _q_msg flair_list_header
          for _q_fl_s in none kaomoji emoji; do
            _q_fl_mark=
            [ "$_q_fl_s" != "$_q_fl_val" ] || _q_fl_mark=$(_q_msg flair_list_marker)
            # shellcheck disable=SC2059
            printf "$(_q_msg flair_list_row)\n" "$_q_fl_mark" "$_q_fl_s" "$(_q_msg "flair_desc_$_q_fl_s")"
          done
          ;;
        -*) _q_die err_unknown_flag 2 "$1" ;;
        none|kaomoji|emoji)
          mkdir -p "$_q_v/$_q_SD"
          [ -f "$_q_v/$_q_SD/config" ] || : > "$_q_v/$_q_SD/config"
          if grep -q '^flair=' "$_q_v/$_q_SD/config"; then
            sed "s/^flair=.*/flair=$1/" "$_q_v/$_q_SD/config" > "$_q_v/$_q_SD/config.tmp" && mv "$_q_v/$_q_SD/config.tmp" "$_q_v/$_q_SD/config"
          else
            printf 'flair=%s\n' "$1" >> "$_q_v/$_q_SD/config"
          fi
          _q_bridge_refresh "$_q_v"
          # shellcheck disable=SC2059
          printf "$(_q_msg flair_set)\n" "$1"
          ;;
        *) _q_die err_flair_unknown 2 "$1" ;;
      esac
      ;;
    *) _q_die err_flair_extra_arg 2 "$2" ;;
  esac
}

# ---- setup: one agent's hook file into the vault ---------------------------
# knotlog setup <claude|codex|omp|gemini|cursor|antigravity|windsurf|opencode> [--dry-run]. Writes the shipped adapter
# only where the target is absent. An identical file is left alone; a
# differing one is never overwritten (the user merges it by hand). The
# decision lives in _q_setup_place, shared by the write and --dry-run paths.

_q_setup_place() {
  # _q_setup_place <source> <dest> <dry-run 0|1> <agent>
  _q_sp_src=$1
  _q_sp_dest=$2
  _q_sp_dry=$3
  _q_sp_agent=$4
  if [ -e "$_q_sp_dest" ] || [ -L "$_q_sp_dest" ]; then
    if cmp -s "$_q_sp_src" "$_q_sp_dest"; then
      # shellcheck disable=SC2059
      printf "$(_q_msg setup_line_uptodate)\n" "$_q_sp_agent" "$_q_sp_dest"
    else
      # shellcheck disable=SC2059
      printf "$(_q_msg setup_line_preserved)\n" "$_q_sp_agent" "$_q_sp_dest" "$_q_sp_src"
    fi
    return 0
  fi
  _q_sp_parent=${_q_sp_dest%/*}
  if [ -e "$_q_sp_parent" ] && [ ! -d "$_q_sp_parent" ]; then
    _q_die err_setup_parent 2 "$_q_sp_parent"
  fi
  if [ "$_q_sp_dry" -eq 0 ]; then
    mkdir -p "$_q_sp_parent"
    cp -- "$_q_sp_src" "$_q_sp_dest"
  fi
  # shellcheck disable=SC2059
  printf "$(_q_msg setup_line_written)\n" "$_q_sp_agent" "$_q_sp_dest"
}

_q_cmd_setup() {
  _q_st_agent=
  _q_st_dry=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) _q_st_dry=1 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *)
        [ -z "$_q_st_agent" ] || _q_die err_setup_usage 2
        _q_st_agent=$1
        ;;
    esac
    shift
  done
  case "$_q_st_agent" in
    claude) _q_st_source="$_q_HOME/adapters/claude-code.json"; _q_st_rel=.claude/settings.json ;;
    codex) _q_st_source="$_q_HOME/adapters/codex/hooks.json"; _q_st_rel=.codex/hooks.json ;;
    omp) _q_st_source="$_q_HOME/adapters/omp/hooks/pre/knotlog.ts"; _q_st_rel=.omp/hooks/pre/knotlog.ts ;;
    gemini) _q_st_source="$_q_HOME/adapters/gemini/settings.json"; _q_st_rel=.gemini/settings.json ;;
    cursor) _q_st_source="$_q_HOME/adapters/cursor/hooks.json"; _q_st_rel=.cursor/hooks.json ;;
    antigravity) _q_st_source="$_q_HOME/adapters/antigravity/hooks.json"; _q_st_rel=.agents/hooks.json ;;
    windsurf|devin) _q_st_agent=windsurf; _q_st_source="$_q_HOME/adapters/windsurf/hooks.json"; _q_st_rel=.devin/hooks.json ;;
    opencode) _q_st_source="$_q_HOME/adapters/opencode/knotlog.js"; _q_st_rel=.opencode/plugins/knotlog.js ;;
    '') _q_die err_setup_usage 2 ;;
    *) _q_die err_setup_agent 2 "$_q_st_agent" ;;
  esac
  _q_st_vault=$(_q_vault)
  if [ -z "$_q_st_vault" ]; then
    _q_die err_no_vault
  fi
  if [ ! -f "$_q_st_source" ] || [ ! -r "$_q_st_source" ]; then
    _q_die err_install_asset_source 2 "$_q_st_source"
  fi
  if [ "$_q_st_dry" -eq 1 ]; then
    _q_msg setup_dry_run
  fi
  _q_setup_place "$_q_st_source" "$_q_st_vault/$_q_st_rel" "$_q_st_dry" "$_q_st_agent"
}

# ---- migrate: bring a pre-rename (Quipu) vault over to Knotlog -------------
# knotlog migrate [--apply]. Dry run by default. Rewrites only what Knotlog
# itself wrote (state folder, QUIPU_* config keys, whole block-marker lines,
# hook commands, the omp hook, the .gitignore seed, the secret-scan hook);
# user text is never touched. Every step is a no-op once done, so a second
# --apply finds nothing. lib/migrate.awk holds the line-level rewrites.

_q_mg_note() {
  # _q_mg_note <message key> <args...>: print one planned/done item, count it.
  _q_mgn_fmt=$(_q_msg "$1")
  shift
  # shellcheck disable=SC2059
  printf "$_q_mgn_fmt\n" "$_q_mg_pfx" "$@"
  _q_mg_n=$((_q_mg_n + 1))
}

_q_mg_rewrite() {
  # _q_mg_rewrite <vault-relative file> <migrate.awk mode> <message key>
  _q_mgr_f="$_q_mg_v/$1"
  [ -f "$_q_mgr_f" ] || return 0
  _q_mgr_out="$_q_mg_tmp/out"
  _q_mgr_dup="$_q_mg_tmp/dup"
  : > "$_q_mgr_dup"
  if [ "$2" = config ]; then
    awk -v mode=config -v dupfile="$_q_mgr_dup" -f "$_q_HOME/lib/migrate.awk" "$_q_mgr_f" "$_q_mgr_f" > "$_q_mgr_out"
  else
    awk -v mode="$2" -v home="$_q_HOME" -f "$_q_HOME/lib/migrate.awk" "$_q_mgr_f" > "$_q_mgr_out"
  fi
  if [ -s "$_q_mgr_dup" ]; then
    while IFS= read -r _q_mgr_k; do
      # shellcheck disable=SC2059
      printf "$(_q_msg migrate_warn_dup)\n" "$_q_mgr_k" "$1" >&2
    done < "$_q_mgr_dup"
  fi
  cmp -s "$_q_mgr_out" "$_q_mgr_f" && return 0
  _q_mg_note "$3" "$1"
  [ "$_q_mg_apply" -eq 0 ] || cat "$_q_mgr_out" > "$_q_mgr_f"
}

_q_mgb_blk() {
  # Text between the first start/end marker pair (either family) of $_q_mgb_f
  # in the scratch directory $1 (cur = original, v = after init).
  awk '/^<!-- (knotlog|quipu):start -->$/ { b = 1; next } /^<!-- (knotlog|quipu):end -->$/ { exit } b' "$_q_mgb_d/$1/$_q_mgb_f"
}

_q_mg_bridge() {
  # Refresh the static bridge block (AGENTS.md, CLAUDE.md) with today's text by
  # running the real init in a scratch copy of just those files and the config:
  # init regenerates the block from its one source and keeps everything outside
  # the markers. The result is compared with the marker-converted original, so
  # a dry run lists the file and --apply copies the scratch result over it.
  # A block with hand-added lines is never rewritten (see the loop below).
  _q_mgb_d="$_q_mg_tmp/bridge"
  rm -rf "$_q_mgb_d"
  mkdir -p "$_q_mgb_d/cur" "$_q_mgb_d/v/.knotlog"
  [ ! -f "$_q_mg_v/$_q_SD/config" ] || cp -- "$_q_mg_v/$_q_SD/config" "$_q_mgb_d/v/.knotlog/config"
  _q_mgb_have=0
  for _q_mgb_f in AGENTS.md CLAUDE.md; do
    [ -f "$_q_mg_v/$_q_mgb_f" ] || continue
    grep -Eq '^<!-- (knotlog|quipu):start -->$' "$_q_mg_v/$_q_mgb_f" || continue
    awk -v mode=marker -f "$_q_HOME/lib/migrate.awk" "$_q_mg_v/$_q_mgb_f" > "$_q_mgb_d/cur/$_q_mgb_f"
    cp -- "$_q_mgb_d/cur/$_q_mgb_f" "$_q_mgb_d/v/$_q_mgb_f"
    _q_mgb_have=1
  done
  [ "$_q_mgb_have" -eq 1 ] || return 0
  (QUIPU_VAULT="$_q_mgb_d/v"; export QUIPU_VAULT; unset QUIPU_HOOK; _q_cmd_init --no-prompt) >/dev/null 2>&1 || return 0
  for _q_mgb_f in AGENTS.md CLAUDE.md; do
    [ -f "$_q_mgb_d/cur/$_q_mgb_f" ] || continue
    cmp -s "$_q_mgb_d/cur/$_q_mgb_f" "$_q_mgb_d/v/$_q_mgb_f" && continue
    # Refresh only a block nobody edited: its text must equal what init writes
    # today with the new names turned back into the old ones. Anything else is
    # the user's text; it stays byte for byte and the user is told.
    _q_mgb_blk 'cur' > "$_q_mgb_d/cur.blk"
    _q_mgb_blk 'v' | sed 's/knotlog/quipu/g; s/Knotlog/Quipu/g; s/KNOTLOG/QUIPU/g' > "$_q_mgb_d/rev.blk"
    if ! cmp -s "$_q_mgb_d/cur.blk" "$_q_mgb_d/rev.blk"; then
      # shellcheck disable=SC2059
      printf "$(_q_msg migrate_warn_bridge_edited)\n" "$_q_mgb_f" >&2
      continue
    fi
    _q_mg_note migrate_item_bridge "$_q_mgb_f"
    [ "$_q_mg_apply" -eq 0 ] || cat "$_q_mgb_d/v/$_q_mgb_f" > "$_q_mg_v/$_q_mgb_f"
  done
}

_q_mg_omp() {
  # The old omp hook is retired only when it is a file Knotlog shipped: one of
  # the checksums below (every quipu.ts any release carried) or the current
  # knotlog.ts. A hand-edited copy is reported and left alone.
  _q_mgo_old="$_q_mg_v/.omp/hooks/pre/quipu.ts"
  _q_mgo_new="$_q_mg_v/.omp/hooks/pre/knotlog.ts"
  _q_mgo_src="$_q_HOME/adapters/omp/hooks/pre/knotlog.ts"
  [ -f "$_q_mgo_old" ] || return 0
  _q_mgo_sum=$(cksum < "$_q_mgo_old")
  _q_mgo_ours=0
  case "$_q_mgo_sum" in
    "149950043 1419"|"1671551382 1425"|"2098885252 774"|"4105486858 735"|"991779239 1356") _q_mgo_ours=1 ;;
  esac
  [ ! -f "$_q_mgo_src" ] || ! cmp -s "$_q_mgo_old" "$_q_mgo_src" || _q_mgo_ours=1
  if [ "$_q_mgo_ours" -eq 0 ]; then
    # shellcheck disable=SC2059
    printf "$(_q_msg migrate_warn_omp_modified)\n" ".omp/hooks/pre/quipu.ts" >&2
    return 0
  fi
  [ -f "$_q_mgo_new" ] || [ -f "$_q_mgo_src" ] || return 0
  _q_mg_note migrate_item_omp ".omp/hooks/pre/quipu.ts"
  [ "$_q_mg_apply" -eq 1 ] || return 0
  [ -f "$_q_mgo_new" ] || cp -- "$_q_mgo_src" "$_q_mgo_new"
  rm -f -- "$_q_mgo_old"
}

_q_mg_secret() {
  # A pre-commit hook carrying the old signature is Knotlog's own file; init
  # refreshes it the same way. A hand-written one has no signature: untouched.
  _q_mgs_f="$_q_mg_v/.githooks/pre-commit"
  _q_mgs_src="$_q_HOME/hooks/pre-commit"
  [ -f "$_q_mgs_f" ] && [ -f "$_q_mgs_src" ] || return 0
  grep -q 'quipu:secret-scan' "$_q_mgs_f" || return 0
  _q_mg_note migrate_item_secret ".githooks/pre-commit"
  [ "$_q_mg_apply" -eq 0 ] || { cp -- "$_q_mgs_src" "$_q_mgs_f" && chmod +x "$_q_mgs_f"; }
}

_q_cmd_migrate() {
  _q_mg_apply=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --apply) _q_mg_apply=1 ;;
      -*) _q_die err_unknown_flag 2 "$1" ;;
      *) _q_die err_migrate_usage 2 ;;
    esac
    shift
  done
  _q_mg_v=$(_q_vault)
  [ -n "$_q_mg_v" ] || _q_die err_no_vault
  if [ -d "$_q_mg_v/.quipu" ] && [ -d "$_q_mg_v/.knotlog" ]; then
    _q_die err_migrate_both 1 "$_q_mg_v/.quipu" "$_q_mg_v/.knotlog"
  fi
  _q_mg_tmp=$(mktemp -d "${TMPDIR:-/tmp}/knotlog-migrate-XXXXXX") || exit 1
  trap 'rm -rf "$_q_mg_tmp"' EXIT HUP INT TERM
  _q_mg_n=0
  if [ "$_q_mg_apply" -eq 1 ]; then
    _q_mg_pfx=$(_q_msg migrate_pfx_done)
  else
    _q_mg_pfx=$(_q_msg migrate_pfx_dry)
  fi

  # Files are rewritten before the state folder moves, so they sit at the old
  # path in the dry run and the real one alike.
  _q_mg_rewrite "$_q_SD/config" config migrate_item_config
  (cd "$_q_mg_v" && find . -name .git -prune -o -type f -name '*.md' -exec grep -l '^<!-- quipu:' {} + 2>/dev/null) > "$_q_mg_tmp/mdlist" || true
  while IFS= read -r _q_mg_f; do
    _q_mg_rewrite "${_q_mg_f#./}" marker migrate_item_markers
  done < "$_q_mg_tmp/mdlist"
  _q_mg_bridge
  for _q_mg_f in .claude/settings.json .codex/hooks.json .gemini/settings.json .cursor/hooks.json .agents/hooks.json; do
    _q_mg_rewrite "$_q_mg_f" hook migrate_item_hooks
  done
  _q_mg_omp
  _q_mg_rewrite .gitignore ignore migrate_item_ignore
  if [ -n "$(_q_union_missing "$_q_mg_v")" ]; then
    _q_mg_note migrate_item_union ".gitattributes"
    [ "$_q_mg_apply" -eq 0 ] || _q_union_ensure "$_q_mg_v"
  fi
  _q_mg_secret
  if [ -d "$_q_mg_v/.quipu" ]; then
    _q_mg_note migrate_item_dir ".quipu" ".knotlog"
    [ "$_q_mg_apply" -eq 0 ] || mv -- "$_q_mg_v/.quipu" "$_q_mg_v/.knotlog"
  fi

  if [ "$_q_mg_n" -eq 0 ]; then
    _q_msg migrate_nothing
  elif [ "$_q_mg_apply" -eq 1 ]; then
    # shellcheck disable=SC2059
    printf "$(_q_msg migrate_summary_done)\n" "$_q_mg_n"
  else
    # shellcheck disable=SC2059
    printf "$(_q_msg migrate_summary_dry)\n" "$_q_mg_n"
  fi
}

# ---- mcp --------------------------------------------------------------------

_q_cmd_mcp() {
  # stdio MCP server: the whole loop is lib/mcp.awk. stdout carries MCP
  # messages only; anything else this process says goes to stderr. Tool calls
  # re-run this script (search, context); their stderr lands in a scratch file
  # that is returned as the tool error text, never on stdout.
  [ "$#" -eq 0 ] || _q_die err_mcp_usage 2
  _q_mcp_err=$(mktemp "${TMPDIR:-/tmp}/knotlog-mcp-XXXXXX") || exit 1
  _q_mcp_pid=
  # awk runs in the background and sh waits: a trap only fires while sh is in
  # `wait` (a foreground child that blocks on stdin would hold it back), so the
  # client's SIGINT/SIGTERM/SIGHUP stops awk at once instead of escalating to KILL.
  # shellcheck disable=SC2317,SC2329 # called only through the trap strings below
  _q_mcp_stop() { # exit-status
    [ -z "$_q_mcp_pid" ] || kill "$_q_mcp_pid" 2>/dev/null
    rm -f "$_q_mcp_err"
    exit "$1"
  }
  trap 'rm -f "$_q_mcp_err"' EXIT
  trap '_q_mcp_stop 129' HUP
  trap '_q_mcp_stop 130' INT
  trap '_q_mcp_stop 143' TERM
  # A background command of a non-interactive sh gets /dev/null as stdin, and dash
  # applies that before explicit redirections (so `<&0` would copy /dev/null). Keep the
  # real stdin on fd 3 and hand it to awk from there; awk and the parent do not keep fd 3.
  exec 3<&0
  KNOTLOG_MCP_SELF="$_q_HOME/knotlog" KNOTLOG_MCP_ERR="$_q_mcp_err" \
    awk -v ver="$_q_version" -v maxline="${QUIPU_MAX_STDIN:-65536}" \
    -f "$_q_HOME/lib/jsonfield.awk" -f "$_q_HOME/lib/jsonemit.awk" -f "$_q_HOME/lib/mcp.awk" <&3 3<&- &
  _q_mcp_pid=$!
  exec 3<&-
  wait "$_q_mcp_pid"
  _q_mcp_rc=$?
  _q_mcp_pid=
  exit "$_q_mcp_rc"
}

# ---- dispatch ---------------------------------------------------------------

# Resolve the state directory once for the vault this run works on.
_q_sd_v=$(_q_vault)
[ -z "$_q_sd_v" ] || _q_SD=$(_q_sd_of "$_q_sd_v")

_q_cmd=${1:-}
case "$_q_cmd" in
  --version) printf 'knotlog %s\n' "$_q_version"; exit 0 ;;
  doctor) _q_doctor ;;
  compile) shift; _q_cmd_compile "$@" ;;
  index) shift; _q_cmd_index "$@" ;;
  capture) shift; _q_cmd_capture "$@" ;;
  init) shift; _q_cmd_init "$@" ;;
  install) shift; _q_cmd_install "$@" ;;
  setup) shift; _q_cmd_setup "$@" ;;
  migrate) shift; _q_cmd_migrate "$@" ;;
  uninstall) shift; _q_cmd_uninstall "$@" ;;
  update) shift; _q_cmd_update "$@" ;;
  rollback) shift; _q_cmd_rollback "$@" ;;
  context) shift; _q_cmd_context "$@" ;;
  remember) shift; _q_cmd_remember "$@" ;;
  mcp) shift; _q_cmd_mcp "$@" ;;
  note) shift; _q_cmd_note "$@" ;;
  digest) shift; _q_cmd_digest "$@" ;;
  import) shift; _q_cmd_import "$@" ;;
  search) shift; _q_cmd_search "$@" ;;
  links) shift; _q_cmd_links "$@" ;;
  plan) shift; _q_cmd_plan "$@" ;;
  tone) shift; _q_cmd_tone "$@" ;;
  flair) shift; _q_cmd_flair "$@" ;;
  archive) shift; _q_cmd_archive "$@" ;;
  compact) shift; _q_cmd_compact "$@" ;;
  tui) shift; _q_cmd_tui "$@" ;;
  help) shift; _q_cmd_help "$@" ;;
  *) usage; exit 2 ;;
esac
