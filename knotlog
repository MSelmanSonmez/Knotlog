mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

_q_nul_list() {
  # FAZ 11 F-5: stdin (one vault-relative path per line) -> stdout, the SAME
  # paths NUL-separated for `xargs -0`. A path may contain a space (the
  # emoji-folder fixture does: "notlar/d.md" under an emoji dir with a
  # space) — NUL is the only delimiter xargs never mistakes for a token
  # boundary. The NUL byte is produced from its code point with awk's
  # printf/%c, the same way lib/index.awk builds TAB/CR, rather than relying
  # on `tr`'s NUL handling (inconsistent across GNU/BSD).
  awk 'BEGIN { ORS = "" } { printf "%s%c", $0, 0 }'
}

_q_stat_batch() {
  # FAZ 11 F-5: batch mtime lookup. $1: file of NUL-separated vault-relative
  # paths (see _q_nul_list; may be empty). $2: scratch file for the raw
  # `stat` output. Replaces the old per-changed-file subshell + `stat`
  # (quipu:1219 pre-FAZ11, one fork + one process EACH line) with `xargs`
  # handing up to 200 paths to a SINGLE `stat` call — total process count
  # drops to roughly (changed-file-count / 200), not one per file. GNU
  # `stat -c '%Y %n'` is tried first; a nonzero exit (BSD/macOS `stat` does
  # not understand -c) falls back to `stat -f '%m %N'`, same two-tier
  # fallback as mtime() above. Both formats share one shape ("<mtime> <path>",
  # exactly one separating space since mtime is a plain decimal), so ONE awk
  # pass normalizes either into `path TAB mtime` rows on stdout — using
  # index()/substr() on the FIRST space only, so a path containing spaces of
  # its own still comes out whole.
  #
  # QUIPU_STAT_CHUNK (default 200): chunk size passed to `xargs -n`. Exists
  # so T-162 can force a small vault (a handful of files, not 200+) across
  # more than one chunk boundary without paying msys fork costs on a
  # 200+-file vault — the default stays 200 for real use.
  [ -s "$1" ] || return 0
  _q_sb_n=${QUIPU_STAT_CHUNK:-200}
  if xargs -0 -n "$_q_sb_n" stat -c '%Y %n' < "$1" > "$2" 2>/dev/null; then
    :
  else
    xargs -0 -n "$_q_sb_n" stat -f '%m %N' < "$1" > "$2"
  fi
  awk '{ p = index($0, " "); if (p > 0) print substr($0, p + 1) "\t" substr($0, 1, p - 1) }' "$2"
}

_q_md_filter() {
  # stdin -> stdout: keep only .md vault-relative paths, dropping the agent
  # bridge files and the pruned prefixes. Single source for _q_mdlist and
  # `capture --git` (DZ-3): substr/index only, no regex (PLAN 4.8/4.17).
  awk '
    length($0) < 3 { next }
    substr($0, length($0) - 2) != ".md" { next }
    $0 == "AGENTS.md" { next }
    $0 == "CLAUDE.md" { next }
    index($0, ".knotlog/") == 1 { next }
    index($0, ".quipu/") == 1 { next }
    index($0, ".git/") == 1 { next }
    index($0, "node_modules/") == 1 { next }
    { print }
  '
}

_q_mdlist() {
  # Vault-relative .md paths, excluding agent-bridge files and the localized
  # Templates folder. Caller must cd to the vault first. $1 (optional): only
  # files newer than this path.
  #
  # Templates are boilerplate skeletons meant to be copied elsewhere, not
  # searchable content -- same rationale as _q_md_filter's AGENTS.md/
  # CLAUDE.md exclusion. Excluding them here (not in _q_md_filter, which
  # `capture --git` also uses for unrelated bookkeeping) also sidesteps a
  # real fold-column artifact: a skeleton's decorative content (e.g. the
  # status-mark legend) can carry raw emoji, and emoji bytes are DATA that
  # the fold profile correctly leaves untouched -- they were never meant to
  # be searched in the first place, so keep them out of the index entirely.
  _q_ml_layout=$(awk -F= '$1=="layout"{print $2;exit}' "$_q_SD/config" 2>/dev/null || true)
  _q_layout_ok "$_q_ml_layout" || _q_ml_layout=emoji
  _q_ml_tab=$(printf '\t')
  _q_ml_tpl=$(awk -F"$_q_ml_tab" -v k=templates '$1==k{print $2;exit}' "$_q_HOME/layout/$_q_ml_layout.txt" 2>/dev/null || true)
  _q_ml_know=$(awk -F"$_q_ml_tab" '$1=="knowledge"{print $2;exit}' "$_q_HOME/layout/$_q_ml_layout.txt" 2>/dev/null || true)
  _q_ml_comp=$(_q_msg compiled_dir)
  _q_ml_derived=
  if [ -n "$_q_ml_know" ] && [ -n "$_q_ml_comp" ]; then
    _q_ml_derived="$_q_ml_know/$_q_ml_comp/"
  fi
  # index_exclude= (2026-10-16): extra folder names, whitespace-separated, from
  # .knotlog/config. A path with a component equal to one of them is dropped
  # like the fixed prunes above (which stay). Tokens with glob characters or a
  # slash are not single folder names and are ignored.
  _q_ml_ex=
  if [ -f "$_q_SD/config" ]; then
    _q_ml_ex=$(awk -F= -v k=index_exclude '$1==k{sub(/^[^=]*=/,"");print;exit}' "$_q_SD/config" 2>/dev/null || true)
  fi
  if [ -n "${1:-}" ]; then
    find . \( -name .git -o -name .knotlog -o -name .quipu -o -name node_modules \) -prune -o \
      -type f -name '*.md' -newer "$1" -print
  else
    find . \( -name .git -o -name .knotlog -o -name .quipu -o -name node_modules \) -prune -o \
      -type f -name '*.md' -print
  fi | sed 's|^\./||' | _q_md_filter | if [ -n "$_q_ml_derived" ]; then
    awk -v pre="$_q_ml_derived" 'index($0, pre) != 1'
  else
    cat
  fi | if [ -n "$_q_ml_ex" ]; then
    awk -v ex="$_q_ml_ex" '
      BEGIN {
        bs = sprintf("%c", 92)   # not -v: some awks unescape a lone backslash to ""
        n = split(ex, toks, " ")
        for (i = 1; i <= n; i++) {
          t = toks[i]
          if (index(t, "*") || index(t, "?") || index(t, "[") || index(t, "]") || index(t, "/") || index(t, bs)) continue
          names[t] = 1
        }
      }
      {
        m = split($0, parts, "/")
        for (i = 1; i <= m; i++) if (parts[i] in names) next
        print
      }
    '
  else
    cat
  fi | if [ -n "$_q_ml_tpl" ]; then
    awk -v pre="$_q_ml_tpl/" 'index($0, pre) != 1'
  else
    cat
  fi
}

_q_reflect_filled() {
  # FAZ 8 (Y-2): reflection-block fullness detection. A block between a pair
  # of knotlog:<marker> markers (legacy quipu:<marker> also) is "filled" when it holds at least one line
  # that is not a marker, not a "### " heading, and not blank. No mtime reads
  # (S-5.2); the check is content-based so a same-day edit by the model is
  # seen immediately.
  # $1: path. $2 (optional): marker, e.g. "knotlog:reflect" or "knotlog:core"
  # (either family prefix is accepted; both spellings are matched in the file) --
  # default "knotlog:reflect" so the three existing call sites (context,
  # remember x2) are unchanged. Generalized for FAZ 15 (AE-4) so the
  # companion.md "never forget" block (knotlog:core) can share this same
  # detection algorithm instead of a copied awk block per marker name (the
  # KALEM 1 P-2 lesson: copied logic drifts silently). Sets _q_rf=1 when
  # filled, _q_rf=0 when absent or empty.
  _q_rf=0
  [ -f "$1" ] || return 0
  _q_rfm=${2:-reflect}
  _q_rfm=${_q_rfm#quipu:}
  _q_rfm=${_q_rfm#knotlog:}
  if awk -v mk="$_q_rfm" '
    index($0, "knotlog:" mk ":start") || index($0, "quipu:" mk ":start") { inblk = 1; next }
    index($0, "knotlog:" mk ":end") || index($0, "quipu:" mk ":end")     { inblk = 0; next }
    !inblk { next }
    length($0) == 0 { next }
    substr($0, 1, 4) == "### " { next }
    { found = 1; exit }
    END { exit !found }
  ' "$1"; then
    _q_rf=1
  fi
  return 0
}

_q_threads_filled() {
  # FAZ 16 (AD-3): Threads.md fullness detection. A thin wrapper over
  # _q_reflect_filled's generalized (FAZ 15 AE-4) algorithm with the
  # "knotlog:threads" marker -- not a copied awk block, so the detection rule
  # never drifts from the reflect/core blocks (the KALEM 1 P-2 lesson cited
  # in _q_reflect_filled's own comment above). Same guarantees: no mtime
  # reads, absent file/marker/content all fold to "not filled". $1: path.
  # Sets _q_tf=1 when filled, _q_tf=0 when absent, marker-less, or empty.
  _q_reflect_filled "$1" knotlog:threads
  _q_tf=$_q_rf
}

_q_threads_path() {
  # The threads file's NAME follows the vault's language, exactly like the
  # layout folder names do -- it is data (i18n key `threads_file`), never a
  # hardcoded string and never a config field. A Turkish vault gets
  # `Konular.md`, an English one `Threads.md`.
  #
  # Resolution tolerates the legacy name, because vaults created before this
  # change hold their history in `Threads.md` regardless of language. Picking
  # the localized name blindly would leave that history on disk but invisible:
  # quipu would seed a fresh empty file next to it and every reader would see
  # an empty vault. So an existing file always wins over a new one, and the
  # localized name is only used when neither exists yet. $1: vault root.
  _q_tp_local=$(_q_msg threads_file)
  [ -n "$_q_tp_local" ] || _q_tp_local=Threads.md
  if [ -f "$1/$_q_tp_local" ]; then
    printf '%s\n' "$1/$_q_tp_local"
  elif [ -f "$1/Threads.md" ]; then
    printf '%s\n' "$1/Threads.md"
  else
    printf '%s\n' "$1/$_q_tp_local"
  fi
}

_q_pin_extract() {
  # B-K1: extracts the pin block (<!-- knotlog:pin:start --> .. <!-- knotlog:pin:end -->,
  # marker syntax deliberately identical to knotlog:threads:start/end; the
  # legacy quipu: spelling is read too) from the
  # threads file, INCLUDING both marker lines, into $_q_pin. Only the first
  # pin block is honored; a second one is left as ordinary (croppable)
  # threads content -- multiple pins is not a case this feature promises to
  # solve. $_q_pin is empty when the file has no start marker at all, the
  # same silence every other optional section in this file keeps for an
  # absent feature -- this is what makes a pin-less vault's `quipu context`
  # byte-identical to before this feature existed (a plain `cat` piped
  # through this filter reproduces the file unchanged when no marker
  # matches: see _q_ctx_text). $1: path to the threads file.
  _q_pin=$(awk '
    /<!-- (knotlog|quipu):pin:start -->/ { p = 1 }
    p { print }
    /<!-- (knotlog|quipu):pin:end -->/ { if (p) exit }
  ' "$1")
}

_q_rules_path() {
  # B3: the rules file's NAME follows the vault's language, exactly like the
  # threads file does -- data (i18n key `rules_file`), never a hardcoded
  # string and never a config field. A Turkish vault gets `Kurallar.md`, an
  # English one `Rules.md`.
  #
  # Resolution tolerates the other language's spelling, because hand-written
  # rule files predate this key in BOTH spellings and picking the localized
  # name blindly would seed a fresh empty file next to the existing one.
  # Same contract as _q_threads_path: an existing file always wins over a
  # new one; the localized name is only used when neither exists yet.
  # $1: vault root.
  _q_rp_local=$(_q_msg rules_file)
  [ -n "$_q_rp_local" ] || _q_rp_local=Rules.md
  if [ -f "$1/$_q_rp_local" ]; then
    printf '%s\n' "$1/$_q_rp_local"
  else
    # D1's pri/sec pattern: the fallback spelling is the OTHER language's
    # rules_file value, so a Turkish vault holding Rules.md and an English
    # vault holding Kurallar.md both keep resolving.
    _q_rp_other=$(_q_i18n_key "$_q_HOME/i18n/$(_q_lang_alt).txt" rules_file)
    if [ -n "$_q_rp_other" ] && [ -f "$1/$_q_rp_other" ]; then
      printf '%s\n' "$1/$_q_rp_other"
    else
      printf '%s\n' "$1/$_q_rp_local"
    fi
  fi
}

_q_archive_path() {
  # B-K3: the archive file's DIRECTORY follows the vault's layout (i18n key
  # `archive`, the same layout/*.txt folder-name table every other
  # top-level folder resolves through — see _q_pl_lay/_q_pl_pdir in
  # _q_cmd_plan for the identical lookup shape), and its NAME follows the
  # vault's language (i18n key `threads_archive_file`) — the same two-part
  # contract _q_threads_path/_q_rules_path already keep for the files they
  # resolve. A Turkish vault gets `📦 Arşiv/Konular-Arsivi.md`, an English
  # one `Archive/Threads-Archive.md`.
  #
  # Resolution tolerates the OTHER language's file name for an existing
  # file (same "existing wins, localized name is only for a file that does
  # not exist yet" contract _q_threads_path/_q_rules_path keep) — otherwise
  # a vault whose language changed after its first `quipu archive` call
  # would silently start a second, empty archive file next to the real
  # one. The directory itself is NOT given the same tolerance: layout is a
  # config choice (`.quipu/config` layout=), not a legacy-name problem, and
  # every other command (_q_cmd_plan included) resolves it the same
  # single way. $1: vault root.
  _q_apl_tab=$(printf '\t')
  _q_ap_lay=$(awk -F= '$1=="layout"{print $2;exit}' "$1/$_q_SD/config" 2>/dev/null || true)
  _q_layout_ok "$_q_ap_lay" || _q_ap_lay=emoji
  _q_ap_dir=$(awk -F"$_q_apl_tab" -v k=archive '$1==k{print $2;exit}' "$_q_HOME/layout/$_q_ap_lay.txt" 2>/dev/null || true)
  [ -n "$_q_ap_dir" ] || _q_ap_dir=Archive
  _q_ap_local=$(_q_msg threads_archive_file)
  [ -n "$_q_ap_local" ] || _q_ap_local=Threads-Archive.md
  if [ -f "$1/$_q_ap_dir/$_q_ap_local" ]; then
    printf '%s\n' "$1/$_q_ap_dir/$_q_ap_local"
  else
    _q_ap_other=$(_q_i18n_key "$_q_HOME/i18n/$(_q_lang_alt).txt" threads_archive_file)
    if [ -n "$_q_ap_other" ] && [ -f "$1/$_q_ap_dir/$_q_ap_other" ]; then
      printf '%s\n' "$1/$_q_ap_dir/$_q_ap_other"
    else
      printf '%s\n' "$1/$_q_ap_dir/$_q_ap_local"
    fi
  fi
}

_q_compiled_path() {
  # K1: derived concepts live under the active knowledge folder. The directory
  # name is localized data, never a hardcoded path, and is not user memory.
  _q_cp_tab=$(printf '\t')
  _q_cp_lay=$(awk -F= '$1=="layout"{print $2;exit}' "$1/$_q_SD/config" 2>/dev/null || true)
  _q_layout_ok "$_q_cp_lay" || _q_cp_lay=emoji
  _q_cp_know=$(awk -F"$_q_cp_tab" '$1=="knowledge"{print $2;exit}' "$_q_HOME/layout/$_q_cp_lay.txt" 2>/dev/null || true)
  [ -n "$_q_cp_know" ] || _q_cp_know='🧠 Knowledge'
  _q_cp_name=$(_q_msg compiled_dir)
  [ -n "$_q_cp_name" ] || _q_cp_name=Compiled
  printf '%s/%s/%s\n' "$1" "$_q_cp_know" "$_q_cp_name"
}

_q_rules_adopted() {
  # B3 companion to _q_rules_path: decides whether a rules file on disk is
  # the init seed or a hand-written adoption. The seed is byte-identical to
  # one of the shipped templates (either language -- a user may have
  # switched the vault's language after init); anything else counts as
  # hand-written. Sets _q_ra=1 when adopted, 0 when it is the untouched
  # seed or the file is missing. Never fails. $1: rules file path.
  _q_ra=0
  [ -f "$1" ] || return 0
  for _q_ra_l in $(_q_langs); do
    if [ -f "$_q_HOME/templates/$_q_ra_l/rules.md" ] &&
       cmp -s "$1" "$_q_HOME/templates/$_q_ra_l/rules.md"; then
      return 0
    fi
  done
  _q_ra=1
  return 0
}

_q_plans_dir_path() {
